# ~/.bashrcx — extensions sourced by ~/.bashrc (see Makefile "bash" rule).
# Portable across WSL host, devcontainers, and bare arch.
# Stowed from arch-dots/shell/.bashrcx.

# Guard against double-sourcing.
[ -n "${_DOTS_BASHRCX_LOADED:-}" ] && return 0
_DOTS_BASHRCX_LOADED=1

# ─── interactive-only niceties ────────────────────────────────────────────────
case $- in
    *i*)
        # History.
        export HISTCONTROL=ignoreboth:erasedups
        export HISTSIZE=9999
        export HISTFILESIZE=9999
        shopt -s histappend checkwinsize cdspell dirspell

        # Prompt (minimal; p10k is zsh-only).
        if [ -x /usr/bin/dircolors ]; then
            eval "$(dircolors -b)"
        fi

        # Git prompt helper (__git_ps1) from git's bash-completion contrib.
        # Try common locations across distros before falling back to a no-op.
        if ! type __git_ps1 >/dev/null 2>&1; then
            for _f in \
                /usr/lib/git-core/git-sh-prompt \
                /usr/share/git/completion/git-prompt.sh \
                /usr/share/git-core/git-prompt.sh \
                /usr/share/bash-completion/completions/git-prompt
            do
                [ -r "$_f" ] && source "$_f" && break
            done
        fi
        # If git's bash-completion helper never loaded, fall back to a bare,
        # non-coloured prompt and skip the fancy two-line setup entirely.
        if ! type __git_ps1 >/dev/null 2>&1; then
            PS1='\w::\u> '
        else
        # Modern two-line prompt: status line above, input below.
        #   line 1: user@host  ~/path   branch   ⟨rc⟩  (rc only when non-zero)
        #   line 2: >
        #
        # Built via PROMPT_COMMAND so all colour escapes live in the literal
        # PS1 string (where bash actually interprets them).  Output from
        # $() substitutions is NOT re-scanned for \[ \] \033 escapes, so we
        # interpolate dynamic values as plain text instead.
        __ps1_build() {
            local rc=$? pwd_display b colour git_info exit_info
            pwd_display="${PWD/#$HOME/~}"

            git_info=""
            b="$(__git_ps1 '%s')"
            if [ -n "$b" ]; then
                if git diff --quiet --cached 2>/dev/null && git diff --quiet 2>/dev/null; then
                    colour='\[\033[01;32m\]'   # green = clean
                else
                    colour='\[\033[01;33m\]'   # yellow = dirty
                fi
                git_info=" ${colour}(git branch ${b})\[\033[00m\]"
            fi

            exit_info=""
            [ "$rc" -ne 0 ] && exit_info=" \[\033[01;31m\]⟨${rc}⟩\[\033[00m\]"

            PS1='\n\[\033[01;32m\]\u@\h\[\033[00m\] :: \[\033[01;36m\]'"${pwd_display}"'\[\033[00m\]'"${git_info}${exit_info}"'\n\[\033[01;35m\]>\[\033[00m\] '
        }
        PROMPT_COMMAND=__ps1_build
        fi

        # Color aliases (harmless if .aliases already set them).
        alias ls='ls --color=auto'
        alias grep='grep --color=auto'

        # Editor.
        if command -v code >/dev/null 2>&1; then
            export EDITOR=code
        elif command -v nvim >/dev/null 2>&1; then
            export EDITOR=nvim
        elif command -v vim >/dev/null 2>&1; then
            export EDITOR=vim
        fi
        ;;
esac

# ─── ssh-agent (WSL host only) ───────────────────────────────────────────────
# Start or reuse an ssh-agent on the WSL host.  Inside the devcontainer the
# agent socket is bind-mounted from the host and SSH_AUTH_SOCK is set via
# remoteEnv, so we must NOT clobber it here.
if [ -x "$HOME/.local/bin/check-wsl" ] && "$HOME/.local/bin/check-wsl"; then
    # Only start a new agent if we're NOT inside a container (the devcontainer
    # sets SSH_AUTH_SOCK via remoteEnv already).
    if [ -z "${SSH_AUTH_SOCK:-}" ] || ! [ -S "${SSH_AUTH_SOCK:-}" ]; then
        _ssh_agent_env="$HOME/.ssh/agent.env"
        if [ -f "$_ssh_agent_env" ]; then
            source "$_ssh_agent_env" 2>/dev/null
        fi
        if ! ssh-add -l >/dev/null 2>&1; then
            eval "$(ssh-agent -s)" >/dev/null 2>&1
            echo "export SSH_AUTH_SOCK=\"${SSH_AUTH_SOCK}\""  > "$_ssh_agent_env"
            echo "export SSH_AGENT_PID=\"${SSH_AGENT_PID}\"" >> "$_ssh_agent_env"
            # Add default keys if they exist.
            for _key in "$HOME"/.ssh/id_ed25519 "$HOME"/.ssh/id_rsa; do
                [ -f "$_key" ] && ssh-add "$_key" 2>/dev/null
            done
            unset _key
        fi
        unset _ssh_agent_env
    fi
fi

# ─── exports & aliases ───────────────────────────────────────────────────────
[ -f "$HOME/.exports"  ] && source "$HOME/.exports"
[ -f "$HOME/.aliases"  ] && source "$HOME/.aliases"
