#!/bin/bash

# a) Check being run inside ~/dots
SCRIPT_DIR="$(pwd)"
DOTS_DIR="$(realpath "$HOME/dots")"

cd $DOTS_DIR
if [ "$SCRIPT_DIR" != "$DOTS_DIR" ]; then
    echo "Error: This script must be run inside the ~/dots directory"
    exit 1
fi

# b) Check current directory has git origin of "akinevz2/doftiles"
CURRENT_DIR="$(pwd)"
cd "$CURRENT_DIR" || exit 1

REMOTE_URL=$(git remote get-url origin 2>/dev/null) || {
    echo "Error: Not a git repository or unable to get remote URL"
    exit 1
}

if ! echo "$REMOTE_URL" | grep -q "akinevz2/doftiles"; then
    echo "Error: Git origin is not set to akinevz2/doftiles"
    echo "Current origin: $REMOTE_URL"
    exit 1
fi

# c) Perform "git pull"
git fetch && echo "Checking for updates..."
if git pull --ff &>/dev/null 2>&1; then
    echo "git pull successful: installing system"
    make install
else
    echo -n "git pull failed: "
    git status
    exit 1
fi

# d-e) Read wm.requires and filter comment lines
REQUIRES_FILE="wm.requires"

if [ ! -f "$REQUIRES_FILE" ]; then
    echo "Error: $REQUIRES_FILE not found in current directory"
    exit 1
fi

# Filter out comment lines and store in array
REQUIRES_BIN=($(grep -vi '^#' "$REQUIRES_FILE"))

# f) Print contents one word per line
echo "Requirements from wm.requires:"
for binary in "${REQUIRES_BIN[@]}"; do
    echo "$binary required"
done
