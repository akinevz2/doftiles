#!/usr/bin/env bash
# Install hook: ensure ~/.bashrc sources ~/.bashrcx.
# Invoked by `make bash` after stow symlinks .bashrcx into place.

set -euo pipefail

bashrc="$HOME/.bashrc"

# Append a single sourcing line if .bashrcx isn't already referenced.
if ! grep -qF '.bashrcx' "$bashrc"; then
    printf 'source "$HOME/.bashrcx"\n' >> "$bashrc"
    echo "  appended .bashrcx sourcing line to $bashrc"
fi