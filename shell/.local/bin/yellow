#!/bin/bash

# Print text in yellow
YELLOW='\033[33m'
NC='\033[0m'

if [ -t 0 ]; then
    # No pipe – require arguments
    if [[ $# -eq 0 ]]; then
        echo "Usage: $0 <text>"
        exit 1
    fi
    echo -e "${YELLOW}$@${NC}"
    exit 1
fi

# Piped input – colour each line
while IFS= read -r line || [[ -n "$line" ]]; do
    echo -e "${YELLOW}${line}${NC}"
done