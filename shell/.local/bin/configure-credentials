#!/usr/bin/env bash
#
# configure-credentials — TUI editor for ~/.my-credentials (git identity).
#
# ~/.my-credentials is PERSISTENT (a stow link into dots/shell — the
# tracked source of truth). Format:
#   line 1: full name (three words — the git author name)
#   line 2: email
#
# load-credentials validates and applies it to `git config --global`.
# The generated ~/.my-credentials-env (GIT_NAME/GIT_EMAIL exports) is a
# TRANSIENT companion — regenerated here after every save, sourced by
# devcontainer .bashrc/.zshrc fragments. The WSL host shell does NOT
# source it: ~/.shellx.rc reads ~/.my-credentials directly. Consumed
# via 'make credentials' (configure-credentials --regen), last stage
# of bootstrap.
#
# TUI: whiptail when available, plain read prompts otherwise.
# --regen: non-interactive regeneration of the env file from the
#          persistent file (no TTY needed; make credentials calls this).
# Non-interactive (no TTY): prints the current state and exits 0.

set -euo pipefail

CRED="${HOME}/.my-credentials"
ENVF="${HOME}/.my-credentials-env"

usage() {
    cat <<EOF
configure-credentials — TUI editor for ~/.my-credentials (git identity)

Usage: configure-credentials

The file is persistent (in \$HOME) and gitignored — never committed.
Line 1 = full name (three words), line 2 = email. On save the git
config is applied (load-credentials) and ~/.my-credentials-env is
regenerated for the shell exports.
EOF
}
case "${1:-}" in
    "") : ;;
    --regen) REGEN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "configure-credentials: unexpected argument '$1'" >&2; usage >&2; exit 1 ;;
esac

# --- current values ---------------------------------------------------------
name=""; email=""
if [ -f "$CRED" ]; then
    name=$(sed -n 1p "$CRED" 2>/dev/null || true)
    email=$(sed -n 2p "$CRED" 2>/dev/null || true)
fi

# --- regenerate the env exports + apply git config --------------------------
regen() {  # write $ENVF from the persistent file (no prompt, no git apply)
    if [ ! -f "$CRED" ]; then
        echo "configure-credentials: $CRED missing — nothing to regenerate; set it up with configure-credentials in a terminal" >&2
        exit 1
    fi
    local rname remail
    rname=$(sed -n 1p "$CRED")
    remail=$(sed -n 2p "$CRED")
    if [ -z "$rname" ] || [ -z "$remail" ]; then
        echo "configure-credentials: $CRED is empty/incomplete — regenerate after filling it in" >&2
        exit 1
    fi
    {
        echo "# generated by configure-credentials — transient companion of $CRED"
        echo "GIT_NAME='$rname'"
        echo "GIT_EMAIL='$remail'"
    } > "$ENVF"
    chmod 600 "$ENVF" 2>/dev/null || true
    echo "configure-credentials: regenerated $ENVF from $CRED"
}

apply() {  # $1 = name, $2 = email
    printf '%s\n%s\n' "$1" "$2" > "$CRED"
    chmod 600 "$CRED" 2>/dev/null || true
    {
        echo "# generated by configure-credentials — transient companion of $CRED"
        echo "GIT_NAME='$1'"
        echo "GIT_EMAIL='$2'"
    } > "$ENVF"
    chmod 600 "$ENVF" 2>/dev/null || true
    if command -v load-credentials >/dev/null 2>&1; then
        load-credentials >/dev/null 2>&1 && \
            echo "configure-credentials: git user.name/user.email applied" || \
            echo "configure-credentials: WARNING — load-credentials rejected the values" >&2
    fi
    echo "configure-credentials: saved $CRED (+ regenerated $ENVF)"
}

validate() {  # $1 = name, $2 = email -> error text or empty
    local n e
    read -r -a n <<< "$1"
    if [ "${#n[@]}" -ne 3 ]; then
        echo "name must be exactly three words (got '${1}')"
    fi
    case "$2" in
        *@*) : ;;
        *) echo "email must contain '@' (got '${2}')" ;;
    esac
}

msg() { echo "configure-credentials: $*"; }

# --- --regen dispatch (headless; before any TTY gating) ----------------------
if [ "${REGEN:-0}" = "1" ]; then
    regen
    exit 0
fi

# --- non-interactive: report and exit ---------------------------------------
if [ ! -t 0 ]; then
    if [ -f "$CRED" ]; then
        msg "current: name='$name' email='$email' ($CRED)"
    else
        msg "$CRED does not exist — run configure-credentials in a terminal to set it up"
    fi
    exit 0
fi

# --- TUI loop ----------------------------------------------------------------
if command -v whiptail >/dev/null 2>&1; then
    while :; do
        vals=$(whiptail --title "doftiles git credentials" \
            --backtitle "$CRED (persistent, gitignored)" \
            --inputbox "Full name (three words):" 10 60 "$name" 3>&1 1>&2 2>&3) || exit 0
        mail=$(whiptail --title "doftiles git credentials" \
            --inputbox "Email:" 10 60 "$email" 3>&1 1>&2 2>&3) || exit 0
        err=$(validate "$vals" "$mail")
        if [ -n "$err" ]; then
            whiptail --title "invalid" --msgbox "$err" 10 60 || true
            continue
        fi
        if whiptail --title "save?" --yesno \
            "Name: $vals\nEmail: $mail\n\nSave to $CRED and apply to git config?" 12 60; then
            apply "$vals" "$mail"
        fi
        exit 0
    done
fi

# plain prompts (no whiptail)
while :; do
    read -r -e -p "Full name (three words)${name:+ [$name]}: " name_in
    name_in=${name_in:-$name}
    read -r -e -p "Email${email:+ [$email]}: " email_in
    email_in=${email_in:-$email}
    err=$(validate "$name_in" "$email_in")
    if [ -z "$err" ]; then
        apply "$name_in" "$email_in"
        break
    fi
    msg "invalid: $err"
done
