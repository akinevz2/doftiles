export TASKRC=${HOME}/.config/taskrc
export XDG_CONFIG_HOME=~/.config
export MOZ_WEBRENDER=1
export MOZ_X11_EGL=1


export LOCAL_BIN=~/.local/bin

if [ -x "$HOME/.local/bin/check-wsl" ] && "$HOME/.local/bin/check-wsl"; then
    export DISPLAY=$(ip route list default | awk '{print $3}'):0
    export LIBGL_ALWAYS_INDIRECT=1
fi

# IDE viewing shortcuts 
export GIT_EDITOR="code --wait"
export EDITOR="code"
export VIEW="code -r"
export VISUAL="code --wait"
export NEW_WINDOW="--new-window"

# Set DISPLAY for WSL environments
if [[ $(hostname) == WS* ]]; then
    export DISPLAY=localhost:0.0
    # VcXsrv/X11 through WSL: force indirect/software GL rendering
    export LIBGL_ALWAYS_INDIRECT=1
    export LIBGL_ALWAYS_SOFTWARE=true
    # Set BROWSER to wrapper script for Windows Firefox
    export BROWSER="firefox"
    # Allows VS Code usage within the X11
    export DONT_PROMPT_WSL_INSTALL=true
fi

export PATH=$LOCAL_BIN:$PATH
