export XDG_CONFIG_HOME=~/.config
export MOZ_WEBRENDER=1
export MOZ_X11_EGL=1


export LOCAL_BIN=~/.local/bin

# IDE viewing shortcuts 
export GIT_EDITOR="code --wait"
export EDITOR="vim"
export VIEW="code -r"
export VISUAL="code --wait"
export NEW_WINDOW="--new-window"

export BUNPATH="${HOME}/.bun/bin"
export PATH="$LOCAL_BIN:$BUNPATH:$PATH"

# Terminal preference for mail notifications
export TERMINAL="alacritty"
export TERMINAL_launch="$TERMINAL -e"

# Opt-in env fragments: stow packages may ship ~/.config/exports.d/*.sh
# (the wsl metapackage ships the WSL block). The generic shell knows
# nothing about WSL — a machine opts in by stowing the wsl package;
# no fragment, no WSL env.
for _exports_fragment in "$HOME"/.config/exports.d/*.sh; do
    [ -f "$_exports_fragment" ] && . "$_exports_fragment"
done
unset _exports_fragment
