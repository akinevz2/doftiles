[Unit]
Description=noVNC proxy
After=x11vnc.service
Requires=x11vnc.service

[Service]
Type=simple
Environment=XDG_SESSION_TYPE=x11
UnsetEnvironment=WAYLAND_DISPLAY
# DISPLAY no longer hardcoded: novnc_proxy does not take an X client
# display (it proxies VNC over TCP). The inherited manager env from
# check-x-server carries it for consistency; nothing here uses it.
ExecStart=/usr/share/novnc/utils/novnc_proxy --vnc localhost:5900 --listen localhost:6080
Restart=on-failure
# 143 = SIGTERM: the python proxy doesn't trap it, so stopping the unit
# lands as "failed" without this.
SuccessExitStatus=143

[Install]
WantedBy=default.target