#!/usr/bin/env bash
#
# load-credentials — load git user.name and user.email globally from ~/.my-credentials
#
# Expected file format:
#   line 1: Full Name (must be exactly three whitespace-separated words)
#   line 2: email@example.com (must contain an "@" sign)
#
set -euo pipefail

CREDENTIALS_FILE="${HOME}/.my-credentials"

if [[ ! -f "$CREDENTIALS_FILE" ]]; then
  echo "error: credentials file not found at ${CREDENTIALS_FILE}" >&2
  exit 1
fi

# Read the first two lines (NUL-delimited read avoids issues with special chars)
mapfile -t lines < "$CREDENTIALS_FILE"

if [[ ${#lines[@]} -lt 2 ]]; then
  echo "error: ${CREDENTIALS_FILE} must contain at least two lines (name, email)" >&2
  exit 1
fi

user_name="${lines[0]}"
user_email="${lines[1]}"

# Trim leading/trailing whitespace
user_name="${user_name#"${user_name%%[![:space:]]*}"}"
user_name="${user_name%"${user_name##*[![:space:]]}"}"
user_email="${user_email#"${user_email%%[![:space:]]*}"}"
user_email="${user_email%"${user_email##*[![:space:]]}"}"

#
# Validation
#
errors=()

# Name must be exactly three whitespace-separated words
read -r -a name_words <<< "$user_name"
if [[ ${#name_words[@]} -ne 3 ]]; then
  errors+=("user.name must be exactly three words long (got ${#name_words[@]}: '${user_name}')")
fi

# Email must contain an "@" sign
if [[ "$user_email" != *@* ]]; then
  errors+=("user.email must contain an '@' sign (got '${user_email}')")
fi

if [[ ${#errors[@]} -gt 0 ]]; then
  echo "error: credential validation failed:" >&2
  for e in "${errors[@]}"; do
    echo "  - ${e}" >&2
  done
  exit 1
fi

#
# Apply to git globally
#
git config --global user.name  "$user_name"
git config --global user.email "$user_email"

echo "git config --global user.name  \"$user_name\""
echo "git config --global user.email \"$user_email\""