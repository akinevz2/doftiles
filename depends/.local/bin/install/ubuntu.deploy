#!/bin/bash

# a) Accept binary name from command line
BINARY_NAME="$1"

if [ -z "$BINARY_NAME" ]; then
    echo "$(basename $0): returns package name for a binary"
    echo "pass 'install' to perform platform-specific installation"
    echo "Usage: ubuntu.deploy [install] <binary_name>"
    exit 1
fi

if [ "$1" == "install" ]; then
    BINARY_NAME="$2"
fi

# binary -> apt-package aliases: the PACKAGE name may differ from the
# BINARY name it ships — the apt-cache substring heuristic below can
# never find those (no package is a substring of the short binary
# name), so map them explicitly. rg ships in 'ripgrep'; herbstclient
# ships in 'herbstluftwm' (the search DOES return it, but the package
# name contains none of the binary name's substrings).
case "$BINARY_NAME" in
    rg) BINARY_NAME="ripgrep" ;;
    herbstclient) BINARY_NAME="herbstluftwm" ;;
esac

# b) Find the package that contains the binary using apt-cache
# We need to read lines as complete entities, not split on whitespace
PKGS=()

while IFS= read -r line; do
    PKGS+=("${line%% *}")
done < <(apt-cache search "$BINARY_NAME" 2>/dev/null) || {
    echo "Error: Unable to find package containing binary '$BINARY_NAME'"
    echo "Running 'apt-cache search' failed"
    exit 1
}

if [ ${#PKGS[@]} -eq 0 ]; then
    echo "Error: Unable to find package containing binary '$BINARY_NAME'"
    exit 1
fi

# Track the package with the longest substring match of BINARY_NAME.
# PERF: the match test is PURE BASH (case, no forks) — the previous
# form spawned echo+grep per suffix per package; apt-cache search can
# return hundreds of rows for short binary names, and thousands of
# process spawns made one resolution cost 1.5-4s (check resolves EVERY
# missing binary through this script — that was the `make status` hog).
LONGEST_PKG=""
LONGEST_MATCH_LENGTH=0

for pkg in "${PKGS[@]}"; do
    # fast path: exact package-name match is the best possible answer
    if [ "$pkg" = "$BINARY_NAME" ]; then
        LONGEST_PKG="$pkg"
        break
    fi
    # Find all substrings of BINARY_NAME that exist in pkg
    # We iterate through all possible suffixes of BINARY_NAME and check if they match a substring in pkg
    for (( i=0; i <= ${#BINARY_NAME}; i++ )); do
        CURRENT_SUBSTRING="${BINARY_NAME:i}"
        case "$CURRENT_SUBSTRING" in
            *"$pkg"*)
                CURRENT_MATCH_LENGTH=${#CURRENT_SUBSTRING}
                # Save if this is the longest match so far
                if [ "$CURRENT_MATCH_LENGTH" -gt "$LONGEST_MATCH_LENGTH" ]; then
                    LONGEST_MATCH_LENGTH=$CURRENT_MATCH_LENGTH
                    LONGEST_PKG="$pkg"
                    continue
                fi
                ;;
            *) break ;;
        esac
    done
done

if [ -z "$LONGEST_PKG" ]; then
    echo "Error: No match found for binary '$BINARY_NAME' in any package"
    exit 1
fi

PKG="$LONGEST_PKG"

if [ "$1" == "install" ]; then
    # c) Print the apt install command
    echo "sudo apt install ${PKG}"
    exit 0
fi

echo "${PKG}"
# for pkg in "${PKGS% - %#}"; do
