#!/usr/bin/env bash
# dots-commit-ui — the PRESENTATION ADAPTER of the dots-commit workflow.
#
# The flow driver (dots-commit) contains no presentation code: every
# interactive primitive delegates here. The adapter contract:
#
#   ui_note <msg>                 progress line
#   ui_die <msg>                  announce + exit 1
#   ui_pause                      best-effort interactive nudge
#   ui_yesno <question>           exit 0 = yes
#   ui_choose <title> <tag> <desc>...   echoes the chosen tag (rc 1 = cancel)
#   ui_input <prompt> <default>   echoes the answer
#   ui_view <title> <file>        shows a file's content
#
# Backends — POSIX-portable primitives ONLY (pure bash/readline; no
# external TUI packages provide the primitives):
#   readline   guided numbered menus on a tty
#   cli        fail-fast: no prompts, everything auto-confirms
# Selection: $DOTS_COMMIT_UI (readline|cli) when set, else readline
# iff stdin is a tty, else cli.

# ui_note <msg>
ui_note() { printf '%s\n' "dots-commit: $1"; }

# ui_die <msg>
ui_die() {
	ui_note "$1" >&2
	exit 1
}

# ui_pause
ui_pause() {
	if [ "$UI_BACKEND" = readline ]; then
		printf 'press Enter to continue...' >&2
		read -r _ || true
	fi
}

# ui_yesno <question>
ui_yesno() {
	if [ "$UI_BACKEND" != readline ]; then
		return 0 # cli: fail-fast means no prompts — yes
	fi
	while :; do
		printf '%s [y/N] ' "$1" >&2
		IFS= read -r a || return 1
		case $a in
		y | Y | yes) return 0 ;;
		n | N | no | '') return 1 ;;
		esac
	done
}

# ui_choose <title> <tag> <desc> <tag> <desc> ...
ui_choose() {
	if [ "$UI_BACKEND" != readline ]; then
		return 1 # cli: no menus — the caller drives the sequence
	fi
	title=$1
	shift
	tags=()
	i=0
	while [ $# -gt 0 ]; do
		i=$((i + 1))
		tags[$i]=$1
		printf '  %2d) %-14s %s\n' "$i" "$1" "$2" >&2
		shift 2
	done
	while :; do
		printf '%s\nchoose: ' "$title" >&2
		IFS= read -r a || return 1
		case $a in
		'' | *[!0-9]*) continue ;;
		esac
		[ "$a" -ge 1 ] && [ "$a" -le "$i" ] || continue
		echo "${tags[$a]}"
		return 0
	done
}

# ui_input <prompt> <default>
ui_input() {
	if [ "$UI_BACKEND" = readline ]; then
		printf '%s [%s] ' "$1" "$2" >&2
		IFS= read -r a || a=''
		echo "${a:-$2}"
	else
		echo "$2"
	fi
}

# ui_view <title> <file>
ui_view() {
	if [ "$UI_BACKEND" = readline ] && command -v less >/dev/null 2>&1; then
		less -R "$2" || cat "$2"
	else
		cat "$2"
	fi
}

# ---- backend selection ----------------------------------------------------

case "${DOTS_COMMIT_UI:-}" in
readline | cli) UI_BACKEND=$DOTS_COMMIT_UI ;;
*) [ -t 0 ] && UI_BACKEND=readline || UI_BACKEND=cli ;;
esac
