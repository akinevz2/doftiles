#!/usr/bin/env bash
# dots-commit — the dots park-and-fold workflow (commit, fold the
# local/parked-* branches, push dots + ahead submodules).
#
# ALL presentation delegates to the adapter module dots-commit-ui
# (same directory): the flow driver below holds no interactive
# primitives. Backends: a readline TUI on a tty, or a fail-fast CLI
# otherwise (--auto forces the CLI). Rebase conflicts are the volition
# point everywhere: the script stops and prints the by-hand recipe.

set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
	echo "dots-commit: not inside a git repository" >&2
	exit 2
}
cd "$ROOT" || exit 2

AUTO=0
case "${1:-}" in
'') ;;
--auto) AUTO=1 ;;
*)
	echo "usage: dots-commit [--auto]" >&2
	echo "  (no tty or --auto: non-interactive fail-fast flow)" >&2
	exit 2
	;;
esac

# the adapter module owns every presentation primitive (ui_*)
. "$(dirname "$0")/dots-commit-ui"
[ "$AUTO" -eq 0 ] || UI_BACKEND=cli

# ---- workflow state -------------------------------------------------------

current_branch() {
	git symbolic-ref --quiet --short HEAD 2>/dev/null || true
}

parked_branches() {
	git for-each-ref --format='%(refname:short)' --sort=committerdate \
		'refs/heads/local/parked-*'
}

tree_dirty() {
	[ -n "$(git status --porcelain --untracked-files=no)" ]
}

# submodule paths: system.depends lines are '<pkg> <path>...' — the
# on-deploy bootstrap checkout rides along (no awk — see repo quirk 7)
submodule_paths() {
	[ -f system.depends ] && cut -d' ' -f2- system.depends |
		tr ' ' '\n' | grep -v '^$'
	echo 'on-deploy/.local/share/on-deploy'
}

conflict_recipe() {
	ui_note "a rebase conflict is in progress in $1"
	ui_note "  1. inspect:   git -C $1 status"
	ui_note "  2. resolve:   edit the conflicted files, then git -C $1 add <files>"
	ui_note "  3. continue:  git -C $1 rebase --continue"
	ui_note "     (or bail:  git -C $1 rebase --abort)"
	ui_note "then re-run dots-commit — nothing has been lost"
}

# ---- actions --------------------------------------------------------------

action_status() {
	u=$(current_branch)
	ahead=$(git rev-list --count "origin/$u..$u" 2>/dev/null || echo 0)
	behind=$(git rev-list --count "HEAD..origin/$u" 2>/dev/null || echo 0)
	tmp=$(mktemp "${TMPDIR:-/tmp}/dots-commit.XXXXXX")
	{
		echo "branch:      $u  (ahead $ahead / behind $behind vs origin)"
		if tree_dirty; then
			echo 'local modifications (tracked):'
			git status --porcelain --untracked-files=no | sed 's/^/  /'
		else
			echo 'local modifications: none'
		fi
		echo 'parked branches:'
		for b in $(parked_branches); do
			echo "  $b  ($(git rev-list --count HEAD.."$b") commit(s))"
		done
		[ -n "$(parked_branches)" ] || echo '  (none)'
		echo 'submodules ahead of origin:'
		for s in $(submodule_paths); do
			[ -d "$s" ] || continue
			sb=$(git -C "$s" symbolic-ref --quiet --short HEAD 2>/dev/null) || true
			[ -n "$sb" ] || continue
			a=$(git -C "$s" rev-list --count "origin/$sb..$sb" 2>/dev/null || echo 0)
			[ "$a" -gt 0 ] 2>/dev/null && echo "  $s ($sb): $a commit(s)"
		done
	} >"$tmp" 2>&1
	ui_view 'dots-commit — status' "$tmp"
	rm -f "$tmp"
	ui_pause
}

action_commit() {
	if ! tree_dirty; then
		ui_note 'nothing to commit (tree is clean)'
		ui_pause
		return 0
	fi
	git add -A
	for f in *.depends; do
		[ -f "$f" ] && git add -f -- "$f"
	done
	m=$(ui_input 'commit message' 'make commit: local modifications')
	run "commit ($(git diff --cached --stat | tail -1))" \
		git commit -m "$m" || return 1
	ui_pause
}

# action_fold <branch> — rebase <branch> into the current branch, ff, delete
action_fold() {
	b=$1
	u=$(current_branch)
	[ -n "$u" ] || ui_die 'detached HEAD — cannot fold (checkout a branch first)'
	if [ "$UI_BACKEND" = readline ]; then
		tmp=$(mktemp "${TMPDIR:-/tmp}/dots-commit.XXXXXX")
		git log --oneline "$u".."$b" >"$tmp" 2>&1
		ui_view "fold $b into $u — its commits" "$tmp"
		rm -f "$tmp"
		ui_yesno "fold '$b' into '$u' now?" || {
			ui_note "skipped $b"
			ui_pause
			return 0
		}
	else
		ui_note "folding '$b' into '$u'"
	fi
	if ! { git checkout -q "$b" && git rebase "$u"; }; then
		conflict_recipe "$ROOT"
		exit 1
	fi
	git checkout -q "$u"
	if ! git merge --ff-only "$b"; then
		conflict_recipe "$ROOT"
		exit 1
	fi
	git branch -d "$b"
	ui_note "folded '$b' into '$u' and deleted the branch"
	ui_pause
}

action_push_dots() {
	u=$(current_branch)
	run "push dots ($u)" git push origin "$u" || return 1
	ui_pause
}

action_push_submodules() {
	for s in $(submodule_paths); do
		[ -d "$s" ] || continue
		sb=$(git -C "$s" symbolic-ref --quiet --short HEAD 2>/dev/null) || true
		[ -n "$sb" ] || continue
		a=$(git -C "$s" rev-list --count "origin/$sb..$sb" 2>/dev/null || echo 0)
		[ "$a" -gt 0 ] 2>/dev/null || continue
		run "push submodule $s ($sb, $a commit(s))" \
			git -C "$s" push origin "$sb" || return 1
	done
	ui_note 'submodules: nothing ahead of origin, or all pushed'
	ui_pause
}

# run <description> <cmd> [args...] — announce, execute, report
run() {
	desc=$1
	shift
	ui_note "$desc"
	if "$@"; then
		ui_note "ok: $desc"
		return 0
	fi
	rc=$?
	ui_note "FAILED (exit $rc): $desc"
	return "$rc"
}

action_fold_all() {
	for b in $(parked_branches); do
		action_fold "$b" || return 1
	done
}

# ---- the flows ------------------------------------------------------------

flow_cli() { # fail-fast: commit -> fold all -> push dots -> push submodules
	if tree_dirty; then
		action_commit || exit 1
	else
		ui_note 'nothing to commit (tree is clean)'
	fi
	action_fold_all || exit 1
	action_push_dots || exit 1
	action_push_submodules || exit 1
	ui_note 'done'
}

flow_readline() {
	while :; do
		c=$(ui_choose 'dots-commit' \
			status 'show branch / parked / submodule state' \
			commit 'commit local modifications' \
			fold 'review + fold a parked branch' \
			push-dots 'push the dots branch' \
			push-modules 'push ahead submodules' \
			all 'commit + fold all + push everything' \
			quit 'leave') || break
		case "$c" in
		status) action_status ;;
		commit) action_commit ;;
		fold)
			bs=$(parked_branches)
			[ -n "$bs" ] || {
				ui_note 'no parked branches'
				ui_pause
				continue
			}
			set -- # build "tag desc" pairs for the menu
			for b in $bs; do
				set -- "$@" "$b" "$(git rev-list --count HEAD.."$b") commit(s)"
			done
			b=$(ui_choose 'fold which parked branch?' "$@") || continue
			action_fold "$b"
			;;
		push-dots) action_push_dots ;;
		push-modules) action_push_submodules ;;
		all)
			action_commit &&
				action_fold_all &&
				action_push_dots &&
				action_push_submodules &&
				ui_note 'done'
			ui_pause
			;;
		quit) break ;;
		esac
	done
}

if [ "$UI_BACKEND" = readline ]; then
	flow_readline
else
	flow_cli
fi
