#!/usr/bin/env bash
# components — the depends package's binary installer.
#
# (was on-deploy's `toolchain` + `deps` verbs; installing components is
# a package concern, so the logic moved HERE — the dots Makefile runs
# `make -C depends/.local/share/depends install` which execs this.)
#
# Artifacts owned by the depends package:
#   ~/.local/bin/bun         (via npm when bun is missing)
#   global bun trust         (postinstall scripts for the global packages)
#   ~/.local/bin/herbctl     (bunli build from depends/.local/share/herbctl)
#   ~/.local/bin/polyframes  (source | npm | release; method recorded
#                             in ~/.config/doftiles.conf — write through
#                             the stow symlink with sed --follow-symlinks)
#   (on-deploy itself is bootstrapped by the dots Makefile, not here)
#
#   components               ensure everything (install only when missing)
#   components --force       rebuild/redeploy even when installed
#   components --method source|npm|release   explicit polyframes method
#   components --uninstall   remove polyframes per the recorded method
#   components --dry-run     print what would be done, change nothing
#
# Exit codes: 2 env/precondition, 1 operational failure, 0 ok/no-op.

set -u

DRY=0
FORCE=0
UNINSTALL=0
METHOD=""
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run|-n) DRY=1 ;;
        --force|-f)   FORCE=1 ;;
        --uninstall)  UNINSTALL=1 ;;
        --method)     shift; METHOD="${1:-}"; METHOD_FLAG=1 ;;
        -h|--help)    sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "components: unknown argument '$1'" >&2; exit 2 ;;
    esac
    shift
done

METHOD_FLAG=""
DOTS=""
# locate the dots repo: env override → cwd walk-up (make -C runs the
# components script from inside depends/…) → $HOME/dots fallback (the
# plain `components` invocation from a stowed link on any cwd). The
# marker file IS the dots root's manifest.
_d="$PWD"
while [ "$_d" != "/" ]; do
    [ -f "$_d/wm.requires" ] && DOTS="$_d" && break
    _d="$(dirname "$_d")"
done
DOTS="${DOTS_DIR:-${DOTS:-$HOME/dots}}"
HERBCTL_DIR="$DOTS/depends/.local/share/herbctl"
POLY_DIR="$DOTS/depends/.local/share/polyframes"
BIN_DIR="$HOME/.local/bin"
HERBCTL="$BIN_DIR/herbctl"
POLY="$BIN_DIR/polyframes"
CONF="$HOME/.config/doftiles.conf"
REPO="https://github.com/akinevz2/polyframes"
NPM_SPEC="github:akinevz2/polyframes"
RELEASE_URL="$REPO/releases/latest/download/polyframes-linux-x64"
TRUST_PKGS="polyframes herbctl herbstutil @opencode/cli bun"
FAILED=0

step() {  # step <name> <ok|FAILED> <detail>
    printf '  %-8s %s — %s\n' "$1" "$2" "$3"
}
die2() { echo "components: $*" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }

conf_get() {
    # source the conf (read-only) and echo the recorded method
    [ -f "$CONF" ] || return 0
    . "$CONF" 2>/dev/null || true
    printf '%s' "${POLYFRAMES_METHOD:-}"
}

conf_set() {
    # write through the stow symlink (sed --follow-symlinks keeps the
    # link; a plain redirect would replace it with a regular file)
    touch "$CONF"
    if grep -q '^POLYFRAMES_METHOD=' "$CONF"; then
        sed -i --follow-symlinks "s/^POLYFRAMES_METHOD=.*/POLYFRAMES_METHOD=$1/" "$CONF"
    else
        printf 'POLYFRAMES_METHOD=%s\n' "$1" >> "$CONF"
    fi
}

# ── bun ───────────────────────────────────────────────────────────────
install_bun() {
    if have bun; then
        step bun ok "$(bun --version 2>/dev/null) ready"
        return 0
    fi
    if [ "$DRY" = 1 ]; then
        step bun ok "[dry-run] npm install --global bun (or record it when npm also missing)"
        have npm && return 0
        step bun FAILED "neither bun nor npm found" "install node/npm first (arch: pacman -S npm)"
        FAILED=1; return 1
    fi
    if ! have npm; then
        step bun FAILED "neither bun nor npm found" "install node/npm first (arch: pacman -S npm)"
        FAILED=1; return 1
    fi
    if npm install --global bun; then
        step bun ok "installed through npm"
    else
        step bun FAILED "npm install --global bun failed"
        FAILED=1; return 1
    fi
}

# ── trust (bun's default policy keeps postinstall blocked — quirk 17) ─
install_trust() {
    if [ "$DRY" = 1 ]; then
        step trust ok "[dry-run] bun pm trust -g <untrusted of: $TRUST_PKGS>"
        return 0
    fi
    have bun || { step trust ok "bun absent — nothing to trust"; return 0; }
    local untrusted
    untrusted="$(bun pm untrusted -g 2>/dev/null || true)"
    for pkg in $TRUST_PKGS; do
        if printf '%s' "$untrusted" | grep -qF "node_modules/$pkg"; then
            if bun pm trust -g "$pkg" >/dev/null 2>&1; then
                step trust ok "trusted $pkg (postinstall scripts ran)"
            else
                step trust FAILED "$pkg postinstall blocked"
                FAILED=1
            fi
        else
            step trust ok "$pkg — trusted already or no blocked scripts"
        fi
    done
}

# ── herbctl (bunli build from the submodule checkout) ─────────────────
build_bunli() {  # build_bunli <dir> <name> <destbin>
    local dir="$1" name="$2" dest="$3"
    if [ "$DRY" = 1 ]; then
        step "$name" ok "[dry-run] bun install + bunli build in $dir -> $dest"
        return 0
    fi
    (cd "$dir" && bun install) || return 1
    (cd "$dir" && bun x bunli build --targets linux-x64 --minify) || return 1
    [ -f "$dir/dist/index" ] || return 1
    mv -f "$dir/dist/index" "$dir/dist/$name"
    rm -f "$dir/dist/index.map"
    mkdir -p "$BIN_DIR"
    install -m 755 "$dir/dist/$name" "$dest"
}

install_herbctl() {
    if [ -e "$HERBCTL" ] && [ "$FORCE" != 1 ]; then
        step herbctl ok "$HERBCTL deployed already — skipping (--force rebuilds)"
        return 0
    fi
    [ -e "$HERBCTL_DIR/src/index.ts" ] || {
        step herbctl FAILED "submodule checkout missing" "run 'make submodules' first"
        FAILED=1; return 1
    }
    have bun || {
        step herbctl FAILED "bun not found" "arch: pacman -S bun, or npm i -g $NPM_SPEC/herbctl"
        FAILED=1; return 1
    }
    if build_bunli "$HERBCTL_DIR" herbctl "$HERBCTL"; then
        step herbctl ok "installed $HERBCTL"
    else
        step herbctl FAILED "build failed" "bun install / bunli build output above"
        FAILED=1
    fi
}

# ── polyframes (the only deployable artifact) ─────────────────────────
poly_sync() {
    if [ ! -d "$POLY_DIR" ]; then
        echo "components: submodule checkout missing — $POLY_DIR" >&2
        echo "  run 'make submodules' first" >&2
        return 1
    fi
    if [ "$DRY" = 1 ]; then
        echo "    [dry-run] submodule sync/update + $POLY_DIR -> origin/main"
        return 0
    fi
    git -C "$DOTS" submodule sync -- depends/.local/share/polyframes || return 1
    git -C "$DOTS" submodule update --init -- depends/.local/share/polyframes || return 1
    git -C "$POLY_DIR" checkout -q -B main origin/main || return 1
    git -C "$POLY_DIR" pull --ff-only || return 1
}

deploy_source() {
    have bun || {
        echo "components: bun not found (arch: pacman -S bun, or --method npm/release)" >&2
        return 1
    }
    poly_sync || return 1
    [ "$DRY" = 1 ] && return 0
    (cd "$POLY_DIR" && bun install) || return 1
    # trust the checkout's dependencies (bun's policy blocks postinstall)
    local line pkg
    local untrusted
    untrusted="$(cd "$POLY_DIR" && bun pm untrusted 2>/dev/null || true)"
    for line in $untrusted; do
        case "$line" in
            node_modules/*) pkg="${line#node_modules/}"; pkg="${pkg%%/*}" ;;
            *) continue ;;
        esac
        if (cd "$POLY_DIR" && bun pm trust "./node_modules/$pkg" >/dev/null 2>&1); then
            echo "    trust: $pkg (postinstall scripts ran)"
        else
            echo "    trust: $pkg FAILED — its lifecycle scripts stay blocked"
        fi
    done
    # heal bun's own postinstall when it sits un-run
    if [ -f "$POLY_DIR/node_modules/bun/install.js" ]; then
        (cd "$POLY_DIR/node_modules/bun" && node install.js) || \
            echo "components: WARNING: local bun postinstall failed; the build may still fail" >&2
    fi
    make -C "$POLY_DIR" install || return 1
}

deploy_npm() {
    have npm || { echo "components: npm not found (arch: pacman -S npm, or --method release)" >&2; return 1; }
    [ "$DRY" = 1 ] && return 0
    npm install --global "$NPM_SPEC" || return 1
}

deploy_release() {
    local fetcher=""
    have curl && fetcher=curl
    [ -z "$fetcher" ] && have wget && fetcher=wget
    [ -n "$fetcher" ] || { echo "components: neither curl nor wget found (arch: pacman -S curl)" >&2; return 1; }
    if [ "$DRY" = 1 ]; then
        echo "    [dry-run] $fetcher $RELEASE_URL -> $POLY"
        return 0
    fi
    local tmp="/tmp/opencode/polyframes-install.$$"
    if [ "$fetcher" = curl ]; then
        curl -fL --retry 3 --user-agent doftiles-deploy "$RELEASE_URL" -o "$tmp" || { rm -f "$tmp"; return 1; }
    else
        wget -q -O "$tmp" "$RELEASE_URL" || { rm -f "$tmp"; return 1; }
    fi
    mkdir -p "$BIN_DIR"
    install -m 755 "$tmp" "$POLY" || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
}

deploy_polyframes() {
    local method="$1"
    local ok=1
    case "$method" in
        source)
            if deploy_source; then
                step components ok "built from source -> $POLY"
            else
                step components FAILED "source build failed"; FAILED=1; ok=0
            fi ;;
        npm)
            if deploy_npm; then
                step components ok "installed via npm -> $POLY"
            else
                step components FAILED "npm install failed"; FAILED=1; ok=0
            fi ;;
        release)
            if deploy_release; then
                step components ok "release artifact -> $POLY"
            else
                step components FAILED "download/install failed"; FAILED=1; ok=0
            fi ;;
        *) echo "components: unknown method '$method' (source|npm|release)" >&2; exit 2 ;;
    esac
    if [ "$ok" = 1 ] && [ "$DRY" != 1 ]; then
        conf_set "$method"
    fi
}

# ── main ──────────────────────────────────────────────────────────────
[ -d "$DOTS" ] || die2 "cannot locate the dots repo from $0"

install_bun
if ! have bun && [ "$DRY" != 1 ]; then
    # everything downstream (trust, herbctl, source builds) needs bun
    exit 1
fi
install_trust
install_herbctl

RECORDED="$(conf_get)"

if [ "$UNINSTALL" = 1 ]; then
    case "${RECORDED:-none}" in
        none|"")
            echo "components: nothing recorded in $CONF — nothing to uninstall"
            exit 0 ;;
    esac
    if [ "$DRY" = 1 ]; then
        echo "  [dry-run] uninstall polyframes per $RECORDED"
        exit 0
    fi
    if [ "$RECORDED" = npm ]; then
        npm uninstall --global polyframes || { echo "components: uninstall FAILED (method npm)" >&2; exit 1; }
    else
        rm -f "$POLY"
    fi
    conf_set none
    echo "components: uninstalled polyframes (was $RECORDED); submodule checkout left in place"
    exit 0
fi

METHOD="${METHOD:-$RECORDED}"
case "$METHOD" in
    source|npm|release) ;;
    none|"") METHOD="source"; have bun || METHOD="release" ;;
esac

if [ ! -e "$POLY" ] || [ "$FORCE" = 1 ] || [ "$METHOD_FLAG" = 1 ]; then
    [ -e "$POLY" ] && echo "components: $POLY exists — redeploying (method=$METHOD)"
    deploy_polyframes "$METHOD"
else
    step components ok "$POLY deployed already (method=${RECORDED:-unset}) — skipping (--force redeploys)"
fi

exit $([ $FAILED -gt 0 ] && echo 1 || echo 0)
