# ~/.config/systemd/user/dunst.service
[Unit]
Description=Dunst notification daemon (inside VcXsrv)
After=check-x-server.service herbst.service
Requires=check-x-server.service
Requires=basic.target
BindsTo=herbst.service

[Service]
Type=simple
# DISPLAY is inherited from the user manager environment, set by
# check-x-server — no hardcoded display here.
# WSLg exposes a Wayland socket (wayland-0) that dual-backend apps like
# rofi 2.0 autodetect; force the whole WM session onto X11/VcXsrv.
Environment=XDG_SESSION_TYPE=x11
UnsetEnvironment=WAYLAND_DISPLAY
ExecStart=/usr/bin/dunst
Restart=on-failure
RestartSec=3
# dunstctl reload (SIGHUP successor): dunst re-reads its config in
# process — the daemon keeps its D-Bus name and notifications queue
ExecReload=/usr/bin/dunstctl reload

[Install]
WantedBy=default.target
