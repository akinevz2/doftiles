#!/usr/bin/env bash
set -euo pipefail

# Multi-action test notification:
#   body   : "focus window in current stack" + the client list of the
#            currently focused tag's focused tiling frame (from dump + attr).
#   left   : do_action -> the "default" action -> shows a "dismissed" notification.
#   right  : context menu -> lists every window (its title as the label);
#            invoking one jumps to that window (herbstclient jumpto WINID).
#
# The acted-on action id is what dunstify prints, so we dispatch on it.

HERBSTUTIL="$HOME/dots/depends/.local/share/polyframes/node_modules/.bin/herbstutil"

focusid="$(herbstclient attr clients.focus.winid)"
# The focused frame's client group is the "(clients ...)" group that
# contains the focused client. Dump is one line; splitting on '(' keeps
# each group on its own line.
dump="$(herbstclient dump)"
row="$(printf '%s\n' "$dump" | tr '(' '\n(' | grep -F "$focusid" | head -1)"
if [ -z "${row:-}" ]; then
    echo "no focused frame client group found" >&2
    exit 1
fi
# strip "(clients ", "max:N", trailing ")"(s)
winids="$(printf '%s' "$row" | sed 's/(clients //; s/max:[0-9]* //; s/).*$//')"

echo "--dunst begins--"

# Build the notification argument list
opts=(-a stack-notify -u critical -t 900000)
# default action: confirm dismissal
opts+=(-A "default,Dismiss")

body="focus window in current stack"
for w in $winids; do
    title="$(herbstclient attr "clients.$w.title" 2>/dev/null || true)"
    [ -z "$title" ] && title="$w"
    opts+=(-A "$w,$title")
done

echo "--dunst ends--"

result="$(dunstify "${opts[@]}" "focus window in current stack" "$body")"
echo "action id result: ${result:-<none>}"

case "$result" in
    default)
        dunstify -u normal -t 5000 "dismissed"
        ;;
    0x*)
        herbstclient jumpto "$result"
        ;;
    *)
        echo "notification expired or closed without action" >&2
        ;;
esac
echo "exit: $?"
