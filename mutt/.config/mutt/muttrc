# DISABLED-OUTLOOK: 
# DISABLED-OUTLOOK: # ── mailboxes: what the sidebar lists (per account, `=`-prefixed to
# the account's $folder of the moment) ────────────────────────────────
mailboxes +INBOX +Sent\ Mail +Drafts +Trash +Archive
mailboxes imaps://akinevz@gmail.com@imap.gmail.com/INBOX imaps://akinevz@gmail.com@imap.gmail.com/Sent\ Mail
mailboxes imaps://kirilos24@gmail.com@imap.gmail.com/INBOX imaps://kirilos24@gmail.com@imap.gmail.com/Sent\ Mail
# DISABLED-OUTLOOK: mailboxes imaps://akinevz@outlook.com@outlook.office365.com/INBOX imaps://akinevz@outlook.com@outlook.office365.com/Sent

# ── folder shortcuts: <tab> cycles accounts via the sidebar ──────────
macro index,pager \ea "<change-folder>imaps://akinevz@gmail.com@imap.gmail.com/INBOX<enter>"
macro index,pager \ec "<change-folder>imaps://kirilos24@gmail.com@imap.gmail.com/INBOX<enter>"
# DISABLED-OUTLOOK: macro index,pager \ee "<change-folder>imaps://akinevz@outlook.com@outlook.office365.com/INBOX<enter>"

# ── compose / sending ────────────────────────────────────────────────
set use_from=yes
set fast_reply=yes
set include=yes				# quote the original on reply
set header_cache=~/.cache/mutt/headers
set message_cachedir=~/.cache/mutt/bodies

# ── vi/vim-style keybindings ─────────────────────────────────────────
# (hjkl everywhere, gg/G ends, g/G pager tops, d/u page, r reload)
bind index gg first-entry
bind index G last-entry
bind index j next-entry
bind index k previous-entry
bind index h noop				# h in index does nothing (use l to enter)
bind index l display-message			# l = open the message (vim-ish)
bind index g noop
bind index d noop				# protect: real deletes stay on dd
bind index u noop
bind index \Cf next-page
bind index \Cb previous-page
bind index zj collapse-thread
bind index zk collapse-all

bind pager gg top
bind pager G bottom
bind pager j next-line
bind pager k previous-line
bind pager h exit
bind pager l noop				# (links already open on enter)
bind pager \Cf next-page
bind pager \Cb previous-page

bind browser j next-entry
bind browser k previous-entry
bind browser gg first-entry
bind browser G last-entry
bind browser l select-entry			# l = descend into folder
bind browser h exit				# h = leave back to index
bind browser \Cf next-page
bind browser \Cb previous-page

bind alias j next-entry
bind alias k previous-entry
bind alias l select-entry
bind alias h exit

# ── colours ──────────────────────────────────────────────────────────
# Debian's /etc/Muttrc.d/colors.rc paints solid backgrounds (the status
# line arrives as brightgreen-on-blue and is unreadable on dark themes).
# Override everything: `default` background = the terminal's own colour,
# so text stays readable on any theme. Message bodies keep ANSI colors
# from the mail itself (color body strips nothing).
source /etc/Muttrc.d/colors.rc		# quote the useful bits, then repaint
color normal	white default
color hdrdefault cyan default
color status	white default		# the green-on-blue offender, fixed
color indicator	brightwhite default	# current entry: bold instead of paint
color attachment brightyellow default
color markers	brightred default
color tree	magenta default
color quoted	green default
color quoted1	cyan default
color quoted2	yellow default
color signature	cyan default
color tilde	blue default
color search	brightyellow default
color error	brightred default
color bold	brightwhite default

# vim: ft=muttrc
