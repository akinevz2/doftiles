# ~/.config/systemd/user/herbstluftwm.service
[Unit]
Description=herbstluftwm window manager (inside VcXsrv)
After=basic.target
Requires=basic.target

[Service]
Type=simple
Environment=DISPLAY=127.0.0.1:0
ExecStartPre=/bin/bash -c 'until xset -display 127.0.0.1:0 q >/dev/null 2>&1; do sleep 1; done'
ExecStart=/usr/bin/herbstluftwm
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
