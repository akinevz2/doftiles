# system.required — the SUBMODULE manifest: each non-comment line is a stow
# package followed by its dots-relative submodule path(s). This is the
# CONFIGURED scope of `on-deploy depends` (sync/build/install walk) and the
# source of the submodule walkers; comments (#) are preserved.
# 2026-11: each bun.ts submodule hosts ITS OWN artifact package (like bat).
bat bat/.local/share/bat-src
herbctl herbctl/.local/share/herbctl
herbstutil herbstutil/.local/share/herbstutil
on-deploy on-deploy/.local/share/on-deploy
polyframes polyframes/.local/share/polyframes
