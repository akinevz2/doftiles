#!/bin/sh
# hc_minimize — minimize (hide) a window.
#
# Sets clients.<wid>.minimized to true — the same effect as hlwm's
# native `minimize` command; kept as a standalone script (thin wrapper)
# for hc_command palette uniformity.
#
# Usage: hc_minimize [-c|-f] [<winid>]
#   no argument -> the focused window
#   -c          -> the selected client of the current tiling frame
#   -f          -> the focused floating window (floating layer focused)
#   an explicit winid argument wins over -c/-f

hc() { herbstclient "$@"; }

usage() {
	cat <<EOF
hc_minimize — minimize (hide) a window (clients.<wid>.minimized = true,
the same effect as hlwm's native minimize command).

Usage: hc_minimize [-c|-f] [<winid>]

Options:
  -c          target the selected client of the current tiling frame
  -f          target the focused floating window
  -h, --help  show this help and exit

With no arguments the focused window is used; if NO client is focused
(empty frame) the empty focused frame is removed instead. An explicit
winid wins.
EOF
}

wid=""
cf=""
while [ $# -gt 0 ]; do
	case $1 in
		-h|--help)
			usage
			exit 0
			;;
		-c|-f)
			[ -z "$cf" ] || { echo "hc_minimize: -c and -f are mutually exclusive" >&2; exit 1; }
			cf=$1
			;;
		-*)
			echo "hc_minimize: unknown option '$1'" >&2
			exit 1
			;;
		*)
			wid=$1
			;;
	esac
	shift
done

if [ -z "$wid" ] && [ -n "$cf" ]; then
	if [ "$cf" = -c ]; then
		cc=$(hc attr tags.focus.tiling.focused_frame.client_count 2>/dev/null || echo 0)
		wid=""
		case $cc in
			[1-9]|[1-9][0-9]*)
				sel=$(hc attr tags.focus.tiling.focused_frame.selection 2>/dev/null || true)
				wid=$(hc attr "tags.focus.tiling.focused_frame.client_${sel}.winid" 2>/dev/null || true)
				;;
		esac
		[ -n "$wid" ] || { echo "hc_minimize: no client in the current tiling frame" >&2; exit 1; }
	else
		ff=$(hc attr tags.focus.floating_focused 2>/dev/null || echo false)
		wid=$(hc attr clients.focus.winid 2>/dev/null || true)
		if [ "$ff" != "true" ] || [ -z "$wid" ]; then
			echo "hc_minimize: no focused floating window" >&2
			exit 1
		fi
	fi
elif [ -z "$wid" ]; then
	wid=$(hc attr clients.focus.winid 2>/dev/null || true)
fi

[ -n "$wid" ] || {
	# Nothing focused: the focused frame is an empty frame — remove it
	# instead (close_or_remove on an empty frame = frame removal, the
	# same idiom the mod-q chain uses).
	hc close_or_remove
	exit 0
}

hc set_attr "clients.$wid.minimized" true
