#!/bin/sh
# hc_resize — SHIM. The implementation moved into the polyframes
# project (~/development/personal/polyframes — compiled Bun/bunli
# binary; reads the WM through the bundled herbstutil parseAttr, no
# shell PATH/nvm fragility at keybind-spawn time).
#
# Usage (unchanged interface):
#   hc_resize [<dx> [<dy>]]     nudge the focused float (0 0 = print)
#   hc_resize <wid> frame       stretch to the parent/focused frame
#   hc_resize <wid> root        stretch to the monitor's work area
#   hc_resize <wid> <WxH+X+Y>   EXACT content rect (zoom's pre-float
#                               tile-rect carry-over)
#
# NOTE on translation: bunli's arg parsing consumes dash-prefixed
# tokens even after `--`, so negative deltas and dash-ish values are
# re-issued as =value flag form; the second positional dual-purposes
# as the delta dy / fill marker / explicit rect.
case $# in
    0)
        exec "$HOME/.local/bin/polyframes" resize
        ;;
    1)
        exec "$HOME/.local/bin/polyframes" resize --dx="$1"
        ;;
    2)
        if [ "$2" = "frame" ] || [ "$2" = "root" ] || printf '%s' "$2" | grep -Eq '^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$'; then
            exec "$HOME/.local/bin/polyframes" resize "--wid=$1" "--mode=$2"
        else
            exec "$HOME/.local/bin/polyframes" resize "--dx=$1" "--dy=$2"
        fi
        ;;
    *)
        echo "hc_resize: too many arguments" >&2
        exit 1
        ;;
esac
