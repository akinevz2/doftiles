{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "rarebox",
    "rarehost",
    "visionhost",
    "ws-vision"
  ],
  "default_agent": "detailed",
  "formatter": true,
  "lsp": true,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  },
  "permission": {
    "doom_loop": "deny",
    "external_directory": {
      "~/dots/**": "allow",
      "~/development/**": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "edit": {
      "~/.*/**": "deny",
      "~/.aliases": "ask",
      "~/.exports": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      ".git/**": "deny",
      "/tmp/**": "deny",
      ".opencode/system/**": "allow"
    },
    "read": {
      ".git/*": "ask",
      "~/.aliases": "allow",
      "~/.exports": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*>*": "ask",
      "*>>*": "ask",
      "*.git/*": "deny",
      "rm *": "ask",
      "echo *": "ask",
      "rmdir *": "ask",
      "rg *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git grep *": "allow",
      "git push *": "ask",
      "git pull *": "ask",
      "git commit *": "ask",
      "git add *": "ask",
      "git *": "ask",
      "mv *": "ask",
      "npm *": "ask",
    }
  },
  "provider": {
    "rarebox": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ws-rarebox",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "hf.co/unsloth/GLM-4.7-Flash-GGUF:MXFP4-MOE": {
          "name": "GLM 4.7 MOE",
        },
        "laguna-xs-2.1": {
          "name": "Laguna XS 2.1",
        },
        "nemotron-3.5-lightning": {
          "name": "Nemotron 3.5 Lightning",
        },
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash (202K ctx)",
        },
        "qwen3-coder": {
          "name": "Qwen3 Coder",
        }
      }
    }
  }
}