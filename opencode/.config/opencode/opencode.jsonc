{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "buffer": 6000,
    "keep": { "tokens": 8000 }
  },
  "plugins": ["./opencode-screencast"],
  "formatter": true,
  "lsp": true,
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "permission": {
    "doom_loop": "deny",
    "external_directory": {
      "~/dots/**": "allow",
      "~/development/**": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "edit": {
      "~/.*/**": "deny",
      "~/.aliases": "ask",
      "~/.exports": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      ".git/**": "deny",
      "/tmp/**": "allow",
      ".opencode/system/**": "allow"
    },
    "read": {
      ".git/*": "ask",
      "~/.aliases": "allow",
      "~/.exports": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*>*": "ask",
      "*>>*": "ask",
      "*.git/*": "deny",
      "cp *": "ask",
      "tee *": "ask",
      "sed -i*": "ask",
      "npx *": "ask",
      "patch *": "ask",
      "rm -rf *": "deny",
      "rm *": "ask",
      "echo *": "allow",
      "rmdir *": "ask",
      "rg *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git grep *": "allow",
      "git push *": "ask",
      "git pull *": "ask",
      "git commit *": "ask",
      "git add *": "ask",
      "git *": "ask",
      "mv *": "ask",
      "npm *": "ask"
    }
  },
  "provider": {
    "rarebox": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "WS-RAREBOX",
      "options": {
        "baseURL": "http://ws-rarebox:11434/v1"
      },
      "models": {
        "ollama/qwen3.8:27b": {
          "name": "Qwen 3.8 27B",
          "limit": {
            "context": 53248,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "reasoning": true,
          "tool_call": true
        },
        "unsloth/NVIDIA-Nemotron-3.5-Bolt-E4B-GGUF": {
          "name": "Nemotron 3.5 Bolt E4B",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "reasoning": true,
          "tool_call": true
        },
        "ollama/hf.co/unsloth/GLM-4.7-Flash-GGUF:MXFP4_MOE": {
          "name": "GLM 4.7 Flash MXFP4 MOE",
          "limit": {
            "context": 131072,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true
        },
        "ollama/hf.co/unsloth/DeepSeek-R1-Distill-Qwen-14B-GGUF:Q8_0": {
          "name": "DeepSeek R1 Distill Qwen 14B",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "reasoning": true,
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": ["/home/kine/.local/bin/github-mcp-wrapper"],
        "enabled": true
      },
      "notion": {
        "type": "local",
        "command": ["/home/kine/.local/bin/notion-mcp-wrapper"],
        "enabled": true
      }
    }
  }
}
