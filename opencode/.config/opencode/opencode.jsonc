{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "rarebox",
    "localhost",
    "ws-vision"
  ],
  "default_agent": "detailed",
  "formatter": true,
  "lsp": true,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  },
  "permission": {
    "doom_loop": "deny",
    "external_directory": {
      "~/dots/**": "allow",
      "~/development/**": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "edit": {
      "~/.*/**": "deny",
      "~/.aliases": "ask",
      "~/.exports": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      ".git/**": "deny",
      "/tmp/**": "deny",
      ".opencode/system/**": "allow"
    },
    "read": {
      ".git/*": "ask",
      "~/.aliases": "allow",
      "~/.exports": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*>*": "ask",
      "*>>*": "ask",
      "*.git/*": "deny",
      "rm *": "ask",
      "echo *": "ask",
      "rmdir *": "ask",
      "rg *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git grep *": "allow",
      "git push *": "ask",
      "git pull *": "ask",
      "git commit *": "ask",
      "git add *": "ask",
      "git *": "ask",
      "mv *": "ask",
      "npm *": "ask",
    }
  },
  "provider": {
    "rarebox": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ws-rarebox",
      "options": {
        "baseURL": "http://ws-rarebox:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "nemotron-3.5-lightning": {
          "name": "Nemotron 3.5 Lightning (1M ctx)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 1048576,
            "output": 1048576
          }
        },
        "laguna-xs-2.1": {
          "name": "Laguna XS 2.1 (262K ctx)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash (202K ctx)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 202752,
            "output": 202752
          }
        },
        "hf.co/unsloth/GLM-4.7-Flash-GGUF:UD-Q4_K_XL": {
          "name": "GLM 4.7 Flash GGUF (131K ctx)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 202752,
            "output": 202752
          }
        },
        "glm-4.7-quant": {
          "name": "GLM 4.7 Quant (65K ctx)"
        },
        "glm-4.7-performance": {
          "name": "GLM 4.7 Performance (51K ctx)"
        },
        "deepseek-r1-performance": {
          "name": "DeepSeek R1 Performance (46K ctx)"
        },
        "qwen3-coder": {
          "name": "Qwen3 Coder (262K ctx)",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 262144,
            "output": 262144
          }
        },
        "hf.co/TeichAI/GLM-4.7-Flash-Claude-Opus-4.5-High-Reasoning-Distill-GGUF:IQ4_XS": {
          "name": "GLM 4.7 Opus 4.5 Distill (IQ4_XS) (202K ctx)",
          "tool_call": false,
          "reasoning": false,
          "limit": {
            "context": 202752,
            "output": 202752
          }
        },
        "hf.co/ryzdfm/qwen2.5-coder-3b-claude_opus_4.6-distilled:Q4_K_M": {
          "name": "Qwen2.5 Coder Opus 4.6 Distill (Q4_K_M) (32K ctx)",
          "tool_call": true,
          "reasoning": false,
          "limit": {
            "context": 32768,
            "output": 32768
          }
        }
      }
    },
    "localhost": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "localhost",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama",
        "timeout": false,
        "headerTimeout": false,
      },
      "models": {
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash (202K ctx)",
          "tool_call": true,
          "reasoning": true
        },
        "hf.co/unsloth/GLM-4.7-Flash-GGUF:UD-Q4_K_XL": {
          "name": "GLM 4.7 Flash GGUF (131K ctx)",
          "tool_call": true,
          "reasoning": true
        },
        "glm-4.7-performance": {
          "name": "GLM 4.7 Performance (51K ctx)"
        },
        "glm-4.7-quant": {
          "name": "GLM 4.7 Quant (65K ctx)"
        },
        "deepseek-r1-performance": {
          "name": "DeepSeek R1 Performance (46K ctx)"
        },
        "laguna-xs-performance": {
          "name": "Laguna XS Performance (65K ctx)"
        }
      }
    },
    "ws-vision": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ws-vision",
      "options": {
        "baseURL": "http://ws-vision:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "glm-4.7-performance:latest": {
          "name": "GLM 4.7 Performance Latest (51K ctx)"
        }
      }
    }
  }
}