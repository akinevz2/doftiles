# theme — herbstluftwm colors, decorations, and layout gaps.
# Sourced by reload_theme (herbst_theme) inside its lock. All
# values previously inline in reload_theme; widths/paddings
# copied from the floating config per the user decision.


herb attr theme.tiling.reset 1
herb attr theme.floating.reset 1

herb set frame_transparent_width 5
herb set frame_border_width 2

herb attr theme.minimal.border_width 0
# widths copied from the floating config (visual parity floats/tiles —
# the polyframes deco-flush fills assume matching band widths):
herb attr theme.inner_width 2
herb attr theme.border_width 2
herb attr theme.outer_width 2


#= COLOURS =#
herb attr theme.color $BACKGROUND_HEX
herb attr theme.inner_color $BACKGROUND_HEX
herb attr theme.outer_color $BACKGROUND_HEX
# herb attr theme.outer_color $BACKGROUND_HEX
herb attr theme.active.color '#333333'
herb attr theme.active.outer_color '#feef69'
herb attr theme.active.inner_color '#333333'
# herb attr theme.active.inner_color $BACKGROUND_HEX
herb attr theme.normal.color '#333333'
herb attr theme.normal.outer_color $BACKGROUND_HEX
herb attr theme.normal.inner_color '#333333'

herb set frame_border_normal_color $BACKGROUND_HEX
herb set frame_border_active_color '#eeeeee'
herb set frame_bg_normal_color $BACKGROUND_HEX
herb set frame_bg_active_color '#333333'

herb attr theme.background_color $BACKGROUND_HEX

#= TILING SWAP (trial block - comment out to revert to the theme above) =#
# tiling base: both states grey; the focused state is overridden to the
# background colour directly below
# herb attr theme.tiling.color                 $BACKGROUND_HEX
# active/focused: background-coloured title bar and inner border,
# gold title text, white outer border
# normal/unfocused: white title on grey fill, compact look — grey inner
# border against a background-coloured outer border
# state-level: the active/normal children are resolved for windows too,
# so compact-look outer also has to be pinned at the normal state level
# herb attr theme.tiling.normal.color    '#333333'
# herb attr theme.tiling.normal.inner_color    '#333333'
# floating focused: the inner border is background-coloured so floats
# look borderless-inward; outer stays #333333 from the floating block

herb set hide_covered_windows on
herb set always_show_frame on
herb set frame_bg_transparent on

# paddings copied from the floating config (5s; were 4 — parity with
# the floating deco bands)
herb attr theme.padding_left 5
herb attr theme.padding_right 5
herb attr theme.padding_top 5
herb attr theme.padding_bottom 5
herb attr theme.floating.color '#333333'
herb attr theme.floating.outer_color $BACKGROUND_HEX
herb attr theme.floating.inner_color '#eeeeee'
herb attr theme.floating.active.inner_color '#333333'
herb attr theme.floating.active.outer_color '#feef69'
herb attr theme.floating.active.color $BACKGROUND_HEX
herb attr theme.floating.outer_width 2
herb attr theme.floating.inner_width 2

herb attr theme.floating.tight_decoration true
herb attr theme.floating.padding_left 5
herb attr theme.floating.padding_right 5
herb attr theme.floating.padding_top 5
herb attr theme.floating.padding_bottom 5
# title heights synchronized with the floating mode (24/5): tiling
# windows render the same title strip (theme.tiling outranks the
# state-level 15s for tiled windows)
herb attr theme.floating.border_width 2

herb set frame_gap 2
herb set window_gap 5
herb set frame_padding 2

herb set smart_window_surroundings off
herb set smart_frame_surroundings on

herb set tree_style '        '


