#!/usr/bin/env bash
# hc_zoom — three-state toggler for the focused window, then center it:
#   tiled      -> float it, stretched to fill the frame       (press 1)
#   floating   -> maximize onto a dedicated <tag>-max tag     (press 2)
#   maximized  -> restore to the original tag/frame (hc_unmaximize) (press 3)
# Every branch is followed by hc_center frame, so the window always
# ends up centered inside the focused frame of the tag it lands on.
#
# "Maximized" means the client lives on a "<tag>-max" tag (see
# hc_maximize, which also clears floating on move) — so the maximized
# check must be made BEFORE the floating check, or a maximized window
# would be misread as tiled and re-floated instead of restored.

set -euo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY
unset WAYLAND_DISPLAY

herb() {
    herbstclient "$@"
}

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
hc_zoom — three-state toggle for the focused window: tiled -> float
(stretched to the frame) -> maximized onto a <tag>-max tag -> restore
(see the header below).

Usage: hc_zoom

Options:
  -h, --help  show this help and exit

Keybind state machine: always operates on the focused window — no
window arguments and no -c/-f targeting.
EOF
        exit 0
        ;;
esac

hc_float() {
    herb attr clients."$1".floating on
}

wid=$(herb attr clients.focus.winid 2>/dev/null) || wid=""
[ -n "$wid" ] || {
    echo "hc_zoom: no focused window" >&2
    exit 1
}

# Hold the WM lock across the whole toggle: branch (a) runs hc_center
# followed by hc_resize, and without an outer lock the window would be
# drawn at the centered geometry for a frame before jumping to the
# frame-filling one (visible flash). hlwm's lock is reference-counted,
# so the nested locks inside hc_center/hc_resize/hc_maximize/
# hc_unmaximize stay balanced; the trap releases the outer lock on
# every exit path.
herb lock
trap 'herb unlock' EXIT

tag=$(herb attr "clients.${wid}.tag" 2>/dev/null) || tag=""
floating=$(herb attr "clients.${wid}.floating" 2>/dev/null || echo false)

case "$tag" in
    *-max)
        # (c) maximized -> back to the original tag/frame
        "$HOME/.local/bin/hc_unmaximize" "$wid"
        ;;
    *)
        if [ "$floating" = "true" ]; then
            # (b) floating, not maximized -> dedicated max tag
            "$HOME/.local/bin/hc_maximize" "$wid"
        else
            # (a) tiled -> float the focused window directly: clear
            # stray fullscreen/pseudotile flags, then hc_center frame
            # floats it, centers it inside its focused frame and
            # focuses it. No delegation to hc_focus — from the tiling
            # layer hc_focus's default is to focus an existing float
            # rather than float the focused window.
            herb attr "clients.$wid.fullscreen" off 2>/dev/null || true
            herb attr "clients.$wid.pseudotile" off 2>/dev/null || true
            "$HOME/.local/bin/hc_center" root || true
            # Deco-flush fill: the floating window is sized to the frame
            # content rect MINUS its decoration margins, so the deco
            # borders coincide exactly with the frame's content rect
            # (polygon-checked: frame vs decoration_geometry are equal
            # after the fill). hc_fit_to frame is the idempotent guard.
            "$HOME/.local/bin/hc_resize" "$wid" frame || true
            "$HOME/.local/bin/hc_fit_to" root || true
        fi
        ;;
esac

