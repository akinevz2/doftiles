#!/usr/bin/env bash
# hc_launch — run a command string inside a spawned $TERMINAL.
#
# Pattern ported from the screencast plugin's single-shot terminal
# (development/system screencast_scripts): the command runs under an
# interactive bash inside the spawned terminal; when it exits, the
# shell reports the exit status and waits for a SINGLE key press
# ("press any key to close"), then exits — and the terminal window
# closes with it. Nothing lingers.
#
# Usage: hc_launch [--floating] [--urgent] [--no-distract] "<command>"
#   TERMINAL overrides the terminal (default: alacritty).
#
# The switches install a `rule once` before the spawn, so the window
# rules apply to exactly this terminal:
#   --floating     the terminal window floats AND is centered in the
#                  monitor once it attached and took focus (suppressed
#                  by --no-distract)
#   --urgent       the terminal raises the urgent hint (tag marker)
#   --no-distract  the terminal does NOT take focus on attach and
#                  keeps its DEFAULT position (no centering)
# Several switches combine into one rule.
#
# Spawned through `herbstclient spawn` (detached, WM-managed) — NOT
# through `hc spawn` rules machinery: that is for graphical apps.
#
# The spawn + centering sequence runs under a hlwm lock: the window
# then appears at its final (centered) position in ONE repaint instead
# of attaching at the default float position and jumping. The EXIT
# trap guarantees the unlock on every path — a leaked lock freezes
# the WM (the reload_theme lesson).

set -euo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY
unset WAYLAND_DISPLAY

hc() { herbstclient "$@"; }

rule=()
floating=0
nodistract=0
while [ "${1:-}" = "--floating" ] || [ "${1:-}" = "--urgent" ] || [ "${1:-}" = "--no-distract" ]; do
    case $1 in
        --floating)    rule+=(floating=on); floating=1 ;;
        --urgent)      rule+=(urgent=on) ;;
        --no-distract) rule+=(focus=off); nodistract=1 ;;
    esac
    shift
done

if [ -z "${1:-}" ]; then
    echo "usage: hc_launch [--floating] [--urgent] [--no-distract] \"<command string>\"" >&2
    exit 1
fi

TERMINAL="${TERMINAL:-alacritty}"
USER_CMD="$*"

# Interactive bash so the user's aliases and functions resolve. The
# command string is %q-quoted and eval'd; after it exits the shell
# reports the status and waits for ONE key press, then exits — the
# terminal closes naturally with its shell.
QUOTED=$(printf '%q' "$USER_CMD")
INNER="__rc=0; eval $QUOTED; __rc=\$?; echo; echo \"[exit \$__rc] press any key to close...\"; read -sn1 -r _"

[ ${#rule[@]} -gt 0 ] && hc rule once "${rule[@]}" 2>/dev/null || true

# The `before` snapshot MUST precede the spawn — the window can attach
# within the first poll tick.
before=$(hc list_clients 2>/dev/null | sort | tr '\n' ' ')

hc lock
trap 'hc unlock' EXIT

hc spawn "$TERMINAL" -e bash -ic "$INNER"

# --floating centers the window as part of the locked sequence: wait
# for the attach, then jumpto (focus it explicitly — a freshly spawned
# client cannot be relied on to hold focus) and center. No polling on
# focus: the old focus-settle loop burned its whole timeout whenever
# hlwm left focus on the previous window, delaying the unlock (the
# first paint) by seconds and skipping the centering.
if [ "$floating" = 1 ] && [ "$nodistract" = 0 ]; then
    new=""
    for i in $(seq 1 50); do
        sleep 0.1
        after=$(hc list_clients 2>/dev/null | sort | tr '\n' ' ')
        for w in $after; do
            case " $before " in *" $w "*) ;; *) new=$w; break ;; esac
        done
        [ -n "$new" ] && break
    done
    if [ -n "$new" ]; then
        hc jumpto "$new" 2>/dev/null || true
        "$HOME/.local/bin/hc_center" root || true
    fi
fi

hc unlock
trap - EXIT
