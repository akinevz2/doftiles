#!/usr/bin/env bash
# hc_dismiss-notifs — close all currently displayed notifications.
# Bound to modctrl-d: one press sweeps the error stack (dunst stacks
# duplicates, so a burst of journal errors is one keypress away).

set -euo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY
unset WAYLAND_DISPLAY

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
hc_dismiss-notifs — close all currently displayed notifications
(dunstctl close-all).

Usage: hc_dismiss-notifs

Options:
  -h, --help  show this help and exit
EOF
        exit 0
        ;;
esac

exec dunstctl close-all
