#!/usr/bin/env bash
# hc_floatx — Mod-x: the layer-focus toggle / yanker. FINAL semantics:
#
#   floating_focused FALSE (tiling layer owns focus):
#     1. TRY focusing a float (floating_focused on; it fails when no
#        non-minimized float exists).
#     2. Success + populated focused frame -> FOCUS the float
#        (jumpto): the float KEEPS its floating status.
#     2b. Success + empty focused frame -> UN-FLOAT the focused float
#         into the empty frame (unfloat_into_frame_below).
#     3. Failure -> no floats exist:
#          populated focused frame  -> YANK (re-added): the focused
#                                     client floats at its current
#                                     size, centered in the monitor,
#                                     INTO the float session
#                                     (clients.focus.floating on +
#                                     floating_focused on). The frame
#                                     stays (mod-x never closes frames
#                                     on this or the focus-a-float
#                                     path — empty frames are only
#                                     closed in the tidying branch).
#          empty focused frame      -> tidying (frame removal, reveal
#                                     minimized, polyframes hidden in
#                                     max layout, or use_previous).
#
#   floating_focused TRUE (a float holds the layer focus):
#     populated focused frame, ONE frame on the tag -> the revised
#                                 sequence: use_previous, hc_tile,
#                                 un-float the focused client there.
#     populated focused frame, MULTIPLE frames -> DEFER: hand focus
#                                 to the tiling layer (floating_focused
#                                 off); the next press re-runs 1–2
#                                 above.
#     empty focused frame      -> FOCUS the tiling layer (floating_focused
#                                 off) — never un-float FROM the floating
#                                 layer: un-float into an empty frame
#                                 happens only FROM the tiling layer.
#
# Floating-status writes (clients.focus.floating on/off) exist ONLY in
# the two float-into-empty-frame paths (yank with a populated frame and
# un-float into an EMPTY frame); every other path is a pure layer-focus
# (floating_focused) toggle. Un-float chains intentionally contain NO
# floating_focused off — hlwm tracks the register on un-float; the
# defensive write raced with it. Standalone register writes (defer,
# re-entry failure) remain.
#
# Performance note: a herbstclient round-trip costs ~40 ms on this
# setup, so multi-read/multi-write sequences are batched into single
# `chain` spawns wherever possible.

set -uo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY
unset WAYLAND_DISPLAY

hc() { herbstclient "$@"; }

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
hc_floatx — Mod-x: the layer-focus toggle / yanker (full state machine
in the header below).

Usage: hc_floatx

Options:
  -h, --help  show this help and exit

Keybind state machine: always operates on the current focus state —
no window arguments and no -c/-f targeting.
EOF
        exit 0
        ;;
esac

hc lock
trap 'hc unlock' EXIT

orig=$(hc attr clients.focus.winid 2>/dev/null || true)

state_out=$(hc chain \
    , attr tags.focus.curframe_wcount , echo "|" \
    , attr tags.focus.tiling.focused_frame.client_count , echo "|" \
    , attr tags.focus.frame_count , echo "|" \
    , attr tags.focus.tiling.focused_frame.algorithm , echo "|" \
    , attr tags.focus.name , echo "|" \
    , attr tags.focus.tiling.focused_frame.content_geometry , echo "|" \
    , attr clients.focus.floating_effectively 2>/dev/null)
mapfile -d '|' -t st < <(printf '%s' "${state_out//$'\n'/}")
frame_clients=${st[0]:-0}
frame_cc=${st[1]:-0}
frame_count=${st[2]:-1}
algo=${st[3]:-}
tag=${st[4]:-}
fgeo=${st[5]:-}

tag_total() {
    [ -n "$tag" ] || { echo 0; return 0; }
    hc attr "tags.by-name.${tag}.client_count" 2>/dev/null || echo 0
}

has_minimized_clients() {
    [ -n "$tag" ] || return 1
    local winid cmd=(chain)
    for winid in $(hc list_clients --tag="$tag" 2>/dev/null); do
        cmd+=(, attr "clients.$winid.minimized")
    done
    [ ${#cmd[@]} -gt 1 ] || return 1
    case $(hc "${cmd[@]}" 2>/dev/null) in
        *true*) return 0 ;;
    esac
    return 1
}

# Scan for the first visible (non-minimized) float on the tag,
# resolved UP FRONT (clients.focus settles late after the switch).
ff=$(hc attr tags.focus.floating_focused 2>/dev/null || echo false)
first_float=""
for c in $(hc list_clients --tag="$tag" 2>/dev/null); do
    if [ "$(hc attr "clients.$c.floating" 2>/dev/null || echo false)" = "true" ] \
       && [ "$(hc attr "clients.$c.minimized" 2>/dev/null || echo false)" = "false" ]; then
        first_float=$c
        break
    fi
done

unfloat_wid() {  # $1 = float wid: fold flags, un-float, focus it.
    hc chain , attr "clients.$1.fullscreen" off \
       , attr "clients.$1.pseudotile" off \
       , attr "clients.$1.floating" off 2>/dev/null || true
    hc jumpto "$1" 2>/dev/null || true
}

unfloat_into_frame_below() {  # $1 = float wid
    # Mod-f's tile register, performed HERE (Mod-x owns hc_tile now;
    # Mod-f un-floats directly and closes frames instead): populate
    # case in a NON-MAX layout -> hc_tile makes the new empty frame
    # and the window un-floats into it; empty frame or max layout ->
    # direct un-float.
    local fcc falgo
    fcc=$(hc attr tags.focus.tiling.focused_frame.client_count \
          2>/dev/null || echo 0)
    falgo=$(hc attr tags.focus.tiling.focused_frame.algorithm \
            2>/dev/null || echo "")
    if [ "$fcc" != "0" ] && [ "$falgo" == "max" ]; then
        "$HOME/.local/bin/hc_tile" "$1" || true
        return
    fi
    unfloat_wid "$1"
}

if [ "$ff" = "true" ]; then
    # Called on a FLOATING window (float session):
    #   populated focused frame, ONE frame on the tag -> the revised
    #     sequence: use_previous (back to the previously viewed tag),
    #     hc_tile (the tile register on whatever holds focus there);
    #     the focused client's floating status is NOT changed.
    #   populated focused frame, MULTIPLE frames -> DEFER: hand focus
    #     to the tiling layer; the next press re-runs the
    #     focus-and-un-float branch.
    #   empty focused frame -> FOCUS the tiling layer (floating_focused
    #     off) — never un-float from the floating layer.
    if [ "$frame_cc" != "0" ]; then
        if [ "$frame_count" = "1" ]; then
            herb use_previous
            "$HOME/.local/bin/hc_tile" 2>/dev/null || true
            # NO floating write here: the focused window's floating
            # status must not change.
        else
            hc attr tags.focus.floating_focused off 2>/dev/null || true
        fi
        exit 0
    fi
    # Empty frame: hand focus to the tiling layer; un-float into an
    # empty frame only ever happens FROM the tiling layer (the
    # floating_focused-false branch below), never from here.
    hc attr tags.focus.floating_focused off 2>/dev/null || true
    exit 0
fi

# floating_focused FALSE: try focusing a float FIRST.
if hc attr tags.focus.floating_focused on 2>/dev/null; then
    # Success on the layer-focus attempt. The PRE-SCANNED first_float
    # is PRIMARY — clients.focus settles late after the switch.
    wfocus=$first_float
    [ -n "$wfocus" ] || wfocus=$(hc attr clients.focus.winid 2>/dev/null || true)
    if [ -n "$wfocus" ]; then
        if [ "$frame_cc" != "0" ]; then
            # Populated frame: focus the switched-to float WITHOUT
            # un-floating it — the window's floating status must not
            # change (pure layer-focus toggle).
            hc jumpto "$wfocus" 2>/dev/null || true
        else
            # Empty frame: un-float the float into it.
            unfloat_into_frame_below "$wfocus"
        fi
        exit 0
    fi
    hc attr tags.focus.floating_focused off 2>/dev/null || true
    exit 0
fi

# Re-entry failed: no non-minimized float exists.
if [ "$frame_cc" -gt 0 ]; then
    # YANK (re-added): float the focused client, center it in the
    # monitor's geometry at its current size, INTO the float session.
    # The (now possibly empty) frame is deliberately LEFT ALONE — mod-x
    # only closes empty frames in the no-floats-to-focus tidying branch
    # below, never when floating a window or focusing the float layer.
    hc attr clients.focus.floating on 2>/dev/null || true
    "$HOME/.local/bin/hc_center" root || true
    hc attr tags.focus.floating_focused on 2>/dev/null || true
    exit 0
fi

# Empty frame, no floats: tidying.
if [ "$frame_count" -gt 1 ]; then
    if [ "$frame_clients" -eq 0 ] && [ "$(tag_total)" != "0" ]; then
        hc remove
        exit 0
    fi
    # Hidden windows exist and nothing is tiled in the focused frame:
    # reveal them.
    if has_minimized_clients && [ "$frame_cc" -eq 0 ]; then
        cmd=(chain)
        for winid in $(hc list_clients --tag="$tag" 2>/dev/null); do
            cmd+=(, attr "clients.$winid.minimized" off)
        done
        hc "${cmd[@]}" 2>/dev/null || true
        exit 0
    fi
fi

if [ "$frame_clients" = 0 ] && [ "$(tag_total)" != "0" ]; then
    hc remove
    exit 0
fi

if [ "$algo" == "max" ] && has_minimized_clients && [ "$frame_clients" -lt 1 ]; then
    hc spawn "$HOME/.local/bin/polyframes hidden"
    exit 0
fi

hc use_previous
[ -n "$orig" ] && hc bring "$orig" || true
