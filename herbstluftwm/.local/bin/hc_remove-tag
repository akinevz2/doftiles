#!/usr/bin/env bash
# hc_remove-tag — merge a tag away into a destination and land there.
#
#   hc_remove-tag              current -> default
#   hc_remove-tag <dst>        current -> <dst>   (dst replaces default)
#   hc_remove-tag <src> <dst>  <src>   -> <dst>
#
# "default" is created as the LAST tag when it does not exist yet (the
# no-arg and one-arg forms); the two-arg form never invents tags — it
# errors instead.
#
# This build refuses merge_tag on the VIEWED tag, so when the source
# is being viewed the view first hops to the destination; the view
# ends on the merge target either way.
#
# Errors surface as desktop notifications (hc_send-error):
#   - no args and the current tag IS default (nothing to remove);
#   - the source tag does not exist;
#   - the destination tag does not exist (two-arg form only);
#   - source and destination are the same tag.

set -euo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY
unset WAYLAND_DISPLAY

herb() {
    herbstclient "$@"
}

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
hc_remove-tag — merge a tag away into a destination and land there.

Usage:
  hc_remove-tag              current -> default
  hc_remove-tag <dst>        current -> <dst>   (dst replaces default)
  hc_remove-tag <src> <dst>  <src>   -> <dst>
  hc_remove-tag -N           current -> the tag at index N-1 (-1 =
                             the first tag), instead of default
  hc_remove-tag <src> -N     <src>   -> the tag at index N-1

Options:
  -N          merge into the tag at INDEX N-1 (1-based tag number,
              matching the Mod+N workspaces keybinds) instead of
              "default"; the tag must exist
  -h, --help  show this help and exit

Tag-level operation — no window targeting. "default" is created as the
LAST tag when missing (single-destination forms); the two-argument form
never invents tags. Errors surface as desktop notifications
(hc_send-error).
EOF
        exit 0
        ;;
esac

SEND_ERROR="$HOME/.local/bin/hc_send-error"
DEFAULT_TAG=default

src=""
dst=""
index_dst=""
posargs=()
while [ $# -gt 0 ]; do
    case $1 in
        -h|--help) usage; exit 0 ;;
        -[0-9]*)
            if [ -n "$index_dst" ]; then
                "$SEND_ERROR" "hc_remove-tag" "repeated -N index option"
                exit 1
            fi
            index_dst=$(( ${1#-} - 1 )) ;;
        -*)
            "$SEND_ERROR" "hc_remove-tag" "unknown option '$1'"
            exit 1 ;;
        *) posargs+=("$1") ;;
    esac
    shift
done

case ${#posargs[@]} in
    0) dst=$DEFAULT_TAG ;;                      # src = current tag
    1)
        # one positional: the destination — unless -N already claims
        # it, then the positional is the SOURCE
        if [ -n "$index_dst" ]; then
            src="${posargs[0]}"
        else
            dst="${posargs[0]}"
        fi ;;
    2)
        if [ -n "$index_dst" ]; then
            "$SEND_ERROR" "hc_remove-tag" \
                "specify either <dst> or -N, not both"
            exit 1
        fi
        src="${posargs[0]}" dst="${posargs[1]}" ;;
    *) "$SEND_ERROR" "hc_remove-tag" "usage: hc_remove-tag [src] [dst|-N]"
       exit 1 ;;
esac

# -N: the destination is the tag at the given INDEX (1-based number).
# It must exist — no tag is ever invented for an index destination.
if [ -n "$index_dst" ]; then
    if [ "$index_dst" -lt 0 ]; then
        "$SEND_ERROR" "hc_remove-tag" "invalid tag number (use -1 .. -$(( $(herb attr tags.count 2>/dev/null || echo 0) )))"
        exit 1
    fi
    cnt=$(herb attr tags.count 2>/dev/null || echo 0)
    if [ "$index_dst" -ge "$cnt" ]; then
        "$SEND_ERROR" "hc_remove-tag" \
            "no tag at number $(( index_dst + 1 )) ($cnt tag(s) exist)"
        exit 1
    fi
    dst=$(herb attr "tags.$index_dst.name")
fi

current=$(herb attr tags.focus.name)
[ -n "$src" ] || src=$current

# --- validation ----------------------------------------------------------
if [ -z "${posargs[0]:-}" ] && [ "$current" = "$DEFAULT_TAG" ] \
    && [ -z "$index_dst" ]; then
    "$SEND_ERROR" "hc_remove-tag" \
        "cannot remove '$DEFAULT_TAG': it is the current tag"
    exit 1
fi

if [ "$src" = "$dst" ]; then
    "$SEND_ERROR" "hc_remove-tag" "cannot merge '$src' into itself"
    exit 1
fi

if ! herb attr "tags.by-name.$src.name" >/dev/null 2>&1; then
    "$SEND_ERROR" "hc_remove-tag" "source tag '$src' not found"
    exit 1
fi

if ! herb attr "tags.by-name.$dst.name" >/dev/null 2>&1; then
    if [ -z "${posargs[0]:-}" ]; then
        herb add "$dst"                        # appended as the last tag
    else
        "$SEND_ERROR" "hc_remove-tag" "destination tag '$dst' not found"
        exit 1
    fi
fi

# --- merge (hop to the destination first when the source is viewed) -----
if [ "$src" = "$current" ]; then
    herb use "$dst"
fi
herb merge_tag "$src" "$dst"

echo "hc_remove-tag: merged '$src' into '$dst'"
