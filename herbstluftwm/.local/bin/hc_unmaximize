#!/usr/bin/env bash
# hc_unmaximize — restore a maximized client to its original location,
# by TRIGGERING the per-tag janitor (hc_maximize-daemon) instead of
# performing the restore dance here. The daemon's dismissal path owns
# the move-home + merge without the destination-tag flash (the old
# `use`-round-trip) — and the janitor hc_clean_max-tag checks that the
# max tag being merged isn't the viewed one, stepping aside to the
# base tag first when it is.
#
# Usage: hc_unmaximize [-c|-f] [<wid>]
#   no argument -> the focused window; -c -> the selected client of
#   the current tiling frame; -f -> the focused float; an explicit
#   winid argument wins over -c/-f.
#   - the window must live on a "<...>-max" tag; no-op otherwise.
#   - daemon instance alive -> emit_hook unmaximize_request <tag>
#     (the running daemon handles it on its event stream);
#   - no daemon alive       -> spawn it detached with --dismiss-now.

set -euo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY
unset WAYLAND_DISPLAY

usage() {
    cat <<'EOF'
hc_unmaximize — restore a maximized client to its original location by
triggering the per-tag janitor (hc_maximize-daemon); semantics in the
header below.

Usage: hc_unmaximize [-c|-f] [<wid>]

Options:
  -c          target the selected client of the current tiling frame
  -f          target the focused floating window
  -h, --help  show this help and exit

With no arguments the focused window is used; an explicit winid wins.
EOF
}

# --- target resolution ----------------------------------------------------
# No argument -> the focused client; -c -> the selected client of the
# current tiling frame; -f -> the focused float (only while the floating
# layer is focused). -c and -f are mutually exclusive; an explicit wid
# argument wins over both.
wid=""
cf=""
while [ $# -gt 0 ]; do
    case $1 in
        -h|--help) usage; exit 0 ;;
        -c|-f)
            [ -z "$cf" ] || { echo "hc_unmaximize: -c and -f are mutually exclusive" >&2; exit 1; }
            cf=$1
            ;;
        -*) echo "hc_unmaximize: unknown option '$1'" >&2; exit 1 ;;
        *) wid=$1 ;;
    esac
    shift
done

if [ -z "$wid" ] && [ -n "$cf" ]; then
    if [ "$cf" = -c ]; then
        cc=$(herbstclient attr tags.focus.tiling.focused_frame.client_count 2>/dev/null || echo 0)
        wid=""
        case $cc in
            [1-9]|[1-9][0-9]*)
                sel=$(herbstclient attr tags.focus.tiling.focused_frame.selection 2>/dev/null || true)
                wid=$(herbstclient attr "tags.focus.tiling.focused_frame.client_${sel}.winid" 2>/dev/null || true)
                ;;
        esac
        [ -n "$wid" ] || { echo "hc_unmaximize: no client in the current tiling frame" >&2; exit 1; }
    else
        ff=$(herbstclient attr tags.focus.floating_focused 2>/dev/null || echo false)
        wid=$(herbstclient attr clients.focus.winid 2>/dev/null || true)
        if [ "$ff" != "true" ] || [ -z "$wid" ]; then
            echo "hc_unmaximize: no focused floating window" >&2
            exit 1
        fi
    fi
elif [ -z "$wid" ]; then
    wid=$(herbstclient attr clients.focus.winid 2>/dev/null || true)
fi
[ -n "$wid" ] || { echo "hc_unmaximize: no focused window" >&2; exit 1; }
WID=$wid

cur_tag=$(herbstclient attr "clients.${WID}.tag" 2>/dev/null) || cur_tag=""
case "$cur_tag" in
    *-max) ;;          # proceed
    *) exit 0 ;;       # not maximized — nothing to do
esac

lockdir="${TMPDIR:-/tmp}/hc_maximize-daemon.lock.${cur_tag}"
if [ -d "$lockdir" ]; then
    herbstclient emit_hook unmaximize_request "$cur_tag"
else
    "$HOME/.local/bin/hc_maximize-daemon" "$cur_tag" --dismiss-now &
fi
exit 0
