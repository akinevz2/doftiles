#!/usr/bin/env bash
# hc_get-visible-clients
# Print the winids of all clients hlwm reports as visible on the
# currently focused tag, one per line, in WM order. Uses the wm's own
# `visible` attribute rather than filtering on `minimized` (covers
# hidden-by-other-means too, e.g. on another monitor).
set -euo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
hc_get-visible-clients — print the winids of all clients hlwm reports
as visible on the currently focused tag, one per line, in WM order.

Usage: hc_get-visible-clients

Options:
  -h, --help  show this help and exit

Query tool: uses the wm's own `visible` attribute rather than
filtering on `minimized` (see the header below).
EOF
        exit 0
        ;;
esac

tag=$(herbstclient attr tags.focus.name)

for wid in $(herbstclient list_clients --tag="$tag"); do
    [ "$(herbstclient attr "clients.$wid.visible")" = "true" ] \
        && printf "%s\n" "$wid"
done
