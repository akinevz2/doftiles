#!/usr/bin/env bash
# launch_alacritty — run a command string inside a spawned $TERMINAL.
#
# Pattern ported from the screencast plugin's single-shot terminal
# (development/system screencast_scripts): the command runs under an
# interactive bash inside the spawned terminal, delegated to
# paused-for-dismiss_idle — when the command exits, the wrapper
# reports the exit status and waits for a SINGLE key press ("press any
# key to close"), then exits — and the terminal window closes with it.
# Nothing lingers; while parked, the WM title reads
# "paused-for-dismiss_idle <program that was run>".
#
# Usage: launch_alacritty [--floating] [--urgent] [--no-distract] [-d <dir>] "<command>"
#   TERMINAL overrides the terminal (default: alacritty).
#
#   -d <dir>, --directory <dir>
#                  cd into <dir> first (a leading ~ is expanded). Part of
#                  the tool's interface — the caller no longer writes a
#                  `cd ... &&` prefix into the command string. With no
#                  command string, the command is an interactive login
#                  shell (`bash -il`) in that directory.
#
#                  NEVER `exec bash -l` in the command string: the
#                  wrapper runs `bash -ic "paused-for-dismiss_idle <cmd>"`,
#                  and `exec` replaces the wrapper with a NON-interactive
#                  login bash — it runs ~/.bash_profile and exits, and
#                  the terminal closes with it (no park, no key press).
#
# The switches install a `rule once` before the spawn, so the window
# rules apply to exactly this terminal — scoped by class pattern
# derived from $TERMINAL (a criterion-free once-rule floats the next
# attach of ANY class; maxage bounds the arm):
#   --floating     the terminal window floats when it attaches —
#                  floating is owned ENTIRELY by the once-rule below;
#                  there is NO post-attach machinery (the old
#                  jumpto + hc_center sequence floated the FOCUSED
#                  window — hc_center turns clients.<focus>.floating
#                  on by design — so any focus race floated the
#                  caller's current window instead)
#   --urgent       the terminal raises the urgent hint (tag marker)
#   --no-distract  the terminal does NOT take focus on attach
# Several switches combine into one rule.
#
# Spawned through `herbstclient spawn` (detached, WM-managed) — NOT
# through `hc spawn` rules machinery: that is for graphical apps.

set -euo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY
unset WAYLAND_DISPLAY

hc() { herbstclient "$@"; }

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
launch_alacritty — run a command string inside a spawned $TERMINAL (default:
alacritty, overridden by the TERMINAL environment variable). The
command runs under an interactive bash, delegated to
paused-for-dismiss_idle; when it exits, the wrapper reports the
status and waits for one key press, then the terminal closes. While
parked, the WM title reads "paused-for-dismiss_idle <program>".

Usage: launch_alacritty [--floating] [--urgent] [--no-distract] [-d <dir>] "<command>"

Options:
  --floating     float the terminal once it attaches (rule-owned)
  --urgent       raise the urgent hint (tag marker)
  --no-distract  no focus steal on attach
  -d <dir>, --directory <dir>
                 cd into <dir> first (a leading ~ is expanded); with
                 no command string, run an interactive login shell
                 there. Never `exec bash -l` in the command — the
                 wrapper runs under `bash -ic "paused-for-dismiss_idle
                 <cmd>"`, and `exec` replaces the wrapper with a
                 non-interactive login bash that exits immediately.
  -h, --help     show this help and exit

Takes a command string — not a window-scoped tool.
EOF
        exit 0
        ;;
esac

rule=()
dir=
prev_focus=
NEED_URGENT=
while [ $# -gt 0 ]; do
    case $1 in
        --floating)    rule+=(floating=on) ;;
        --urgent)      rule+=(floating=on); rule+=(focus=off); NEED_URGENT=1 ;;
        --no-distract) rule+=(focus=off) ;;
        -d|--directory)
            [ $# -ge 2 ] || { echo "launch_alacritty: -d requires a directory" >&2; exit 1; }
            dir=$2; shift ;;
        --) shift; break ;;
        *) break ;;
    esac
    shift
done

if [ -n "$dir" ]; then
    # Expand a leading ~ so `cd ~/development/...` works from the caller
    dir="${dir/#\~/$HOME}"
    [ -d "$dir" ] || { echo "launch_alacritty: no such directory: $dir" >&2; exit 1; }
fi

if [ $# -gt 0 ]; then
    USER_CMD="$*"
    if [ -n "$dir" ]; then
        # %q-quoted so the cd survives spaces in the path; the cd is
        # part of the command string, not a separate shell — the park
        # phase reports the exit status of the whole sequence.
        USER_CMD="cd $(printf '%q' "$dir") && $USER_CMD"
    fi
else
    # No command string: the default command is an interactive login
    # shell in <dir> (or the current directory). bash -il stays open
    # until the user exits — the wrapper then parks for one key press.
    [ -n "$dir" ] && USER_CMD="cd $(printf '%q' "$dir") && exec bash -il" || USER_CMD="exec bash -il"
fi

TERMINAL="${TERMINAL:-alacritty}"

# Scope the once-rule to the spawned terminal's WM class: a
# criterion-free `rule once floating=on` arms a float on the NEXT
# attach of ANY class, and any race/failure between rule and spawn
# makes the stray fire on an unrelated window (the reported
# hc_command-splits-a-float bug). Case-tolerate the first char — the
# binary `alacritty` reports WM_CLASS `Alacritty` (repo's [Yy]ad
# idiom). maxage bounds the armed rule: hlwm discards it at the next
# attach, so a failed spawn can never leave the float armed.
termsel="${TERMINAL%% *}"; termclass=$(basename "$termsel")
_first="${termclass:0:1}"; _rest="${termclass:1}"
classpat="[${_first^}${_first,,}]${_rest}"

# Interactive bash so the user's aliases and functions resolve. The
# command string is %q-quoted and handed to paused-for-dismiss_idle
# (one argv = the whole command string): the wrapper runs the command,
# reports the status, restores the
# "paused-for-dismiss_idle <program>" title, and parks for ONE key
# press — the terminal closes naturally with the inner shell. The
# .bashrcx DEBUG title trap prints the WRAPPER invocation into the WM
# title (argv includes the program), never the raw park read.
QUOTED=$(printf '%q' "$USER_CMD")
INNER="paused-for-dismiss_idle $QUOTED"

# The switches install one scoped `rule once` (class-matched via the
# pattern derived above; maxage bounds the arm) BEFORE the spawn, so
# the rules apply to exactly this terminal.
#
# Rule + spawn are wrapped in a lock/unlock block: the rule and the
# spawn are atomic with respect to other WM operations, so the
# once-rule can't fire on an unrelated window that attaches between
# the rule call and the spawn, and the spawn can't be re-ordered
# against another script's rules machinery.
#
# --no-distract: the focus=off rule is a best-effort hint — hlwm can
# still focus the new client on attach (e.g. if the window is on the
# focused tag). To make no-distract airtight, the currently focused
# winid is recorded BEFORE the rule is armed, and focus is restored
# to it before the final unlock — so the spawn appears to happen in
# the background.
# urgent is NOT rule-settable in hlwm 0.9.5 (`rule: Unknown argument
# "urgent=on"` — the whole rule command fails, so the rule was never
# armed and the flag silently did nothing). Instead, --urgent arms
# floating=on + focus=off via the rule, and sets urgent post-attach
# with a detached watcher: the pre-spawn winid list is captured here,
# the watcher polls for the NEW client (max 3s) and sets
# clients.<winid>.urgent=true. focus=off on the same rule means the
# urgent flag never steals focus — the window stays in the background.
if [ -n "$NEED_URGENT" ]; then
    pre_wins=$(herbstutil attr clients. 2>/dev/null | grep -oE '0x[0-9a-f]+' | sort -u)
    (
        for _ in $(seq 1 30); do
            neww=$(herbstutil attr clients. 2>/dev/null | grep -oE '0x[0-9a-f]+' | sort -u | comm -23 - <(printf '%s\n' "$pre_wins") | head -1)
            if [ -n "$neww" ]; then
                hc set_attr clients.${neww%.}.urgent true
                exit 0
            fi
            sleep 0.1
        done
    ) &
fi

hc lock
[ ${#rule[@]} -gt 0 ] && hc rule once class~"$classpat" "${rule[@]}" 2>/dev/null || true

hc spawn "$TERMINAL" -e bash -ic "$INNER"

if [ -n "${rule+x}" ]; then
    # TEMPORARILY DISABLED: focus-back is off while we probe whether
    # the urgent setting itself steals focus; re-enable once checked.
    is_focusoff=0
    for f in "${rule[@]}"; do [ "$f" = focus=off ] && is_focusoff=1; done
    if [ "$is_focusoff" = 1 ] && [ -n "$prev_focus" ] && false; then
        hc jumpto "$prev_focus"
    fi
fi
hc unlock
