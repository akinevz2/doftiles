#!/usr/bin/env bash
# hc_focus — Mod-f: the float-register key, per the final spec:
#
#   a) check tags.focus.floating_focused is false;
#   b) try setting floating_focused true;
#   c) on success:
#   d)   check the focused frame's child count:
#   e)     zero children -> focus the floating window and UN-FLOAT it
#                             into that frame;
#   f)     children      -> terminate successfully (the float stays,
#                             floating layer focused — no stacking);
#   g) if the layer switch FAILED (no float to focus into): float the
#      current window — but only when the focused frame's layout
#      algorithm is "max" (anything else terminates without action).
#      The lift keeps the window's size (hc_center frame + hc_fit_to
#      frame) and enters the float session (floating_focused on).
#   h) when floating_focused was TRUE (a floating window has focus):
#      the frame below is empty -> un-float the focused float into it;
#      the frame below is not empty -> hc_tile "$wid" (it creates the
#      new empty frame, brings the float, and un-floats it there).
#
# No script-level lock: the helpers (polyframes center/fit, hc_tile)
# take and release their own reference-counted WM locks.

set -uo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY

hc() { herbstclient "$@"; }

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
hc_focus — Mod-f: the float-register key (full state machine in the
header below).

Usage: hc_focus

Options:
  -h, --help  show this help and exit

Keybind state machine: always operates on the current focus state —
no window arguments and no -c/-f targeting.
EOF
        exit 0
        ;;
esac

# Pre-scan the first VISIBLE float on the tag (the only candidate the
# floating layer can focus) — a fallback for the focus read that may
# lag right after the layer switch.
tag=$(hc attr tags.focus.name 2>/dev/null || echo "")
float_wid=""
if [ -n "$tag" ]; then
    for c in $(hc list_clients --tag="$tag" 2>/dev/null); do
        if [ "$(hc attr "clients.$c.floating" 2>/dev/null || echo false)" = "true" ] \
           && [ "$(hc attr "clients.$c.minimized" 2>/dev/null || echo false)" = "false" ]; then
            float_wid=$c
            break
        fi
    done
fi

ff=$(hc attr tags.focus.floating_focused 2>/dev/null || echo false)

if [ "$ff" != "true" ]; then
    # a) false; b) try the layer switch
    if hc attr tags.focus.floating_focused on 2>/dev/null; then
        # c) switch succeeded — a float exists and the floating layer
        #    is focused. (d) frame children check:
        fcc=$(hc attr tags.focus.tiling.focused_frame.client_count \
              2>/dev/null || echo 0)
        # The float wid is the PRE-SCANNED one first — clients.focus
        # may lag a settle-tick right after the layer switch.
        wid=$float_wid
        [ -n "$wid" ] || wid=$(hc attr clients.focus.winid 2>/dev/null || true)
        if [ "$fcc" = "0" ]; then
            # e) focus the float and un-float it into the empty frame
            hc chain , attr "clients.$wid.fullscreen" off \
               , attr "clients.$wid.pseudotile" off \
               , attr "clients.$wid.floating" off 2>/dev/null || true
        fi
        # f) otherwise: terminate successfully — the float stays
        #    floating and the floating layer holds focus (no stacking)
        exit 0
    fi

    # g) the switch failed (no float to focus): float the current
    #    window — but ONLY in the max layout.
    algo=$(hc attr tags.focus.tiling.focused_frame.algorithm \
           2>/dev/null || echo "")
    if [ "$algo" = "max" ]; then
        wid=$(hc attr clients.focus.winid 2>/dev/null || echo "")
        if [ -n "$wid" ]; then
            hc chain , attr "clients.$wid.fullscreen" off \
               , attr "clients.$wid.pseudotile" off 2>/dev/null || true
            "$HOME/.local/bin/hc_center" frame || true
            # Frame closing is Mod-f's register (moved from Mod-x's
            # yank): the lifted window vacated its tile — when the
            # focused frame reads zero clients now, close it (removes
            # the split).
            vcc=$(hc attr tags.focus.tiling.focused_frame.client_count \
                  2>/dev/null || echo 1)
            if [ "$vcc" = "0" ]; then
                hc remove 2>/dev/null || true
            fi
            "$HOME/.local/bin/hc_fit_to" frame || true
        fi
    fi
    hc attr tags.focus.tiling.focused_frame.algorithm "max" 2>/dev/null || true
    exit 0
fi

# h) floating_focused TRUE: a floating window has focus. Un-float it
#    into the frame below when that frame is empty; otherwise let
#    hc_tile make the new empty frame and un-float into it.
wid=$(hc attr clients.focus.winid 2>/dev/null || true)
[ -n "$wid" ] || wid=$float_wid
[ -n "$wid" ] || exit 0
fcc=$(hc attr tags.focus.tiling.focused_frame.client_count \
      2>/dev/null || echo 0)
# Direct un-float — NO hc_tile (hc_tile is Mod-x's register; the
# window re-tiles into the frame below whatever it holds).
hc chain , attr "clients.$wid.fullscreen" off \
   , attr "clients.$wid.pseudotile" off \
   , attr "clients.$wid.floating" off 2>/dev/null || true
exit 0
