#!/usr/bin/env bash
# hc_command — shim: the palette lives in herbctl now (the migrated
# implementation, `herbctl command`; bare `herbctl` is the same
# shorthand).
#
#   Return              run the selection silently (detached)
#   Shift-Return        run in a temporary floated terminal
#   Ctrl-Shift-Return   same, with --help appended
#   Tab / Ctrl-Return   Tab-completing a single command: delegates to
#                       `herbctl run` — the single-level completion
#                       palette over the command's help (Shift-Return
#                       descends a subcommand, Return accepts)
#   Escape              cancel
exec herbctl run "$@"
