#!/usr/bin/env bash
# hc_command — rofi command palette over the hlwm/shell helper scripts.
#
# The PREFIXES array below declares which executable name prefixes are
# listed; every matching executable on PATH shows up in a rofi dmenu
# styled like the app launcher (the dedicated command.rasi
# clone — launcher.rasi's auto-features/icons caused stalls).
# herbctl is PINNED at the top of the list (below): the WM-controller
# CLI heads the palette — Tab-complete into it to append subcommands
# and flags before the real submit.
#
# Selection handling:
#   Shift-Return (kb-custom-1)  -> launch_alacritty "<selection>" — runs
#                                  it in a temporary terminal (see
#                                  launch_alacritty)
#   Return                      -> run silently: detached, output
#                                  discarded (deliberately NOT via
#                                  `hc spawn` — that applies window
#                                  rules and is for graphical apps)
#   Escape                      -> cancelled, nothing runs

PREFIXES=("rofi_" "hc_" "hlwm")

set -euo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY
unset WAYLAND_DISPLAY

LOG=${POLYFRAMES_LOG:-/tmp/polyframes.log}
# Diagnostic toggle: POLYFRAMES_ROFI_LOG=/path makes the rofi call write
# its internal [Timings]/[Helpers] log there (rofi -log). Empty = off.
ROFI_LOG=${POLYFRAMES_ROFI_LOG:-}

# --- usage ----------------------------------------------------------------
# Ctrl-Shift-Return in the palette appends --help to the selection —
# hc_command itself must answer that here instead of opening a second
# palette inside the spawned terminal.
usage() {
    cat <<'EOF'
hc_command — rofi command palette over the helper scripts.
herbctl first, then every PATH executable starting with: rofi_, hc_, hlwm

Keymap:
  Return              run the selection silently (detached)
  Shift-Return        run in a temporary floated terminal
                      (launch_alacritty)
  Ctrl-Shift-Return   same, with --help appended to the command
  Ctrl-Return, Tab    complete the selection into the input
  Escape              cancel
EOF
}
case "${1:-}" in
    "") : ;;
    -h|--help) usage; exit 0 ;;
    *)
        echo "hc_command: unexpected argument '$1' — hc_command takes no arguments" >&2
        usage >&2
        exit 1
        ;;
esac

# --- single instance -----------------------------------------------------
# A held lock means another palette is already up: key repeat or a
# double-press would otherwise stack two rofi windows.
exec 9>"${TMPDIR:-/tmp}/hc_command.lock"
flock -n 9 || exit 0

# --- herbctl pinned first -------------------------------------------------
# The WM-controller CLI heads the palette (Tab lets arguments be
# appended before submit; Shift-Return opens its help in a terminal).
# Listed only when it resolves — fail-soft like everything here. The
# bare entry with plain Return is a harmless no-op (herbctl prints its
# help and exits; output is discarded).
list_herbctl() {
    if command -v herbctl >/dev/null 2>&1; then
        printf 'herbctl\n'
    fi
}

# --- enumerate PATH executables with the declared prefixes --------------
# ONE find pass over all PATH dirs (-L: the .local/bin entries are
# symlinks into the dots repo) — the old per-file basename loop forked
# thousands of times and was the reason the palette took ages to open.
list_commands() {
    local expr=() first=1 p
    for p in "${PREFIXES[@]}"; do
        if [ "$first" = 1 ]; then
            expr=( \( -name "$p*" )
            first=0
        else
            expr+=( -o -name "$p*" )
        fi
    done
    expr+=( \) )
    # $HOME/.local/bin is ALWAYS scanned (prepended, then the PATH
    # dirs, deduped): the WM spawn env may lack it (systemd default
    # PATH), which left the palette permanently empty.
    #
    # PATH is split on colon ONLY (IFS=:): entries contain spaces
    # ("Program Files"), and the old ${PATH//:/ } word-split shredded
    # them into find errors.
    #
    # /mnt/* (the WSL interop Windows dirs systemd puts on every PATH)
    # are SKIPPED: they are 9P-mounted, enumerating them stalls find
    # for tens of seconds, and rofi_*/hc_*/hlwm* helpers can never live
    # there. sort buffers until EOF, so one slow dir starves the whole
    # pipeline — the palette opened showing only the pinned herbctl
    # while find crawled /mnt/c (and every new Windows PATH entry made
    # the crawl longer — this "broke again" twice).
    local -a scandirs=()
    local dir IFS=:
    for dir in $PATH; do
        [ -n "$dir" ] || continue      # empty element: find would scan CWD
        case $dir in /mnt/*) continue ;; esac
        scandirs+=("$dir")
    done
    local -a alldirs=()
    mapfile -t alldirs < <(printf '%s\n' "$HOME/.local/bin" "${scandirs[@]}" | sort -u)
    find -L "${alldirs[@]}" -maxdepth 1 -type f -executable \
        "${expr[@]}" -printf '%f\n' 2>/dev/null | sort -u 2>/dev/null
    # sort's stderr is discarded: when rofi exits early (Tab-complete,
    # cancel) the pipe closes under a still-running sort — GNU sort
    # traps the SIGPIPE and prints 'write failed: Standard output:
    # Broken pipe', which hlwm's spawn surfaced as a dunst error. The
    # enumeration side's fate is deliberately not counted (see below).
}

# --- the palette ---------------------------------------------------------
# Keymap (rofi 2.0):
#   Return              accept entry (or typed text) -> silent run
#   Shift-Return        kb-custom-1                  -> launch_alacritty
#                                                    --floating
#   Ctrl-Shift-Return   kb-custom-2                  -> launch_alacritty
#                                                    + --help
#   Tab, Ctrl-Return    kb-custom-3/4                -> COMPLETE: re-open
#                       the palette with the input pre-filled from the
#                       highlighted entry, so arguments can be appended
#                       before the real submit.
#   (dmenu has NO inline completion: kb-mode-complete is a mode-SWITCH
#   action that cancels in dmenu — verified empirically. The re-open
#   with -filter is the completion.)
# The defaults occupying those keys (kb-accept-custom on Ctrl+Return,
# kb-accept-custom-alt on Ctrl+Shift+Return, kb-element-next on Tab)
# are unbound first; arrows still move the selection.
# pipefail is disabled for THIS pipeline: its meaningful exit is rofi's
# (0 accept / 10-13 custom / 1 cancel) — the enumeration side may die
# with SIGPIPE when rofi stops reading early, and that must not count.
filter=""
while :; do
    rc=0
    # -no-auto-select: belt-and-braces — the dedicated command.rasi
    # carries no auto-select, but the palette must NEVER fire when a
    # filter happens to leave a single entry; the user confirms
    # explicitly.
    # The negation char must be a character that can never be typed:
    # an empty string disables the option but makes rofi log 'Failed
    # to parse character string: ""' on every start.
    sel=$(set +o pipefail; { list_herbctl; list_commands; } | rofi -dmenu -i -p command \
            -theme "$HOME/.config/rofi/command.rasi" \
            -no-show-icons \
            -no-auto-select \
            -matching regex \
            -matching-negate-char "$(printf '\001')" \
            ${filter:+-filter "$filter"} \
            -kb-accept-alt "" \
            -kb-accept-custom "" \
            -kb-accept-custom-alt "" \
            -kb-element-next "" \
            -kb-custom-1 "Shift+Return" \
            -kb-custom-2 "Control+Shift+Return" \
            -kb-custom-3 "Tab" \
            -kb-custom-4 "Control+Return" \
            ${ROFI_LOG:+-log "$ROFI_LOG"}) || rc=$?

    [ -n "${sel:-}" ] || exit 0

    case $rc in
        12|13)  # Tab / Ctrl-Return: complete into the input and re-open
            filter=$sel
            ;;
        10)  # Shift-Return: run in the temporary terminal — floated, so
             # the palette's command output never disturbs the layout
            exec launch_alacritty --floating "$sel"
            ;;
        11)  # Ctrl-Shift-Return: same, with --help appended
            exec launch_alacritty --floating "$sel --help"
            ;;
        0)   # Return: run silently, detached, output discarded
            printf 'hc_command: %s\n' "$sel" >> "$LOG" 2>/dev/null || true
            setsid bash -c "$sel" </dev/null >/dev/null 2>&1 &
            exit 0
            ;;
        *)   # cancelled
            exit 0
            ;;
    esac
done
