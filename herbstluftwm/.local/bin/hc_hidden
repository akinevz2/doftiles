#!/bin/sh
# hc_hidden — SHIM. The minimized-windows picker moved into the herbctl
# project (~/dots/herbctl, compiled Bun/bunli binary managed there);
# kept as a named shim for the $Mod-g keybind (the $Mod-c menu lists
# every hc_* on PATH).
#
# Usage:
#   hc_hidden [args...]  minimized-windows picker (herbctl hidden
#                        passthrough); exits non-zero when the windows
#                        fallback is canceled, for shell chaining
#
# Takes no options itself; -h/--help pass through to herbctl's native
# help (bunli). Keep this shim synced with `herbctl hidden --help`.
exec "$HOME/.local/bin/herbctl" hidden "$@"
