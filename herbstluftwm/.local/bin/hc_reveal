#!/bin/bash
# hc_reveal — cycle to the NEXT window (scroll up), skipping invisible
# ones. Companion of hc_collapse. Not window-scoped: it cycles the
# tag's window stack, so it takes no target options.

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
hc_reveal — cycle to the NEXT window (scroll up), skipping invisible ones.

Usage: hc_reveal

Options:
  -h, --help  show this help and exit

Not window-scoped: cycles the tag's window stack (herbstclient cycle).
EOF
        exit 0
        ;;
esac

herbstclient cycle all --skip-invisible +1
