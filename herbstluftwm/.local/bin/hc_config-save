#!/usr/bin/env bash
# hc_config-save — working-tree save routine for the dots repo.
#
# Tiles an alacritty window (via launch_alacritty in plain mode — no
# floating, no focus-off), in which the routine runs:
#
#   1. Pulls the dots repo and each owned submodule (via make update /
#      submodule update --remote), then checks for any uncommitted changes.
#   2. For each repo that has changes, shows the diff, prompts for a
#      commit message, commits, and pushes.
#
# After the final push the routine exits — and the terminal parks in
# paused-for-dismiss_idle, clearable with a SINGLE key press.
#
# Usage:
#   hc_config-save            spawn the tiling window and run the routine
#   hc_config-save --run      run the routine in the CURRENT terminal
#                             (the spawn mode launches this)
#   hc_config-save -h/--help  show this help

set -euo pipefail

DOTS="${DOTS:-$HOME/dots}"
SELF="${BASH_SOURCE[0]}"

usage() {
	sed -n '2,30p' "$SELF" | sed 's/^# \{0,1\}//'
	exit 0
}

case "${1:-}" in
	-h|--help) usage ;;
	--run) shift ;;
	"")
		# Spawn mode: tiling window (no --floating / --urgent /
		# --no-distract flags), running this script in --run mode.
		exec launch_alacritty "$SELF --run"
		;;
	*)
		echo "hc_config-save: unknown argument: $1 (try -h)" >&2
		exit 1
		;;
esac

# ---- the routine (--run) ----
cd "$DOTS"

declare -a UPDATED=()

msg() { printf '\n%s\n' "$*"; }
ok() { green "SAVE: ${1}"; }     # shell helpers kept in ~/.local/bin
warn() { yellow "SAVE: ${1}"; }

# ---- helper: pull_then_commit_push <dir> <label> ----
_pull_then_commit_push() {
	local dir="$1" label="$2"
	local pull_result pull_output

	# Pull from upstream (dots itself or submodule)
	if [ "$dir" = "$DOTS" ]; then
		# Pull via the dots repo's make update (includes submodule updates)
		pull_result="$(
			(cd "$dir" && make update 2>&1) || { echo "FAILED"; }
		)"
		if [ "$pull_result" = "FAILED" ]; then
			yellow "SAVE: pull failed for $label — aborting"
			printf '%s\n' "$pull_result"
			exit 1
		fi
		# make update can emit output; we'll capture it for completeness
		if [ -n "$pull_result" ]; then
			msg "[$label] pull output (last 5 lines):"
			printf '%s\n' "$pull_result" | tail -5
		fi
	else
		# Pull submodule directly
		git -C "$dir" submodule update --remote >/dev/null 2>&1
	fi

	# Now check for uncommitted changes
	if [ -z "$(git -C "$dir" status --porcelain)" ]; then
		msg "[$label] clean after pull — nothing to commit"
		return 0
	fi

	msg "[$label] uncommitted changes after pull:"
	msg "----------------------------------------------------------------"
	(cd "$dir" && git status --short && GIT_PAGER=cat git diff HEAD)
	msg "----------------------------------------------------------------"

	local answer msg2
	read -r -p "[$label] commit message (empty = SKIP this one, '!' = ABORT all): " answer || answer=""
	case "$answer" in
		"") warn "[$label] skipped (no message)"; return 0 ;;
		'!') return 2 ;;
	esac
	msg2="$answer"

	(cd "$dir" \
		&& git add -A \
		&& git commit -m "$msg2" \
		&& git push origin "$(git -C "$dir" branch --show-current)") \
		&& { UPDATED+=("$label"); ok "[$label] committed + pushed"; }
	return 0
}

# 1 — every submodule of dots, dynamically enumerated
while IFS= read -r sub; do
	_pull_then_commit_push "$DOTS/$sub" "submodule $sub" || true
done < <(git -C "$DOTS" config --file .gitmodules --get-regexp 'submodule\..*\.path' \
	| cut -d' ' -f2)

# 2 — the dots super-repo itself (submodule pointer bumps included)
_pull_then_commit_push "$DOTS" "dots" || { rc=$?; [ "${rc:-0}" = 0 ] || { warn "aborted"; exit 0; }; }

msg "SAVE: done. Updated+pushed: ${#UPDATED[@]} — ${UPDATED[*]:-none}"
exit 0
