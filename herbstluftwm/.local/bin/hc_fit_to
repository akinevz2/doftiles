#!/bin/sh
# hc_fit_to — SHIM. Constraint pass for the focused floating client
# (or `--wid <wid>`): shrink it when bigger than the target rectangle,
# nudge it back inside when dragged/resized past the edges — deco-aware
# (the full outline is kept inside), size-preserving otherwise.
#
# Usage:
#   hc_fit_to [monitor|frame]  target to fit within: the MONITOR's
#                              work area (default) or the focused
#                              frame's content geometry
#   hc_fit_to --target frame   same via flag (-t short)
#   hc_fit_to --wid 0x…        fit THAT window (-w short)
#
# Companion to hc_center: post-center verification for Mod-f lifts and
# yanks (a centered window is inside the frame when the frame is
# on-screen; the monitor pass is the screen-bounds safety net).
#
# -h/--help pass through to polyframes' native help (bunli); keep this
# shim's arg surface synced with `polyframes fit --help`.
exec "$HOME/.local/bin/polyframes" fit "$@"
