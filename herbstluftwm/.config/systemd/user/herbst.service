# ~/.config/systemd/user/herbst.service
[Unit]
Description=herbstluftwm window manager (inside VcXsrv)
# Headless guard: the WM never starts without a reachable X server —
# gating is enforced by Requires=check-x-server (the bounded wait-for-X
# poll that used to be an ExecStartPre here lives THERE now, as the
# generalized detectDisplay probe retry loop).
After=check-x-server.service
Requires=check-x-server.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# DISPLAY is inherited from the user manager environment, set by
# check-x-server (on-deploy detect-server --persist-to-systemd) — no
# hardcoded display here.
# WSLg exposes a Wayland socket (wayland-0) that dual-backend apps like
# rofi 2.0 autodetect; force the whole WM session onto X11/VcXsrv.
Environment=XDG_SESSION_TYPE=x11
UnsetEnvironment=WAYLAND_DISPLAY
ExecStart=/usr/bin/herbstluftwm
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
# PROVIDES x-window-manager.service (alias pattern, see
# check-x-server.service): the enabled WM installs the alias and any
# consumer may require the symbolic name instead of herbst.service.
Alias=x-window-manager.service
