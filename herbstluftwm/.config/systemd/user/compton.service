[Unit]
Description=compton compositor (inside VcXsrv)
After=herbst.service
Requires=basic.target
BindsTo=herbst.service

[Service]
# profile override: a provision-written env file wins over the
# hardcoded DISPLAY (absent file = the WSL default below stands)
EnvironmentFile=-%h/.config/doftiles/env
Type=simple
Environment=DISPLAY=localhost:0.0
# WSLg exposes a Wayland socket (wayland-0) that dual-backend apps like
# rofi 2.0 autodetect; force the whole WM session onto X11/VcXsrv.
Environment=XDG_SESSION_TYPE=x11
UnsetEnvironment=WAYLAND_DISPLAY
# The compositor is not session-critical: if it crashes on its own
# (e.g. a VcXsrv hiccup), bring it straight back. A BindsTo stop is
# clean and is NOT restarted, so quitting the WM still takes compton
# down with it (that binding is intentional).
Restart=on-failure
RestartSec=1
ExecStart=/usr/bin/compton

[Install]
WantedBy=default.target
