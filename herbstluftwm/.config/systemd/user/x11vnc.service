[Unit]
Description=x11vnc on :0
After=xvfb.service
Requires=xvfb.service

[Service]
# profile override: a provision-written env file wins over the
# hardcoded DISPLAY (absent file = the WSL default below stands)
EnvironmentFile=-%h/.config/doftiles/env
Type=simple
Environment=DISPLAY=localhost:0.0
# WSLg exposes a Wayland socket (wayland-0) that dual-backend apps like
# rofi 2.0 autodetect; force the whole WM session onto X11/VcXsrv.
Environment=XDG_SESSION_TYPE=x11
UnsetEnvironment=WAYLAND_DISPLAY
ExecStart=/usr/bin/x11vnc -display localhost:0.0 -nopw -forever -shared -listen localhost -rfbport 5900 -noshm
Restart=on-failure

[Install]
WantedBy=default.target
