#!/usr/bin/env bash

unset WAYLAND_DISPLAY
source ${HOME}/.exports

export local=${HOME}/.local/bin

herb() {
    herbstclient "$@"
}

keyreg() {
    herb keybind "$@"
}


### MODS ###
Mod=Mod1            # Alt — primary mod inside Xephyr
ModShift=Mod1-Shift
ModCtrl=Mod1-Control

### SIZES ###
# resizestep: frame resizes (RESIZING below + the nav corner binds);
# nudgestep: fine window resizes. Both are FRACTIONS of the frame/
# monitor dimension (hlwm resize DIRECTION [FRACTIONDELTA]; for a
# focused FLOAT the delta is ignored — it grows toward the next edge).
# resize takes NO --level flag (that's focus/shift only).
resizestep=0.02
nudgestep=0.01

### REGISTER RELOAD ###
herb emit_hook reload
herb set_layout max
herb keyunbind --all
# kill stale panel processes from a previous session; the polywins
# hook listener exits with polybar (it is a child process)
herb spawn ${HOME}/.local/bin/polyctl reload

### SPAWN ENVIRONMENT ###
# hlwm's spawn env inherits the systemd default PATH, which lacks the
# nvm toolchain (herbstutil lives there and the hc_* helpers read WM
# state through it). Push the user node toolchain into the WM's spawn
# env explicitly — idempotent, nvm-version agnostic.
for _nvm_bin in "$HOME"/.config/nvm/versions/node/*/bin; do
    if [ -x "$_nvm_bin/herbstutil" ] && ! herbstclient getenv PATH | grep -qF "$_nvm_bin"; then
        herb setenv PATH "$_nvm_bin:$(herbstclient getenv PATH)"
    fi
done
# ~/.local/bin must be in the WM spawn env too: hc_command enumerates
# the PATH helpers through it, and palette selections run via
# `setsid bash -c` resolving names through PATH. The systemd default
# PATH lacks it.
if ! herbstclient getenv PATH | tr ':' '\n' | grep -qxF "$HOME/.local/bin"; then
    herb setenv PATH "$HOME/.local/bin:$(herbstclient getenv PATH)"
fi

# Software-GL vars (wsl.sh exports) only apply to login shells; apps
# spawned BY the WM inherit the WM's env, which lacks them. On WSL the
# /dev/dri nodes are vgem (no real GPU), so hardware GL attempts fail —
# WebKit compositing crashes (luakit) and Firefox renders dead windows.
# Push the software-GL flags into the WM spawn env (same pattern as the
# PATH push above). Applied live on reload: setenv lands in the running
# WM's env, so spawned apps inherit without a full WM restart.
for _var in LIBGL_ALWAYS_INDIRECT LIBGL_ALWAYS_SOFTWARE; do
    if [ -n "${!_var:-}" ]; then
        herb setenv "$_var" "${!_var}"
    fi
done

### KEYBINDS — nav / focus / floating ###
# folded back into this master autostart (2026-10): the keys.d/
# stow-merge loop is gone; these blocks were keys.d/{nav,focus,floating}.sh

# ==== herbst_nav — navigation keybinds (window/tag focus, cycling, tags) ====

# was $ModAlt-Tab → now Alt+Shift+`
# ModCtrl-c: the rotate-tree complement (ModCtrl-r) — --smart reverses
# the rotate condition: rotate trees >= 3 frames (the exact complement
# of the auto-mode <3 threshold), cycle BACKWARDS below it (frames
# when >1, windows on a single frame). herbctl >= 1.3.0.
keyreg $ModCtrl-c spawn ~/.local/bin/herbctl rotate-tree --smart

# hc_command — the rofi command palette over the helper scripts
keyreg $Mod-c       spawn ~/.local/bin/hc_command

# ==== notifications — dunst ====
# The old dunst_keybinds fragment is folded here (across 2026 as an
# unsourced leftover since the keys.d merge — grave bindings live here
# again). Also: mod-n / modshift-n for history, mod-comma/mod-period
# for dismiss/action on the displayed stack.
# dunst history is LIFO: repeated mod-n pops go older — the "previous
# notification" navigation. There is no dunstctl API to detect whether
# a history popup is open, so no conditional rebinding is possible.
keyreg $Mod-grave       spawn dunstctl history-pop
keyreg $Mod-numbersign  spawn dunstctl close
keyreg $ModCtrl-grave   spawn dunstctl context
keyreg Ctrl-Shift-space spawn dunstctl close-all
keyreg Ctrl-Shift-grave spawn pause_notification_toggle

# notification helpers live in ~/.local/bin (repo pattern: one hc_*
# wrapper per dunst verb — keybind registration still goes through
# hlwm's spawn, which is the only mechanism it offers for externals)
keyreg $Mod-n      spawn ~/.local/bin/hc_dunst-pop

# paced pop of the whole history (via dunstctl history, id by id)
keyreg $ModShift-n spawn ~/.local/bin/hc_dunst-pop-all

# hc_dismiss-notifs — dismiss ALL notifications (errors et al.)
keyreg $ModCtrl-d   spawn ~/.local/bin/hc_dismiss-notifs

# mod-comma: dismiss the current (top) notification
keyreg $Mod-comma   spawn ~/.local/bin/hc_dunst-dismiss
# mod-period: trigger the selected notification's action (default action
# when one exists; the context menu for multiple/none)
keyreg $Mod-period  spawn ~/.local/bin/hc_dunst-action

# hc_time-toggle — the glance clock (dclock): a 7-segment digital clock
# on the floating layer, bottom-right, focus-stolen-free. Spawn on
# first press, terminate on the next.
keyreg $Mod-z spawn ~/.local/bin/hc_time-toggle

keyreg $Mod-w spawn ~/.local/bin/herbctl get-forward

# ModShift-w: mirror of Mod-w's cycle -1 register — first tries shifting
# the window up (#window leaves the frame, --level=all); when there is
# nothing above, with >1 window in the focused frame it cycles -1,
# otherwise it tries cycle_frame, then falls through to rotating the
# frame tree.
keyreg $ModShift-w spawn ~/.local/bin/herbctl shift-up

keyreg $ModShift-s spawn ~/.local/bin/herbctl shift-down

keyreg $ModShift-d spawn ~/.local/bin/herbctl get-dedeck

keyreg $Mod-d spawn ~/.local/bin/herbctl get-deck

# tag switcher
keyreg $Mod-t               spawn ~/.local/bin/polyframes tags

# FOCUS — hjkl stays within visible clients; arrows traverse all
# frames/layers (levels exchanged: hjkl was all, arrows was visible;
# directions unchanged on both sets)
keyreg $Mod-h                   focus --level=all left

keyreg $Mod-j                   focus --level=all down

keyreg $Mod-k                   focus --level=all up

keyreg $Mod-l                   focus --level=all right

keyreg $Mod-Left                or . focus left . focus --level=all left

keyreg $Mod-Down                or . focus down . focus --level=all down

keyreg $Mod-Up                  or . focus up . focus --level=all up

keyreg $Mod-Right               or . focus right . focus --level=all right

# SHIFT windows — Alt+Ctrl+arrows and Alt+Ctrl+hjkl
# (hjkl slot freed up by dropping the old focus aliases)
keyreg $ModCtrl-h               shift --level=all left

keyreg $ModCtrl-j               shift --level=all down

keyreg $ModCtrl-k               shift --level=all up

keyreg $ModCtrl-l               shift --level=all right

keyreg $ModCtrl-Left            or . shift --level=frame left . shift --level=all left

keyreg $ModCtrl-Down            or . shift --level=frame down . shift --level=all down

keyreg $ModCtrl-Up              or . shift --level=frame up . shift --level=all up

keyreg $ModCtrl-Right           or . shift --level=frame right . shift --level=all right

# window cycling was mod-comma/period — now mod-bracketleft/right
keyreg $Mod-bracketleft     cycle_all --skip-invisible -1
keyreg $Mod-bracketright    cycle_all --skip-invisible +1

# workspace (tag) switching — the old mod-brackets — moved to shift
keyreg $ModShift-bracketleft    use_index -1 --skip-visible
keyreg $ModShift-bracketright   use_index +1 --skip-visible

# move the focused window to the previous/next tag by index
# (move_index takes the same -1/+1 relative index as use_index)
keyreg $ModCtrl-bracketleft     move_index -1 --skip-visible
keyreg $ModCtrl-bracketright    move_index +1 --skip-visible

keyreg $ModCtrl-comma       resize left +$resizestep

keyreg $ModCtrl-period      resize right +$resizestep

keyreg $ModShift-comma      shift left

keyreg $ModShift-period     shift right

# ==== herbst_focus — the focus/peek keybinds (mod-s grid, frame cycling) ====

# ModShift-r: rotate the tree (>3 frames) or cycle frames forward; on
# a single frame it cycles windows in the opposite direction of
# ModShift-w.
keyreg $ModCtrl-r spawn ~/.local/bin/herbctl rotate-tree

keyreg $Mod-e spawn ~/.local/bin/herbctl explode-frame

# cycle; was $Mod-s / $ModShift-s
# zoom/peek grid — focuses the frame below first; when there is none,
# falls back to the window cycle / pseudotile toggle
# The floating branch: `attr tags.focus.floating_focused true` focuses
# the floating layer AND doubles as the "are there (non-minimized)
# floats" conditional — it fails on an empty floating layer, falling
# through to the alternatives (the failure is quieted in the
# hc_send-error-daemon's QUIET_MATCH).
keyreg $Mod-s spawn ~/.local/bin/herbctl get-south

# ==== herbst_floating — the float registers (mod-f / mod-x / mod-ctrl-f) ====

# Mod-q: close the focused window (floats close like any other — the
# un-float check was removed), with a lone-window frame removed
# afterwards.
keyreg $Mod-q spawn ~/.local/bin/herbctl close-window

# peek floats; when the floating layer is empty (or every float is
# hidden), offer the hidden windows via rofi; rofi_hidden exits
# non-zero when nothing is hidden, so fall back to the previous tag.
# Wrapped in sh -c because "spawn" itself is always truthy — the or
# chain has to see the script's exit code.
keyreg $Mod-g               spawn ~/.local/bin/polyframes hidden

# tile helper: (re)tiles the focused frame's clients (polyframes tile)
keyreg $ModCtrl-t           spawn ~/.local/bin/polyframes tile

# quick float toggle for the focused window: floated windows are
# centered inside their focused frame (visual float indicator);
# pressing again focuses the tiling layer — no un-float (un-float
# happens from the tiling side: an empty focused frame pulls the
# first float in)
keyreg $Mod-f               spawn ~/.local/bin/hc_focus

# zoom: 3-state toggle for the focused window — float the focused
# window if tiled (a), maximize onto a <tag>-max tag if floating (b),
# restore via hc_unmaximize if maximized (c) (hc_zoom)
keyreg $ModCtrl-f          spawn ~/.local/bin/hc_zoom

keyreg $ModShift-f spawn ~/.local/bin/herbctl fullscreen-toggle

# x-family final layout: Mod-x runs hc_floatx (the layer-focus
# toggle / yanker: from tiling, focus a float, un-float into an empty
# frame, or yank; from a focused float — UN-FLOAT into the frame
# below). ModCtrl-x runs the same script in `corner` mode: on an
# ALREADY-FLOATING window it resizes the float to the top-left
# quadrant of the monitor and pins it there (polyframes corner,
# v2.3.1); from tiling it delegates to herbctl float-unfocus (the
# companion-float / recall machine). ModShift-x keeps use_previous.
keyreg $Mod-x               spawn ~/.local/bin/hc_floatx
keyreg $ModShift-x          use_previous
keyreg $ModCtrl-x          spawn ~/.local/bin/hc_minimize

keyreg $ModCtrl-z           spawn ~/.local/bin/hc_floatx corner



# LAUNCHERS
# TERMINAL="gnome-terminal --zoom 1.5"
ROFITHEME=${HOME}/.config/rofi/launcher.rasi
APPLAUNCHER="${HOME}/.local/bin/polyframes launch"
SCREENSHOTTER="scrot"
APPSWITCHER="rofi -modi windowcd -show windowcd -theme ${ROFITHEME}"

# terminal
keyreg $Mod-Return          spawn $TERMINAL
keyreg $ModShift-Return     spawn ~/.local/bin/hc_split-launch $APPLAUNCHER

keyreg $ModCtrl-Return      spawn $APPLAUNCHER
# shift-t opens a second frame only when the focused one already holds
# a window; an empty frame stays as is and the terminal opens into it
keyreg $ModShift-t          chain , spawn ~/.local/bin/herbctl new-frame , spawn $TERMINAL

# applauncher
keyreg $ModCtrl-w           or . and , compare tags.focus.curframe_wcount gt 0 , spawn $APPSWITCHER . close_or_remove         # was Mod-Tab

# CLOSE OR QUIT WM
# ModShift-q: close ONLY on the tiling layer (floats untouched); the
# frame is never removed.
keyreg $ModShift-q spawn ~/.local/bin/herbctl close-tiling
keyreg $ModCtrl-q           or . and , attr clients.focus , spawn xkill . close_and_remove
keyreg $ModShift-r          reload

# WINDOWING
keyreg $Mod-a spawn ~/.local/bin/herbctl focus-frame-left
keyreg $ModShift-a           or . and , compare tags.focus.curframe_wcount gt 0 , chain ! split left ! focus left . spawn $APPLAUNCHER           # was Mod-Tab
# ModShift-b: open a split below (unconditional split bottom).
#
# ModCtrl-b: focus the frame below; when there is none, split below
# and call hc_tile (the polyframes tile register).
keyreg $ModShift-b spawn ~/.local/bin/herbctl split-bottom-focus
keyreg $ModCtrl-b spawn ~/.local/bin/herbctl shift-down

keyreg $ModCtrl-a spawn ~/.local/bin/herbctl shift-left
keyreg $ModCtrl-e spawn ~/.local/bin/herbctl shift-right
# split-auto + the tile register (hc_tile is a polyframes spawn,
# so this stays a chain — see the herbctl exclusion list)
keyreg $ModShift-e           chain . split auto . spawn $local/hc_tile

















# split into direction
keyreg $Mod-v spawn ~/.local/bin/herbctl split-right-cycle
keyreg $Mod-b spawn ~/.local/bin/herbctl focus-frame-down
keyreg $ModCtrl-v spawn ~/.local/bin/herbctl split-right-focus



### TAGS ###
herb set swap_monitors_to_get_tag 0

tag_names=( work term browser logs task default )
tag_keys=( {1..9} 0 )

herb rename default "${tag_names[0]}" || true
herb add term
herb add config
herb add logs
herb add task
herb add browser
herb add discord
for i in "${!tag_keys[@]}" ; do
    if ! [ -z $name ] ; then
        herb add "${tag_names[$i]}"
    fi
    key="${tag_keys[$i]}"
    if [ -n "$key" ] ; then
        keyreg "$Mod-$key" use_index "$i"
        keyreg "$ModCtrl-$key" move_index "$i"
    fi
done

# mouse
herb mouseunbind --all
herb mousebind $Mod-Button1 move
herb mousebind $Mod-Button2 zoom
herb mousebind $Mod-Button3 resize
# scroll wheel: cycle windows within current frame (up = previous, down = next)
herb mousebind $Mod-Button4 call cycle +1
herb mousebind $Mod-Button5 call cycle -1



# RESIZING

keyreg $ModShift-h          resize left +$nudgestep
keyreg $ModShift-j          resize down +$nudgestep
keyreg $ModShift-k          resize up +$nudgestep
keyreg $ModShift-l          resize right +$nudgestep
keyreg $ModShift-Left       resize left +$resizestep
keyreg $ModShift-Down       resize down +$resizestep
keyreg $ModShift-Up         resize up +$resizestep
keyreg $ModShift-Right      resize right +$resizestep

herb set default_direction_external_only 1




# THEME — colors/decorations/wallpaper moved to the sibling "theme"
# script: it applies only on a fresh WM start (guarded by a persistent
# hlwm env flag) and exits immediately on reloads, so reloading this
# autostart never re-sets decorations (no theme jitter).
"$HOME/.local/bin/reload_theme" -f

herb set snap_distance 10
herb set snap_gap 5

herb set mouse_recenter_gap 5
herb set focus_follows_mouse off
herb set focus_stealing_prevention on
herb set focus_crosses_monitor_boundaries off
herb set gapless_grid on
herb set pseudotile_center_threshold 25
herb set update_dragged_clients off

# RULES
herb unrule -F
herb rule focus=on
herb rule windowtype~'_NET_WM_WINDOW_TYPE_(DIALOG|UTILITY|SPLASH)' floating=on
herb rule class~'[Yy]ad' floating=on
herb rule windowtype='_NET_WM_WINDOW_TYPE_DIALOG' focus=on
herb rule windowtype~'_NET_WM_WINDOW_TYPE_(NOTIFICATION|DOCK|DESKTOP)' manage=off focus=off

herb rule class='pavucontrol' tag=volume
herb rule class='spotify' tag=music
herb rule class='firefox' windowtype='_NET_WM_WINDOW_TYPE_NORMAL' tag=browser
herb rule title='Task Manager' tag=task
herb rule title='Config Manager' tag=config

herb set default_frame_layout grid

# unlock, just to be sure
herb unlock

xmodmap -e "keycode 20 = minus underscore backslash bar backslash bar"

# RELOAD DETECTION HOOK
# Check if this is a fresh start or a reload
# If reload detected, notify user via dunst to show session reloaded
STATUS=$(hc_reload_hook)
if [ "$STATUS" = "reload" ]; then
    # Reload detected — wm survived, autostart re-running
    # Send notification via notify-send
    notify-send -a "herbstluftwm" -u normal -t 2000 "herbstluftwm reloaded" "autostart completed"
fi
