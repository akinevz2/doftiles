/*
 * window-switcher.rasi
 *
 * Custom rofi theme for the window switcher (script-mode rofi_windows),
 * attached to the polybar. Specializes hlwm.rasi:
 *   - window inner padding and inner outline (hlwm inner_color)
 *   - stateful rows styled by the caller (rofi_windows row options):
 *     default (fg-alt)   - visible: on the focused tag, not minimized
 *     active  (accent)   - unminimized: running on another tag
 *     urgent  (dimmed)   - minimized: hidden
 */

@import "hlwm.rasi"

configuration {
	columns: 1;
	location: 0;
	display-window: "Windows";
	window-format: "{t}";
}

window {
	padding: 5px;
}

/* rofi's default placeholder would be blank — keep it blank, the
   switcher list is prefiltered */
entry {
	placeholder: "";
}

listview {
	fixed-columns: false;
	flow: vertical;
	/* vertical list: one entry per line, sized to entry count.
	   lines is overridden per-call via -l (number of entries). */
	background-color: @transparent;
	padding: 6px 10px 0px 10px;
	border: 0 0 2px 0;
	border-color: @transparent;
	children: [ element-text ];
}

/* default rows: dark bg, light gray text — the WHITE highlight is
   reserved for the selected (keyboard/mouse-hover) row */
element {
	background-color: @bg;
	padding: 5px;
}

element selected {
	background-color: @bg;
	text-color: #feef69;
	border-color: @accent;
}
