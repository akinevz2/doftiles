/*
 * window-switcher.rasi
 *
 * Custom rofi theme for the window switcher (script-mode rofi_windows),
 * attached to the polybar and matching the herbstluftwm theme:
 *   - background   #333333 (theme.background_color)
 *   - panel/bg     #222222 (polybar module background)
 *   - normal/blur  #666    (theme.normal.color, frame_border_normal_color)
 *   - accent       #feef69 (theme.active.color, polybar active underline)
 *   - inactive     #888888 (polybar inactive text)
 *   - border width 5px     (theme.border_width), square corners like hlwm
 *
 * Window states are styled apart via the row options rofi_windows sets:
 *   default (fg-alt)     - visible: on the focused tag, not minimized
 *   active  (accent)     - unminimized: running on another tag
 *   urgent  (dimmed)     - minimized: hidden
 */

configuration {
	font: "Ubuntu Mono 12";
	columns: 1;
	bw: 0;
	location: 0;
	padding: 0;
	separator-style: "none";
	hide-scrollbar: true;
	fullscreen: false;
	scroll-method: 0;
	window-format: "{t}";
	click-to-exit: true;
	/* Highlight an entry under the mouse pointer */
	hover-select: true;
	/* Disable MousePrimary as an entry selector. Without this you can't
	   use MousePrimary as an entry acceptor. */
	me-select-entry: "";
	/* Accept an entry with a single left click (or LMB double click);
	   right click is bound to hot-key 1 by rofi_windows, which script
	   mode forwards to the backend as the toggle-minimize action */
	me-accept-entry: [ MousePrimary, MouseDPrimary ];
	display-window: "Windows";
}

* {
	bg: #333333;
	bg-alt: #222222;
	fg: #eeeeee;
	fg-alt: #888888;
	accent: #feef69;
	normal-border: #666666;
	transparent: rgba(0, 0, 0, 0);
}

window {
	background-color: @bg;
	border: 5px;
	border-color: @normal-border;
	border-radius: 0px;
	padding: 5px;
	/* Attach the switcher to the polybar (bottom bar, height 28 + 4 margin) */
	location: south;
	y-offset: -38px;
	/* hlwm inner_color outline just inside the frame */
	outline: 1px;
	outline-color: @bg-alt;
}

mainbox {
	background-color: @bg;
	padding: 8px 8px 0px 8px;
	children: [ inputbar, listview ];
}

inputbar {
	spacing: 0px;
	text-color: @fg;
	background-color: @bg-alt;
	padding: 10px 14px;
	border: 0 0 2px 0;
	border-color: @accent;
	children: [ prompt, entry ];
}

prompt {
	expand: false;
	text-color: @accent;
	background-color: @bg-alt;
	padding: 0px 10px 0px 0px;
}

entry {
	text-color: @fg;
	background-color: @bg-alt;
	placeholder: "";
	placeholder-color: @fg-alt;
}

listview {
	fixed-height: false;
	scrollbar: false;
	spacing: 2px;
	padding: 8px 4px;
	background-color: @bg;
        /* vertical list: one entry per line, sized to entry count.
           lines is overridden per-call via -l (number of entries). */
        columns: 1;
        flow: vertical;
        fixed-columns: false;
	padding: 6px 10px 0px 10px;
	text-color: @fg-alt;
	background-color: @transparent;
	border: 0 0 2px 0;
	border-color: @transparent;
	border-radius: 0px;
        children: [ element-text ];
}

/* default rows: dark bg, light gray text — the WHITE highlight is
   reserved for the selected (keyboard/mouse-hover) row */
element {
        background-color: @bg;
        text-color: @fg-alt;
		padding: 5px;
}

/* dmenu renders an icon placeholder box per row by default; we have
   no icons, so collapse it to zero size */
element-icon {
        size: 0;
}

element selected {
        background-color: @bg;
        text-color: #feef69;
        border-color: @accent;
}

/* the window that currently has hlwm focus arrives pre-wrapped in a
   #feef69 pango span from the caller (polywins -markup) */
element-text {
        background-color: @transparent;
        text-color: inherit;
        vertical-align: 0.5;
        horizontal-align: 0;
}

