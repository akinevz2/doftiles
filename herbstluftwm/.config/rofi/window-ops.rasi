/*
 * window-ops.rasi
 *
 * Right-click window menu for polywins, attached to the polybar.
 * Specializes hlwm.rasi: fixed, non-filterable list; RMB accepts
 * entries (the polywin context menu is opened by RMB).
 */

@import "hlwm.rasi"

configuration {
	lines: 8;
	fixed-num-lines: true;
	/* RMB also accepts an entry */
	me-accept-entry: [ MousePrimary, MouseSecondary, MouseDPrimary ];
}

/* The menu is a fixed list, no filtering needed */
entry {
	enabled: false;
}
