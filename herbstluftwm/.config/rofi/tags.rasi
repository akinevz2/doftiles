/*
 * tags.rasi
 *
 * Rofi script-mode theme for the tag (workspace) switcher, attached to
 * the polybar. Specializes hlwm.rasi: filterable entry, auto-select for
 * the current tag, fixed item count.
 */

@import "hlwm.rasi"

configuration {
	lines: 8;
	fixed-num-lines: false;
	/* Allow the selected row option from script mode to set the
	   initially-highlighted row (current workspace) */
	auto-select: true;
}

window {
	width: 360px;
}

/* Typed input filters the tags: an index number or a name fragment */
entry {
	text-color: @fg;
	background-color: @bg-alt;
	placeholder: "filter...";
	placeholder-color: @fg-alt;
}
