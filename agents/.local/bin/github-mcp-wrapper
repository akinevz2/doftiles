#!/usr/bin/env bash
set -euo pipefail

container_name="${GITHUB_MCP_CONTAINER_NAME:-opencode-github-mcp}"

# Resolve a token without storing it in the project config.
# Prefer an explicitly exported value; otherwise reuse the authenticated gh CLI token.
if [ -z "${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ]; then
  if command -v gh >/dev/null 2>&1; then
    GITHUB_PERSONAL_ACCESS_TOKEN="$(gh auth token 2>/dev/null || true)"
  fi
fi

if [ -z "${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ]; then
  echo "GitHub MCP requires a token: export GITHUB_PERSONAL_ACCESS_TOKEN or run 'gh auth login'." >&2
  exit 1
fi

# Reuse a managed container if it already exists.
if docker ps -a --format '{{.Names}}' | grep -Fxq "$container_name"; then
  if docker ps --format '{{.Names}}' | grep -Fxq "$container_name"; then
    exec docker exec -i "$container_name" /server/github-mcp-server stdio
  fi

  # Container exists but is stopped; start it and attach.
  docker start "$container_name" >/dev/null
  exec docker exec -i "$container_name" /server/github-mcp-server stdio
fi

# Fresh runtime: no local port bind, no OAuth callback port, stdio transport only.
exec docker run -i --rm \
  --name "$container_name" \
  -e "GITHUB_PERSONAL_ACCESS_TOKEN=${GITHUB_PERSONAL_ACCESS_TOKEN}" \
  ghcr.io/github/github-mcp-server stdio
