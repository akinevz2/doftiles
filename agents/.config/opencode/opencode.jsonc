{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["./opencode-screencast"],
  "formatter": true,
  "lsp": true,
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "permission": {
    "doom_loop": "deny",
    "external_directory": {
      "~/dots/**": "allow",
      "~/development/**": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "edit": {
      "~/.*/**": "deny",
      "~/.aliases": "ask",
      "~/.exports": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      ".git/**": "deny",
      "/tmp/**": "allow",
      ".opencode/system/**": "allow"
    },
    "read": {
      ".git/*": "ask",
      "~/.aliases": "allow",
      "~/.exports": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*>*": "ask",
      "*>>*": "ask",
      "*.git/*": "deny",
      "cp *": "ask",
      "tee *": "ask",
      "sed -i*": "ask",
      "npx *": "ask",
      "patch *": "ask",
      "rm -rf *": "deny",
      "rm *": "ask",
      "echo *": "allow",
      "rmdir *": "ask",
      "rg *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git grep *": "allow",
      "git push *": "ask",
      "git pull *": "ask",
      "git commit *": "ask",
      "git add *": "ask",
      "git *": "ask",
      "mv *": "ask",
      "npm *": "ask"
    }
  },
  "provider": {
    "rarebox": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "WS-RAREBOX",
      "options": {
        "baseURL": "http://ws-rarebox:11434/v1"
      },
      "models": {
        "laguna-xs-2.1:32k": {
          "name": "Laguna XS 2.1 (32k)",
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "nemotron-3.5-lightning": {
          "name": "Nemotron 3.5 Lightning",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "reasoning": true,
          "tool_call": true
        },
        "qwen3-coder": {
          "name": "Qwen3 Coder",
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "glm-4.7-flash": {
          "name": "GLM 4.7 Flash",
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": ["/home/kine/.local/bin/github-mcp-wrapper"],
        "enabled": true
      },
      "sonarqube": {
        "type": "local",
        "command": ["/home/kine/.local/bin/sonarqube-mcp-wrapper"],
        "enabled": true
      }
    }
  }
}
