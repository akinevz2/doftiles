#!/usr/bin/env bash

unset WAYLAND_DISPLAY
source ${HOME}/.exports

herb() {
    herbstclient "$@"
}

keyreg() {
    herb keybind "$@"
}

### CONFIG ###
# single monitor only — running inside Xephyr

### MODS ###
Mod=Mod1            # Alt — primary mod inside Xephyr
ModShift=Mod1-Shift
ModCtrl=Mod1-Control

### REGISTER RELOAD ###
herb emit_hook reload
herb set_layout max
herb keyunbind --all
# kill stale panel processes from a previous session; the polywins
# hook listener exits with polybar (it is a child process)
herb spawn ${HOME}/.local/bin/polyctl reload

# LAUNCHERS
# TERMINAL="gnome-terminal --zoom 1.5"
ROFITHEME=${HOME}/.config/rofi/launcher.rasi
APPLAUNCHER="${HOME}/.local/bin/rofi_launch"
SCREENSHOTTER="scrot"
APPSWITCHER="rofi -modi windowcd -show windowcd -theme ${ROFITHEME}"

# terminal
keyreg $Mod-Return          spawn $TERMINAL
keyreg $ModShift-t     chain . lock . split auto . cycle_frame . spawn $TERMINAL . unlock

keyreg $ModShift-Return      spawn $APPLAUNCHER
# applauncher
keyreg $ModCtrl-w           or . and , compare tags.focus.curframe_wcount gt 0 , spawn $APPSWITCHER . close_or_remove         # was Mod-Tab
keyreg $ModCtrl-a           or . and , compare tags.focus.curframe_wcount gt 1 , split explode . spawn $APPLAUNCHER           # was Mod-Tab
keyreg $Mod-q          or . and , compare tags.focus.floating_focused = true , attr tags.focus.floating_focused off . close_or_remove
# screenshot; revision HHKB custom caps

# CLOSE OR QUIT WM
keyreg $ModShift-q               or . and , compare clients.focus.floating = true , attr clients.focus.floating off . close_or_remove
keyreg $ModCtrl-q           spawn xkill
keyreg $ModShift-w          reload

# WINDOWING
keyreg $Mod-a               or , focus left --level=frame , split left 0.33333
keyreg $ModShift-a          or , shift left , focus left --level=frame , chain . split left . shift left
keyreg $ModShift-e          chain . split explode . cycle_frame
keyreg $ModCtrl-e           chain . split auto . cycle_frame
keyreg $ModShift-r               chain ! lock ! rotate ! unlock
keyreg $ModCtrl-r      or , and . compare tags.focus.frame_count lt 2 \
                            . cycle -1 \
                      , cycle_frame
keyreg $Mod-e               or . and , compare tags.focus.frame_count gt 1 , cycle_frame . chain ! split explode ! cycle_frame

# cycle; was $Mod-s / $ModShift-s
# zoom/peek grid
keyreg $Mod-s               chain : lock \
                                  :  or , jumpto urgent \
                                        , and ! compare tags.focus.curframe_wcount gt 1 \
                                              ! cycle -1 \
                                        , and . set_attr clients.focus.floating off \
                                                . pseudotile toggle \
                                  : unlock                
                                            
                                            
                                            

# was $ModAlt-Tab → now Alt+Shift+`
keyreg $Mod-c       or \
                    . and \
                        , compare tags.focus.tiling.root.split_type = vertical \
                        , compare tags.focus.floating_focused = 0 \
                        , rotate \
                    . chain \
                        , cycle_frame \
                        , jumpto urgent
keyreg $Mod-w       chain : lock : or , and \
                            ! compare tags.focus.curframe_wcount gt 1 \
                            ! cycle +1 \
                       , focus --level=frame up \
                       , cycle_frame : unlock

keyreg $ModShift-x          use_previous

keyreg $ModShift-d  or \
                    . and \
                            , compare tags.focus.curframe_wcount gt 1 \
                            , cycle_layout +1 max grid vertical \
                    . remove
keyreg $Mod-d   or \
                , and \
                    . compare tags.focus.curframe_wcount gt 3 \
                            . cycle_layout +1 max vertical grid horizontal \
                , and \
                    . compare tags.focus.curframe_wcount = 2 \
                    . cycle_layout +1 vertical max grid \
                , cycle_layout -1 vertical horizontal max

# rotate layout
# flip layout

keyreg $ModShift-z          attr clients.focus.minimized toggle
# peek floats; when the floating layer is empty (or every float is
# hidden), offer the hidden windows via rofi; rofi_hidden exits
# non-zero when nothing is hidden, so fall back to the previous tag.
# Wrapped in sh -c because "spawn" itself is always truthy — the or
# chain has to see the script's exit code.
keyreg $Mod-g               spawn sh -c '~/.local/bin/rofi_hidden || herbstclient use_previous'

# tag switcher
keyreg $Mod-t               spawn ~/.local/bin/rofi_tags

# quick float toggle for the focused window: floated windows are
# centered inside their focused frame (visual float indicator);
# pressing again re-unfloats — no focus chasing (hc_focus)
keyreg $Mod-f               spawn ~/.local/bin/hc_focus
# zoom: 3-state toggle for the focused window — float the focused
# window if tiled (a), maximize onto a <tag>-max tag if floating (b),
# restore via hc_unmaximize if maximized (c) (hc_zoom)
keyreg $ModCtrl-f          spawn ~/.local/bin/hc_zoom

# tidying tool: pulls the focused client out of its frame (float +
# center on screen, focus back to tiling); with a float on the tag,
# an empty focused frame "drops" the float back in, a frame holding
# clients just toggles focus to the floating layer (hc_floatx)
keyreg $Mod-x               spawn ~/.local/bin/hc_floatx

# split into direction
keyreg $Mod-v               chain , split right  0.5 , cycle_frame
keyreg $Mod-b               chain , split bottom 0.5 , cycle_frame
keyreg $ModCtrl-v           chain , split right  0.5 , focus -e right
keyreg $ModCtrl-b           chain , split bottom 0.5 , focus -i down
keyreg $ModShift-b          chain split top 0.5 , focus -i down


# FOCUS — arrows only; old Alt-hjkl aliases dropped (would shadow new Mod=Alt)
keyreg $Mod-h                   focus --level=all left
keyreg $Mod-j                   focus --level=all down
keyreg $Mod-k                   focus --level=all up
keyreg $Mod-l                   focus --level=all right
keyreg $Mod-Left                focus --level=visible left
keyreg $Mod-Down                focus --level=visible down
keyreg $Mod-Up                  focus --level=visible up
keyreg $Mod-Right               focus --level=visible right

# SHIFT windows — Alt+Ctrl+arrows and Alt+Ctrl+hjkl
# (hjkl slot freed up by dropping the old focus aliases)
keyreg $ModCtrl-h               shift --level=all left
keyreg $ModCtrl-j               shift --level=all down
keyreg $ModCtrl-k               shift --level=all up
keyreg $ModCtrl-l               shift --level=all right
keyreg $ModCtrl-Left            or . shift --level=frame left . shift --level=all left
keyreg $ModCtrl-Down            or . shift --level=frame down . shift --level=all down
keyreg $ModCtrl-Up              or . shift --level=frame up . shift --level=all up
keyreg $ModCtrl-Right           or . shift --level=frame right . shift --level=all right

### TAGS ###
herb set swap_monitors_to_get_tag 0

tag_names=( work term browser logs task default )
tag_keys=( {1..9} 0 )

herb rename default "${tag_names[0]}" || true
herb add term
herb add config
herb add logs
herb add task
herb add browser
herb add discord
for i in "${!tag_keys[@]}" ; do
    if ! [ -z $name ] ; then
        herb add "${tag_names[$i]}"
    fi
    key="${tag_keys[$i]}"
    if [ -n "$key" ] ; then
        keyreg "$Mod-$key" use_index "$i"
        keyreg "$ModCtrl-$key" move_index "$i"
    fi
done

# mouse
herb mouseunbind --all
herb mousebind $Mod-Button1 move
herb mousebind $Mod-Button2 zoom
herb mousebind $Mod-Button3 resize
# scroll wheel: cycle windows within current frame (up = previous, down = next)
herb mousebind $Mod-Button4 call cycle +1
herb mousebind $Mod-Button5 call cycle -1

# # focus other screen
# # send to other screen
# keyreg $ModCtrl-e           shift_to_monitor +1
# keyreg $ModShift-x          spawn bring_last

# source /home/kine/.config/herbstluftwm/dunst_keybinds

# RESIZING
resizestep=0.25
nudgestep=0.083

keyreg $Mod-bracketleft     use_index -1 --skip-visible
keyreg $Mod-bracketright    use_index +1 --skip-visible

keyreg $ModCtrl-comma       resize left +$resizestep
keyreg $ModCtrl-period      resize right +$resizestep

keyreg $ModShift-h          resize left +$nudgestep --level=all
keyreg $ModShift-j          resize down +$nudgestep --level=all
keyreg $ModShift-k          resize up +$nudgestep --level=all
keyreg $ModShift-l          resize right +$nudgestep --level=all
keyreg $ModShift-Left       resize left +$resizestep --level=all
keyreg $ModShift-Down       resize down +$resizestep --level=all
keyreg $ModShift-Up         resize up +$resizestep --level=all
keyreg $ModShift-Right      resize right +$resizestep --level=all

herb set default_direction_external_only 1

keyreg $Mod-comma           cycle_all --skip-invisible -1
keyreg $Mod-period          cycle_all --skip-invisible +1
keyreg $ModShift-comma      shift left
keyreg $ModShift-period     shift right



# THEME — colors/decorations/wallpaper moved to the sibling "theme"
# script: it applies only on a fresh WM start (guarded by a persistent
# hlwm env flag) and exits immediately on reloads, so reloading this
# autostart never re-sets decorations (no theme jitter).
"$HOME/.config/herbstluftwm/reload_theme"

herb set snap_distance 10
herb set snap_gap 5

herb set mouse_recenter_gap 5
herb set focus_follows_mouse off
herb set focus_stealing_prevention off
herb set focus_crosses_monitor_boundaries off
herb set gapless_grid on
herb set pseudotile_center_threshold 25
herb set update_dragged_clients off

# RULES
herb unrule -F
herb rule focus=on
herb rule windowtype~'_NET_WM_WINDOW_TYPE_(DIALOG|UTILITY|SPLASH)' floating=on
herb rule class~'[Yy]ad' floating=on
herb rule windowtype='_NET_WM_WINDOW_TYPE_DIALOG' focus=on
herb rule windowtype~'_NET_WM_WINDOW_TYPE_(NOTIFICATION|DOCK|DESKTOP)' manage=off focus=off

herb rule class='pavucontrol' tag=volume
herb rule class='spotify' tag=music
herb rule class='firefox' windowtype='_NET_WM_WINDOW_TYPE_NORMAL' tag=browser
herb rule title='Task Manager' tag=task
herb rule title='Config Manager' tag=config

herb set default_frame_layout grid

# unlock, just to be sure
herb unlock
# herb set_monitors 1

