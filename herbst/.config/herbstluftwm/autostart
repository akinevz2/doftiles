SCREENSHOTTER="scrot"
APPSWITCHER="rofi -modi windowcd -show windowcd -theme ${ROFITHEME}"

# terminal
keyreg $Mod-Return          spawn $TERMINAL
# applauncher
keyreg $ModCtrl-w           or . and , compare tags.focus.curframe_wcount gt 0 , spawn $APPSWITCHER . close_or_remove         # was Mod-Tab
keyreg $ModCtrl-a          or . and , compare tags.focus.curframe_wcount gt 1 , split explode . spawn $APPLAUNCHER           # was Mod-Tab
keyreg $ModShift-q          or \
                            . and \
                                    , compare tags.focus.curframe_wcount lt 2 \
                                    , close_or_remove                         \
                            . remove
# screenshot; revision HHKB custom caps

# CLOSE OR QUIT WM
keyreg $Mod-q               close_or_remove
keyreg $ModCtrl-q           spawn xkill
keyreg $ModShift-w          reload

# WINDOWING
