keyreg $Mod-a               chain . split left 0.5 . focus left
keyreg $ModShift-a          or , shift left , focus left --level=frame , chain . split left . shift left
keyreg $ModCtrl-r           chain . split auto . cycle_frame 
keyreg $ModCtrl-e           chain . split auto . cycle_frame
keyreg $ModShift-r          split explode
keyreg $ModShift-e          chain . split horizontal . cycle_frame

# cycle; was $Mod-s / $ModShift-s
# zoom/peek grid
keyreg $ModShift-s          cycle_layout +1 grid max
keyreg $Mod-s               or \
                                , focus --level=frame down \
                                , and ? compare tags.focus.curframe_wcount gt 1 \
                                      ? cycle -1 \
                                , chain . lock \
                                    . or ? attr clients.focus.floating off \
                                        ? cycle_frame \
                                    . pseudotile on \
                                    . unlock


# was $ModAlt-Tab → now Alt+Shift+`
keyreg $Mod-c       or \
                    . and \
                        , compare tags.focus.tiling.root.split_type = vertical \
                        , compare tags.focus.floating_focused = 0 \
                        , rotate \
                    . chain \
                        , cycle_frame \
                        , jumpto urgent
keyreg $Mod-w       or \
                        . jumpto urgent \
                        . focus --level=frame up \
                        . and , compare tags.focus.curframe_wcount gt 1 \
                              , cycle \
                        . cycle_frame -1

keyreg $Mod-e      or \
                        , and \
                            . compare tags.focus.frame_count lt 2 \
                            . cycle -1 \
                        , cycle_frame
keyreg $ModShift-x          use_previous

keyreg $ModShift-d  or \
                    . and \
                            , compare tags.focus.curframe_wcount gt 1 \
                            , cycle_layout +1 max grid \
                    . remove
keyreg $Mod-d   or \
                , and \
                    . compare tags.focus.curframe_wcount gt 3 \
                    . cycle_layout +1 grid vertical max horizontal      \
                , and \
                    . compare tags.focus.curframe_wcount = 2 \
                    . cycle_layout +1 max vertical grid  \
                , cycle_layout -1 grid horizontal max 

# rotate layout
# flip layout
keyreg $Mod-r               or , and . compare tags.focus.curframe_wcount gt 1 . chain ! lock ! rotate ! rotate ! unlock , cycle_frame

# fullscreen
keyreg $ModShift-f          floating toggle

# peek floats; when the floating layer is empty (or every float is
# hidden), offer the hidden windows via rofi
keyreg $ModShift-z          attr clients.focus.minimized toggle
keyreg $Mod-z               or \
                                . attr tags.focus.floating_focused toggle \
                                . spawn ~/.local/bin/rofi_hidden 

# tag switcher
keyreg $Mod-g               spawn ~/.local/bin/rofi_tags

# toggle float and center
keyreg $Mod-f               chain \
                                ! lock \
                                ! or \
                                    . attr tags.focus.floating_focused toggle \
                                    . or \
                                        . and , compare tags.focus.tiling.focused_frame.client_count lt 1 \
                                              , floating off \
                                        . and , compare tags.focus.tiling.focused_frame.client_count gt 1 \
                                              , attr clients.focus.floating toggle \
                                              , spawn ~/.local/bin/hc_center \
                                        . fullscreen toggle \
                                ! unlock

# fullscreen / float
keyreg $Mod-x               chain \
                            ! lock \
                            ! attr clients.focus.floating off \
                            ! or \
                                , attr tags.focus.floating_focused on \
                                , pseudotile off \
                            ! and , compare tags.focus.tiling.focused_frame.client_count lt 1 \
                                , remove \
                            ! unlock

# split into direction
