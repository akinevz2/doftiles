#!/bin/sh
# rofi_hidden: pick a hidden (minimized) client and jump to it.
# Exits non-zero when there are no hidden clients, so callers can
# chain further fallbacks after it.

herb() {
	herbstclient "$@"
}

# List minimized windows with their titles and classes
list_hidden() {
	herb attr clients | while read -r obj _; do
		case $obj in
			0x*) 
				obj=${obj%.}
				minimized=$(herb attr "clients.$obj.minimized" 2>/dev/null)
				[ "$minimized" != "true" ] && continue
				class=$(herb attr "clients.$obj.class" 2>/dev/null || echo "Unknown")
				title=$(herb attr "clients.$obj.title" 2>/dev/null || echo "")
				# Skip if no title
				[ -z "$title" ] && continue
				printf '%s\t%s\n' "$title" "$obj"
				;;
		esac
	done | sort -u
}

entries=$(list_hidden)
[ -n "$entries" ] || exit 1

# Show in rofi and get selection
selection=$(printf '%s' "$entries" | rofi -dmenu -theme ~/.config/rofi/window-ops.rasi -p "hidden" -selected-row 0)
[ -n "$selection" ] || exit 0

# Find and jump to the selected window
herb attr clients | while read -r obj _; do
	case $obj in
		0x*) 
			obj=${obj%.}
			minimized=$(herb attr "clients.$obj.minimized" 2>/dev/null)
			[ "$minimized" != "true" ] && continue
			title=$(herb attr "clients.$obj.title" 2>/dev/null || echo "")
			# Match selected title
			if [ "$title" = "$selection" ]; then
				herb jumpto "$obj"
				exit 0
			fi
			;;
	esac
done

exit 1