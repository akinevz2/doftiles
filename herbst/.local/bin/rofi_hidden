#!/bin/sh
# rofi_hidden: pick a hidden (minimized) client and jump to it.
# Styled exactly like the polyframes window switcher (rofi_windows):
# same theme, script-mode rows, icons, MRU ordering and actions, but
# the list only contains minimized clients (rendered in the theme's
# urgent/hidden state). Exits non-zero when there are no hidden
# clients, so callers can chain further fallbacks after it.

DISPLAY=${DISPLAY:-localhost:0.0}
unset WAYLAND_DISPLAY

herb() {
	herbstclient "$@"
}

client_fields() {
	# winid \t class \t minimized \t tag \t title
	herb attr "clients.$1" 2>/dev/null | awk -v wid="$1" '
		/ winid = "/    { sub(/^.* winid = "/, ""); sub(/".*$/, ""); w = $0 }
		/ class = "/    { sub(/^.* class = "/, ""); sub(/".*$/, ""); cls = $0 }
		/ title = "/    { sub(/^.* title = "/, ""); sub(/".*$/, ""); ttl = $0 }
		/ minimized = / { min = $NF }
		/ tag = "/      { sub(/^.* tag = "/, ""); sub(/".*$/, ""); tg = $0 }
		END {
			if (w != "")
				printf "%s\t%s\t%s\t%s\t%s\n", w, cls, min, tg, ttl
		}'
}

hidden_rows() {
	# Most recently used first, like the windowcd / rofi_windows
	# listing: walk the X stacking list top-down, keep only minimized
	# clients. Rows are numbered 1..n so they can be told apart and
	# picked quickly.
	i=0
	xprop -root -notype _NET_CLIENT_LIST_STACKING |
		awk -F'# ' '{ n = split($2, a, ", "); for (i = n; i >= 1; i--) print a[i] }' |
		while read -r wid; do
			IFS="	" read -r w cls min tg ttl <<EOF
$(client_fields "$wid")
EOF
			[ "$w" = "$wid" ] || continue
			[ "$min" = "true" ] || continue
			i=$((i + 1))
			disp=$(printf '%2d. %s' "$i" "${ttl:-$cls}")
			icon=$(echo "$cls" | tr '[:upper:]' '[:lower:]')
			# minimized: hidden — same urgent row markup as rofi_windows
			printf '%s\000icon\037%s\037urgent\037true\037info\037%s\n' \
				"$disp" "$icon" "$w"
		done
}

# Launcher: run rofi with this script as its script-mode backend.
# Right click is moved off the custom-action accept (whose flag script
# mode drops) to hot-key 1, which script mode forwards with the
# hovered row's info.
if [ -z "$ROFI_RETV" ]; then
	# no hidden clients: nothing to offer — fallback to rofi_windows
	rows=$(hidden_rows)
	[ -n "$rows" ] || exec ~/.local/bin/rofi_windows
	# exactly one hidden window left: no menu needed, just reveal it.
	# NOTE: shell variables cannot hold the NUL bytes the rofi rows use,
	# and sed has no portable octal escapes — so instead of parsing the
	# row, find the single minimized client directly via hlwm.
	if [ "$(printf '%s\n' "$rows" | grep -c .)" -eq 1 ]; then
		winid=$(xprop -root -notype _NET_CLIENT_LIST_STACKING |
			tr ', ' '\n\n' | grep '^0x' |
			while read -r wid; do
				[ "$(herb attr "clients.$wid.minimized" 2>/dev/null)" = "true" ] && echo "$wid"
			done | head -1)
		[ -n "$winid" ] && herb chain , bring "$winid" , raise "$winid"
		exit 0
	fi
	# narrower than the shared window-switcher theme default
	exec rofi -show hidden -modi "hidden:$0" \
		-theme "$HOME/.config/rofi/window-switcher.rasi" \
		-theme-str 'window { width: 35em; }' \
		-show-icons \
		-auto-select \
		-kb-custom-1 "MouseSecondary"
fi

# Backend: rofi calls back into this script.

case "$ROFI_RETV" in
	# Initial call: emit the hidden window rows. Octal escapes only:
	# dash's printf (unlike bash's) does not know \x hex escapes, and
	# rofi needs real \0 (NUL) / \037 (US) separator bytes here
	0)
		printf '\000use-hot-keys\037true\n'
		printf '\000prompt\037hidden\n'
		printf '\000no-custom\037true\n'
		hidden_rows
		;;
	# Accepted a row: jump to the window (jumpto follows it to its
	# tag, unminimizes and focuses it)
	1)
		herb bring "$ROFI_INFO"
		;;
	10)
		herb jumpto "$ROFI_INFO"
		;;
esac

# Actions print no rows, so rofi quits
exit 0