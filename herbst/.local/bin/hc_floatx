#!/usr/bin/env bash
# hc_floatx — Mod-x float, focus, and distraction-management actions.
# Runs under the WM lock (see below).

set -uo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY

hc() { herbstclient "$@"; }

# Hold the WM lock across the whole action: multi-write sequences
# (unfloat_tag loops, the float+hc_center combo, the reveal loop) must
# not interleave with Mod-f / ModCtrl-f writes or expose intermediate
# states. hlwm's lock is reference-counted, so hc_center's internal
# lock/unlock stays balanced; the trap releases it on every exit path.
hc lock
trap 'hc unlock' EXIT

orig=$("$HOME/.local/bin/hc_current" 2>/dev/null || true)
focus_float=$(hc attr clients.focus.floating_effectively 2>/dev/null || echo false)
frame_clients=$(hc attr tags.focus.curframe_wcount 2>/dev/null || echo 0)
frame_count=$(hc attr tags.focus.frame_count 2>/dev/null || echo 1)
algo=$(hc attr tags.focus.tiling.focused_frame.algorithm 2>/dev/null || echo "")
tag=$(hc attr tags.focus.name 2>/dev/null || echo "")

if [ -n "$orig" ]; then
    hc attr "clients.$orig.fullscreen" off 2>/dev/null || true
    hc attr "clients.$orig.pseudotile" off 2>/dev/null || true
fi

unfloat_tag() {
    local winid
    [ -n "$tag" ] || return 0
    for winid in $(hc list_clients --tag="$tag" 2>/dev/null); do
        if [ "$(hc attr "clients.$winid.floating" 2>/dev/null || echo false)" = "true" ]; then
            hc attr "clients.$winid.fullscreen" off 2>/dev/null || true
            hc attr "clients.$winid.pseudotile" off 2>/dev/null || true
            hc attr "clients.$winid.floating" off 2>/dev/null || true
        fi
    done
}

has_minimized_clients() {
    local winid
    [ -n "$tag" ] || return 1
    for winid in $(hc list_clients --tag="$tag" 2>/dev/null); do
        [ "$(hc attr "clients.$winid.minimized" 2>/dev/null || echo false)" = "true" ] && return 0
    done
    return 1
}

# Total clients on the tag (minimized included). 0 = genuinely empty
# workspace — there is nothing for a frame removal to make room for,
# so Mod-x must fall through to use_previous instead.
tag_total() {
    [ -n "$tag" ] || { echo 0; return 0; }
    herb attr "tags.by-name.${tag}.client_count" 2>/dev/null || echo 0
}

busy=false
if [ "$frame_count" -gt 1 ] && [ "$frame_clients" -gt 1 ]; then
    busy=true
fi

if [ "$focus_float" = "true" ]; then
    if [ "$frame_clients" = 0 ] && [ "$algo" = "max" ]; then
        unfloat_tag
        [ -n "$orig" ] && hc bring "$orig"
        exit 0
    fi


    if [ "$busy" == "true" ]; then
        [ -n "$orig" ] && hc attr clients.focus.floating off 2>/dev/null || true
        exit 0
    fi

    "$HOME/.local/bin/hc_center" root 2>/dev/null || true
    hc attr tags.focus.floating_focused off 2>/dev/null || true
    exit 0
fi

if hc attr tags.focus.floating_focused on 2>/dev/null; then
    if [ "$frame_clients" = 1 ]; then
        hc attr "clients.focus.minimized on" 2>/dev/null || true
        exit 0
    fi
    exit 0
fi

if [ "$frame_count" -gt 1 ]; then
    if [ "$frame_clients" -eq 0 ] && [ "$(tag_total)" != "0" ]; then
        hc remove
        exit 0
    fi


    # Check if there are any minimized windows and no tiling clients on the previous tag
    if has_minimized_clients && [ "$(hc attr tags.focus.tiling.focused_frame.client_count 2>/dev/null || echo 0)" -eq 0 ]; then
        for winid in $(hc list_clients --tag="$tag" 2>/dev/null); do
            if [ "$(hc attr "clients.$winid.minimized" 2>/dev/null || echo false)" = "true" ]; then
                hc attr "clients.$winid.minimized" off 2>/dev/null || true
            fi
        done
    fi

    "$HOME/.local/bin/hc_center" root 2>/dev/null || true
    hc attr clients.focus.floating on
fi

if [ "$frame_clients" = 0 ] && [ "$(tag_total)" != "0" ]; then
    hc remove
    exit 0
fi

if [ "$algo" == "max" ] && has_minimized_clients && [ "$frame_clients" -lt 1 ]; then
    hc spawn "$HOME/.local/bin/rofi_hidden"
    exit 0
fi

hc use_previous
[ -n "$orig" ] && hc bring "$orig" || true
