#!/usr/bin/env bash
# hc_floatx — Mod-x: the tidying tool.
#
# Behaviour, by focus state:
#   Floating window focused
#       -> focus returns to the tiling layer; the window stays
#          floating, untouched (no un-float, no geometry change).
#   Tiling layer focused, a visible float exists on the tag
#       empty focused frame   -> the float is dropped into it:
#                                un-floated and focused there.
#       frame holds clients   -> focus toggles to the floating layer
#                                (peek); the float is never un-floated
#                                from here.
#   Tiling layer focused, no floats on the tag
#       frame holds clients   -> the focused client is pulled out of
#                                its frame: floated in place, focus
#                                returned to the tiling layer.
#       empty frame           -> tidying: remove the empty frame,
#                                reveal minimized windows, rofi_hidden
#                                (max layout), or use_previous.
#
# Performance note: a herbstclient round-trip costs ~40 ms on this
# setup, so multi-read/multi-write sequences are batched into single
# `chain` spawns wherever the end state is unchanged by doing so.

set -uo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY

hc() { herbstclient "$@"; }

# Hold the WM lock across the whole action: multi-write sequences
# (the pull-out, the reveal loop) must not interleave with Mod-f /
# ModCtrl-f writes or expose intermediate states. hlwm's lock is
# reference-counted, so nested locks stay balanced; the trap releases
# it on every exit path.
hc lock
trap 'hc unlock' EXIT

orig=$(hc attr clients.focus.winid 2>/dev/null || true)

# Branch-dispatch state in ONE chain spawn; `echo "|"` separates the
# values (no value ever contains a pipe). A failed final read — the
# only path that can fail, when no client is focused — yields an
# empty field that parses as "false".
state_out=$(hc chain \
    , attr tags.focus.curframe_wcount , echo "|" \
    , attr tags.focus.tiling.focused_frame.client_count , echo "|" \
    , attr tags.focus.frame_count , echo "|" \
    , attr tags.focus.tiling.focused_frame.algorithm , echo "|" \
    , attr tags.focus.name , echo "|" \
    , attr tags.focus.tiling.focused_frame.content_geometry , echo "|" \
    , attr clients.focus.floating_effectively 2>/dev/null)
# printf (not a herestring) feeds mapfile without appending a
# newline, which would otherwise end up in the last record.
mapfile -d '|' -t st < <(printf '%s' "${state_out//$'\n'/}")
frame_clients=${st[0]:-0}
# focused_frame count — excludes minimized clients, so a visually
# empty frame reads 0 (matches hc_focus and the drop check below;
# curframe_wcount can still count a hidden client).
frame_cc=${st[1]:-0}
frame_count=${st[2]:-1}
algo=${st[3]:-}
tag=${st[4]:-}
fgeo=${st[5]:-}
focus_float=${st[6]:-false}

# From the floating layer: focus back to tiling, float untouched.
if [ "$focus_float" = "true" ]; then
    hc attr tags.focus.floating_focused off 2>/dev/null || true
    exit 0
fi

# Fold away stray fullscreen/pseudotile flags on the focused tiled
# client. (Skipped on the float side above, so a peek press never
# clears the float's flags.)
if [ -n "$orig" ]; then
    hc chain , attr "clients.$orig.fullscreen" off \
       , attr "clients.$orig.pseudotile" off 2>/dev/null || true
fi

# Total clients on the tag (minimized included). 0 = genuinely empty
# workspace — there is nothing for a frame removal to make room for,
# so Mod-x must fall through to use_previous instead.
tag_total() {
    [ -n "$tag" ] || { echo 0; return 0; }
    hc attr "tags.by-name.${tag}.client_count" 2>/dev/null || echo 0
}

has_minimized_clients() {
    [ -n "$tag" ] || return 1
    local winid cmd=(chain)
    for winid in $(hc list_clients --tag="$tag" 2>/dev/null); do
        cmd+=(, attr "clients.$winid.minimized")
    done
    [ ${#cmd[@]} -gt 1 ] || return 1
    case $(hc "${cmd[@]}" 2>/dev/null) in
        *true*) return 0 ;;
    esac
    return 1
}

# Find the first VISIBLE float on the tag, before any layer switch:
# under the held lock clients.focus does not follow floating_focused
# (it settles on unlock), so reads must all happen up front.
wids=($(hc list_clients --tag="$tag" 2>/dev/null))
first_float=""
if [ ${#wids[@]} -gt 0 ]; then
    cmd=(chain)
    for c in "${wids[@]}"; do
        cmd+=(, attr "clients.$c.floating" , echo "|" \
             , attr "clients.$c.minimized" , echo "|")
    done
    vals_out=$(hc "${cmd[@]}" 2>/dev/null)
    mapfile -d '|' -t vals < <(printf '%s' "${vals_out//$'\n'/}")
    for ((i = 0; i < ${#wids[@]}; i++)); do
        [ "${vals[i * 2]:-false}" = "true" ] || continue          # floating
        [ "${vals[i * 2 + 1]:-false}" = "false" ] || continue     # visible
        first_float=${wids[i]}
        break
    done
fi

if [ -n "$first_float" ]; then
    if [ "$frame_cc" = 0 ]; then
        # Drop: fold the float's stray flags and un-float it into the
        # focused frame; jumpto makes sure it gains focus.
        hc chain , attr "clients.$first_float.fullscreen" off \
           , attr "clients.$first_float.pseudotile" off \
           , attr "clients.$first_float.floating" off 2>/dev/null || true
        hc jumpto "$first_float" 2>/dev/null || true
    else
        # Peek: toggle focus to the floating layer; the float is
        # never un-floated from here.
        hc attr tags.focus.floating_focused on 2>/dev/null || true
    fi
    exit 0
fi

if [ "$frame_cc" -gt 0 ]; then
    # Pull-out: float the focused client in place and return focus to
    # the tiling layer; the emptied frame is free for searching or
    # splitting.
    hc attr clients.focus.floating on
    hc attr tags.focus.floating_focused off 2>/dev/null || true
    exit 0
fi

# Empty frame, no floats: tidying.
if [ "$frame_count" -gt 1 ]; then
    if [ "$frame_clients" -eq 0 ] && [ "$(tag_total)" != "0" ]; then
        hc remove
        exit 0
    fi
    # Hidden windows exist and nothing is tiled in the focused frame:
    # reveal them.
    if has_minimized_clients && [ "$frame_cc" -eq 0 ]; then
        cmd=(chain)
        for winid in $(hc list_clients --tag="$tag" 2>/dev/null); do
            cmd+=(, attr "clients.$winid.minimized" off)
        done
        hc "${cmd[@]}" 2>/dev/null || true
        exit 0
    fi
fi

if [ "$frame_clients" = 0 ] && [ "$(tag_total)" != "0" ]; then
    hc remove
    exit 0
fi

if [ "$algo" == "max" ] && has_minimized_clients && [ "$frame_clients" -lt 1 ]; then
    hc spawn "$HOME/.local/bin/rofi_hidden"
    exit 0
fi

hc use_previous
[ -n "$orig" ] && hc bring "$orig" || true
