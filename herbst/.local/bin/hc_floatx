#!/usr/bin/env bash
# hc_floatx — Mod-x: the layer-focus toggle / yanker. FINAL semantics:
#
#   floating_focused FALSE (tiling layer owns focus):
#     1. TRY focusing a float (floating_focused on; it fails when no
#        non-minimized float exists).
#     2. Success -> UN-FLOAT the float it focused (Mod-x owns manual
#        un-floats): it re-tiles into the focused frame and gains
#        focus.
#     3. Failure -> no floats exist:
#          populated focused frame  -> YANK: the focused client floats
#                                     at its current size, centered in
#                                     the monitor, INTO the float
#                                     session (floating_focused on).
#          empty focused frame      -> tidying (frame removal, reveal
#                                     minimized, polyframes hidden in
#                                     max layout, or use_previous).
#
#   floating_focused TRUE (a float holds the layer focus):
#     populated focused frame  -> DEFER: hand focus to the tiling
#                                 layer (floating_focused off); the
#                                 next press re-runs 1–2 above.
#     empty focused frame      -> UN-FLOAT the focused float into the
#                                 empty frame.
#
# Un-float chains intentionally contain NO floating_focused off —
# hlwm tracks the register on un-float; the defensive write raced
# with it. Standalone register writes (defer, re-entry failure)
# remain.
#
# Performance note: a herbstclient round-trip costs ~40 ms on this
# setup, so multi-read/multi-write sequences are batched into single
# `chain` spawns wherever possible.

set -uo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY
unset WAYLAND_DISPLAY

hc() { herbstclient "$@"; }

hc lock
trap 'hc unlock' EXIT

orig=$(hc attr clients.focus.winid 2>/dev/null || true)

state_out=$(hc chain \
    , attr tags.focus.curframe_wcount , echo "|" \
    , attr tags.focus.tiling.focused_frame.client_count , echo "|" \
    , attr tags.focus.frame_count , echo "|" \
    , attr tags.focus.tiling.focused_frame.algorithm , echo "|" \
    , attr tags.focus.name , echo "|" \
    , attr tags.focus.tiling.focused_frame.content_geometry , echo "|" \
    , attr clients.focus.floating_effectively 2>/dev/null)
mapfile -d '|' -t st < <(printf '%s' "${state_out//$'\n'/}")
frame_clients=${st[0]:-0}
frame_cc=${st[1]:-0}
frame_count=${st[2]:-1}
algo=${st[3]:-}
tag=${st[4]:-}
fgeo=${st[5]:-}

tag_total() {
    [ -n "$tag" ] || { echo 0; return 0; }
    hc attr "tags.by-name.${tag}.client_count" 2>/dev/null || echo 0
}

has_minimized_clients() {
    [ -n "$tag" ] || return 1
    local winid cmd=(chain)
    for winid in $(hc list_clients --tag="$tag" 2>/dev/null); do
        cmd+=(, attr "clients.$winid.minimized")
    done
    [ ${#cmd[@]} -gt 1 ] || return 1
    case $(hc "${cmd[@]}" 2>/dev/null) in
        *true*) return 0 ;;
    esac
    return 1
}

# Register read + first visible (non-minimized) float on the tag,
# resolved UP FRONT (clients.focus settles late after the switch).
ff=$(hc attr tags.focus.floating_focused 2>/dev/null || echo false)
first_float=""
for c in $(hc list_clients --tag="$tag" 2>/dev/null); do
    if [ "$(hc attr "clients.$c.floating" 2>/dev/null || echo false)" = "true" ] \
       && [ "$(hc attr "clients.$c.minimized" 2>/dev/null || echo false)" = "false" ]; then
        first_float=$c
        break
    fi
done

unfloat_wid() {  # $1 = float wid: fold flags, un-float, focus it.
    hc chain , attr "clients.$1.fullscreen" off \
       , attr "clients.$1.pseudotile" off \
       , attr "clients.$1.floating" off 2>/dev/null || true
    hc jumpto "$1" 2>/dev/null || true
}

unfloat_into_frame_below() {  # $1 = float wid
    # Mod-f's tile register, performed HERE (Mod-x owns hc_tile now;
    # Mod-f un-floats directly and closes frames instead): populate
    # case in a NON-MAX layout -> hc_tile makes the new empty frame
    # and the window un-floats into it; empty frame or max layout ->
    # direct un-float.
    local fcc falgo
    fcc=$(hc attr tags.focus.tiling.focused_frame.client_count \
          2>/dev/null || echo 0)
    falgo=$(hc attr tags.focus.tiling.focused_frame.algorithm \
            2>/dev/null || echo "")
    if [ "$fcc" != "0" ] && [ "$falgo" == "max" ]; then
        "$HOME/.local/bin/hc_tile" "$1" || true
        return
    fi
    unfloat_wid "$1"
}

if [ "$ff" = "true" ]; then
    # Called on a FLOATING window (float session):
    #   populated focused frame -> DEFER (reintroduced): hand focus to
    #     the tiling layer; the next press re-runs the
    #     focus-and-un-float branch.
    #   empty focused frame -> un-float the float into it directly.
    if [ "$frame_cc" != "0" ]; then
        hc attr tags.focus.floating_focused off 2>/dev/null || true
        exit 0
    fi
    wfocus=$(hc attr clients.focus.winid 2>/dev/null || true)
    if [ -n "$wfocus" ]; then
        unfloat_into_frame_below "$wfocus"
        exit 0
    fi
    hc attr tags.focus.floating_focused off 2>/dev/null || true
    exit 0
fi

# floating_focused FALSE: try focusing a float FIRST.
if hc attr tags.focus.floating_focused on 2>/dev/null; then
    # Success: the switched-to float is un-floated (manual un-float is
    # Mod-x's register). The PRE-SCANNED first_float is PRIMARY —
    # clients.focus settles late after the switch.
    wfocus=$first_float
    [ -n "$wfocus" ] || wfocus=$(hc attr clients.focus.winid 2>/dev/null || true)
    if [ -n "$wfocus" ]; then
        unfloat_wid "$wfocus"
        exit 0
    fi
    hc attr tags.focus.floating_focused off 2>/dev/null || true
    exit 0
fi

# Re-entry failed: no non-minimized float exists.
if [ "$frame_cc" -gt 0 ]; then
    # YANK: float the focused client, center it in the monitor's
    # geometry at its current size, INTO the float session.
    hc attr clients.focus.floating on 2>/dev/null || true
    # Frame close, SINGLE-CLIENT case only: when the yanked window was
    # the frame's only tiling client, the frame reads zero now — close
    # it (remove the split). Frames with other clients keep their
    # layout.
    vcc=$(hc attr tags.focus.tiling.focused_frame.client_count \
          2>/dev/null || echo 1)
    if [ "$vcc" = "0" ]; then
        hc remove 2>/dev/null || true
    fi
    "$HOME/.local/bin/hc_center" root || true
    hc attr tags.focus.floating_focused on 2>/dev/null || true
    exit 0
fi

# Empty frame, no floats: tidying.
if [ "$frame_count" -gt 1 ]; then
    if [ "$frame_clients" -eq 0 ] && [ "$(tag_total)" != "0" ]; then
        hc remove
        exit 0
    fi
    # Hidden windows exist and nothing is tiled in the focused frame:
    # reveal them.
    if has_minimized_clients && [ "$frame_cc" -eq 0 ]; then
        cmd=(chain)
        for winid in $(hc list_clients --tag="$tag" 2>/dev/null); do
            cmd+=(, attr "clients.$winid.minimized" off)
        done
        hc "${cmd[@]}" 2>/dev/null || true
        exit 0
    fi
fi

if [ "$frame_clients" = 0 ] && [ "$(tag_total)" != "0" ]; then
    hc remove
    exit 0
fi

if [ "$algo" == "max" ] && has_minimized_clients && [ "$frame_clients" -lt 1 ]; then
    hc spawn "$HOME/.local/bin/polyframes hidden"
    exit 0
fi

hc use_previous
[ -n "$orig" ] && hc bring "$orig" || true
