#!/usr/bin/env bash
# hc_floatx — Mod-x float, focus, and distraction-management actions.
# Runs unlocked: these operations do not need a lock.

set -uo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY

hc() { herbstclient "$@"; }

orig=$("$HOME/.local/bin/hc_current" 2>/dev/null || true)
focus_float=$(hc attr clients.focus.floating_effectively 2>/dev/null || echo false)
frame_clients=$(hc attr tags.focus.tiling.focused_frame.client_count 2>/dev/null || echo 0)
frame_count=$(hc attr tags.focus.frame_count 2>/dev/null || echo 1)
algo=$(hc attr tags.focus.tiling.focused_frame.algorithm 2>/dev/null || echo "")
tag=$(hc attr tags.focus.name 2>/dev/null || echo "")

if [ -n "$orig" ]; then
    hc attr "clients.$orig.fullscreen" off 2>/dev/null || true
    hc attr "clients.$orig.pseudotile" off 2>/dev/null || true
fi

unfloat_tag() {
    local winid
    [ -n "$tag" ] || return 0
    for winid in $(hc list_clients --tag="$tag" 2>/dev/null); do
        if [ "$(hc attr "clients.$winid.floating" 2>/dev/null || echo false)" = "true" ]; then
            hc attr "clients.$winid.fullscreen" off 2>/dev/null || true
            hc attr "clients.$winid.pseudotile" off 2>/dev/null || true
            hc attr "clients.$winid.floating" off 2>/dev/null || true
        fi
    done
}

has_minimized_clients() {
    local winid
    [ -n "$tag" ] || return 1
    for winid in $(hc list_clients --tag="$tag" 2>/dev/null); do
        [ "$(hc attr "clients.$winid.minimized" 2>/dev/null || echo false)" = "true" ] && return 0
    done
    return 1
}

busy=false
if [ "$frame_count" -gt 1 ] && [ "$frame_clients" -gt 1 ]; then
    busy=true
fi

if [ "$focus_float" = "true" ]; then
    if [ "$frame_clients" -gt 0 ] && [ "$algo" = "max" ]; then
        if [ "$frame_count" -eq 1 ]; then
            [ -n "$orig" ] && hc attr "clients.$orig.minimized" on
        else
            hc attr tags.focus.floating_focused off 2>/dev/null || true
        fi
        exit 0
    fi

    if [ "$frame_clients" -eq 0 ] || [ "$busy" = "true" ]; then
        unfloat_tag
        [ -n "$orig" ] && hc bring "$orig"
        exit 0
    fi

    [ -n "$orig" ] && hc attr "clients.$orig.floating" off 2>/dev/null || true
    exit 0
fi

if [ "$frame_clients" -eq 0 ]; then
    if [ "$algo" != "max" ] && has_minimized_clients; then
        hc spawn "$HOME/.local/bin/rofi_hidden"
        exit 0
    fi

    if [ "$frame_count" -gt 1 ] && hc attr tags.focus.floating_focused on 2>/dev/null; then
        "$HOME/.local/bin/hc_center" frame 2>/dev/null || true
        exit 0
    fi

    if [ "$frame_count" -gt 1 ]; then
        hc remove
    else
        hc use_previous
    fi
    exit 0
fi

if [ "$frame_count" -gt 1 ] && hc attr tags.focus.floating_focused on 2>/dev/null; then
    exit 0
fi

if [ "$frame_count" -eq 1 ]; then
    if [ "$frame_clients" -gt 1 ]; then
        [ -n "$orig" ] && hc attr "clients.$orig.minimized" on
    elif [ "$frame_clients" -eq 1 ] && [ -n "$orig" ]; then
        hc use_previous
        hc bring "$orig"
    else
        hc use_previous
    fi
    exit 0
fi

if [ "$algo" = "max" ]; then
    hc attr clients.focus.floating on
    "$HOME/.local/bin/hc_center" frame 2>/dev/null || true
    exit 0
fi

hc remove
