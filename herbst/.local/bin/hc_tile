#!/usr/bin/env bash
# hc_tile — navigate to the closest empty frame, or create one.
#
# Usage: hc_tile [wid]
#
#   a) SWITCH to the window's own tag (callers hand over wids from any
#      tag — polybar's window list, the rofi menu — while the ranking,
#      the "stay put" guard and any split decision would otherwise be
#      made against the FOCUSED tag's layout, i.e. the wrong tree).
#      If an empty leaf frame exists there, focus the one whose flat
#      index shares the longest common prefix with the window's
#      parent_frame.index (closest by parent). No empty frame:
#   b) `split auto` the window's frame and focus the new empty child —
#      determined by MEASURING the children's client_count after the
#      split, not by assuming hlwm's 0/1 content/empty convention.
#
# Split suppression:
#   - explicit-wid calls whose window is TILED and is the ONLY client
#     of its frame stay put (no move, no split) — the
#     unmaximize-into-emptied-frame return path;
#   - a floating window always USES an empty frame found by the
#     search (bring + unfloat into it); splitting is only ever
#     reached when the search found no empty frame.
#
# Verified hlwm 0.9.5 semantics this script relies on:
#   - a MINIMIZED client has NO parent_frame (ranking ref degrades to
#     prefix 0 — still functional, tree-order);
#   - an UNMINIMIZED client re-attaches into the CURRENTLY-FOCUSED
#     frame of its tag (that is why the split branch unminimizes FIRST,
#     and focus/bring immediately after);
#   - curframe_wcount is 0 whenever a floating window is focused or the
#     focused frame's clients are minimized, so the "stay put" guard
#     only applies when NO wid was given (self-resolved focus).

set -euo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY
unset WAYLAND_DISPLAY

herb() {
    herbstclient "$@"
}

# Optional: window whose own tag is operated on and whose parent frame
# ranks the empty frames. Without it the script stays on tags.focus and
# the ranking falls back to prefix length 0.
WID=${1:-$(hc_current 2>/dev/null || true)}

# Dotted object path segment for a flat frame index ("00" -> "0.0").
flat_to_dotted() {
    printf '%s' "$1" | sed 's/./&./g; s/.$//'
}

# Depth-first collection of all leaf frames as flat indexes.
# A leaf is a frame node with no child frames; hlwm prints split nodes
# as "N children:" and leaf frames as "0 children." (a period), so any
# node whose dump header lacks the colon is a leaf.
LEAVES=()
collect_leaves() {
    local dotted=$1 flat=$2
    local out count
    out=$(herb attr "tags.focus.tiling.root${dotted:+.$dotted}" 2>/dev/null) || return 0
    # Header line is "N children:" (no trailing period) for split nodes
    count=$(printf '%s\n' "$out" | sed -n 's/^\([0-9]*\) children:$/\1/p')
    if [ -n "$count" ] && [ "$count" -gt 0 ]; then
        collect_leaves "${dotted:+$dotted.}0" "${flat}0"
        collect_leaves "${dotted:+$dotted.}1" "${flat}1"
    else
        LEAVES+=("$flat")
    fi
}

# Longest common prefix length of two flat indexes.
common_prefix_len() {
    local a=$1 b=$2 n=0 i
    for (( i=0; i<${#a}; i++ )); do
        [ "${a:$i:1}" = "${b:$i:1}" ] || break
        n=$(( n + 1 ))
    done
    printf '%s' "$n"
}

# --- main ---------------------------------------------------------------

# Under one lock: find/split the destination frame and point the
# focused frame at it. The trap guarantees the lock is released even
# on error.
herb lock
trap 'herb unlock' EXIT

# Follow the WINDOW, not the focused tag: no-arg calls (wid resolved
# from focus) are on tags.focus already. Explicit-wid callers hand
# over windows from any tag — orient everything on the window's own
# tag before any layout decision below.
if [ -n "$WID" ]; then
    wtag=$(herb attr "clients.${WID}.tag" 2>/dev/null || true)
    wtag=${wtag//\"/}
    if [ -n "$wtag" ] && [ "$wtag" != "$(herb attr tags.focus.name 2>/dev/null || true)" ]; then
        herb use "$wtag" 2>/dev/null || true
    fi
    # Un-hide now: a minimized client has no parent frame UNTIL it is
    # shown again, and hlwm re-attaches it into the currently focused
    # frame once unminimized (would otherwise corrupt the ranking and
    # the split-branch destination). Idempotent if already visible.
    herb attr "clients.${WID}.minimized" false 2>/dev/null || true
fi

# "Stay put" only applies to self-resolved, already-visible calls:
# navigating away would strand the caller's focus when the focused
# frame's client count is genuinely zero (e.g. no window at all).
# curframe_wcount is ALSO 0 when a FLOAT is focused or the frame's
# windows are minimized — both must NOT short-circuit an explicit-wid
# call, so the guard runs only without an argument.
if [ -z "${1:-}" ] && herb compare "tags.focus.curframe_wcount" "=" "0" ; then
    herb unlock
    trap - EXIT
    exit 0
fi

# Guard (a): explicit-wid call whose window is already TILED and is
# the ONLY client of its frame — it is perfectly placed (this is the
# hc_unmaximize "returning home into the emptied frame" case). Do not
# move it and NEVER split its frame to make room. Bare self-resolved
# calls keep their navigate-or-split behavior.
if [ -n "${1:-}" ]; then
    wfloat=$(herb attr "clients.${WID}.floating" 2>/dev/null || echo false)
    if [ "$wfloat" != "true" ]; then
        mycc=$(herb attr "clients.${WID}.parent_frame.client_count" 2>/dev/null || echo -1)
        if [ "$mycc" = "1" ]; then
            herb jumpto "$WID" 2>/dev/null || true
            herb attr "clients.${WID}.floating" off 2>/dev/null || true
            herb unlock
            trap - EXIT
            exit 0
        fi
    fi
fi

# Reference frame for the closeness ranking (a minimized window has no
# parent_frame; empty wid -> "" so the ranking still works).
if [ -n "$WID" ]; then
    frame=$(herb attr "clients.${WID}.parent_frame.index" 2>/dev/null) || frame=""
else
    frame=$(herb attr tags.focus.tiling.focused_frame.index 2>/dev/null) || frame=""
fi

collect_leaves "" ""

# Empty leaves ranked by closeness (longest common prefix) to the
# window's frame.
best=""
best_score=-1
for leaf in "${LEAVES[@]}"; do
    dotted=$(flat_to_dotted "$leaf")
    cc=$(herb attr "tags.focus.tiling.root${dotted:+.$dotted}.client_count" 2>/dev/null || echo 0)
    if [ "$cc" = "0" ]; then
        score=$(common_prefix_len "$frame" "$leaf")
        if [ "$score" -gt "$best_score" ]; then
            best=$leaf
            best_score=$score
        fi
    fi
done

if [ -z "$best" ]; then
    # No empty frame: split the window's OWN frame. Bring focuses it
    # (floating or not) so split auto divides exactly the frame the
    # window surfaced into, THEN capture the index, THEN measure both
    # children's client_count to find the freshly emptied slot.
    herb bring "$WID" 2>/dev/null || true
    pre=$(herb attr tags.focus.tiling.focused_frame.index 2>/dev/null) || pre=""
    herb split auto
    for child in "${pre}0" "${pre}1"; do
        dotted=$(flat_to_dotted "$child")
        cc=$(herb attr "tags.focus.tiling.root${dotted:+.$dotted}.client_count" 2>/dev/null || echo -1)
        if [ "$cc" = "0" ]; then best=$child; break; fi
    done
    [ -n "$best" ] || best="${pre}1"   # both populated: hlwm's convention
fi

# Point the focused frame at the destination: set the selection attr on
# every split node from the ROOT down, one digit per level. The first
# digit selects a child of the root itself, so the root's own selection
# must be written too — focus is resolved top-down, and a deep write has
# no effect until all its ancestors point at it.
dotted=$(flat_to_dotted "$best")
path="tags.focus.tiling.root"
for d in $(printf '%s' "$dotted" | tr '.' ' '); do
    herb attr "$path.selection" "$d" 2>/dev/null || true
    path="$path.$d"
done

# Insert the window into the freshly-focused empty frame: bring moves
# tiled windows into the focused frame and refocuses floats; the
# unfloat below then re-tiles a float into that frame. Works for
# floats and tiled windows alike — guard (b): an empty frame found by
# the search is USED, the split branch is only reached when the
# search found none.
herb bring "$WID" 2>/dev/null || true
herb jumpto "$WID" 2>/dev/null || true
herb attr "clients.${WID}.floating" off 2>/dev/null || true
herb unlock
trap - EXIT
