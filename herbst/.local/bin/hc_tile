#!/usr/bin/env bash
# hc_tile — navigate to the closest empty frame, or create one.
#
# Usage: hc_tile [wid]
#
#   a) If an empty leaf frame exists, focus the one whose flat index
#      shares the longest common prefix with the window's
#      parent_frame.index (closest by parent). No empty frame:
#   b) `split auto` the focused frame and focus the new empty child.
# Navigates/focuses frames ONLY — never touches client state.

set -euo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY
unset WAYLAND_DISPLAY

herb() {
    herbstclient "$@"
}

# Optional: window whose parent frame the empty frame should be
# closest to. Without it the ranking falls back to prefix length 0.
WID=${1:-$(hc_current)}

# Dotted object path segment for a flat frame index ("00" -> "0.0").
flat_to_dotted() {
    printf '%s' "$1" | sed 's/./&./g; s/.$//'
}

# Depth-first collection of all leaf frames as flat indexes.
# A leaf is a frame node with 0 children (client_count may be 0..n).
LEAVES=()
collect_leaves() {
    local dotted=$1 flat=$2
    local out count
    out=$(herb attr "tags.focus.tiling.root${dotted:+.$dotted}" 2>/dev/null) || return 0
    # Header line is "N children:" (no trailing period)
    count=$(printf '%s\n' "$out" | sed -n 's/^\([0-9]*\) children:$/\1/p')
    if [ -n "$count" ] && [ "$count" -gt 0 ]; then
        collect_leaves "${dotted:+$dotted.}0" "${flat}0"
        collect_leaves "${dotted:+$dotted.}1" "${flat}1"
    else
        LEAVES+=("$flat")
    fi
}

# Longest common prefix length of two flat indexes.
common_prefix_len() {
    local a=$1 b=$2 n=0 i
    for (( i=0; i<${#a}; i++ )); do
        [ "${a:$i:1}" = "${b:$i:1}" ] || break
        n=$(( n + 1 ))
    done
    printf '%s' "$n"
}

# --- main ---------------------------------------------------------------

# Under one lock: find/split the destination frame and point the
# focused frame at it. The trap guarantees the lock is released even
# on error.
herb lock
trap 'herb unlock' EXIT

# If the FOCUSED frame is already empty, there is nothing to navigate
# to — stay put (navigating away would strand the caller's focus).
if herb compare "tags.focus.curframe_wcount" "=" "0"; then
    herb unlock
    trap - EXIT
    exit 0
fi

# Reference frame for the closeness ranking (a minimized window has no
# parent_frame; empty wid -> "" so the ranking still works).
if [ -n "$WID" ]; then
    frame=$(herb attr "clients.${WID}.parent_frame.index" 2>/dev/null) || frame=""
else
    frame=$(herb attr tags.focus.tiling.focused_frame.index 2>/dev/null) || frame=""
fi

collect_leaves "" ""

# Empty leaves ranked by closeness (longest common prefix) to the
# window's frame.
best=""
best_score=-1
for leaf in "${LEAVES[@]}"; do
    dotted=$(flat_to_dotted "$leaf")
    cc=$(herb attr "tags.focus.tiling.root${dotted:+.$dotted}.client_count" 2>/dev/null || echo 0)
    if [ "$cc" = "0" ]; then
        score=$(common_prefix_len "$frame" "$leaf")
        if [ "$score" -gt "$best_score" ]; then
            best=$leaf
            best_score=$score
        fi
    fi
done

if [ -z "$best" ]; then
    # No empty frame: split the focused frame and focus its new empty
    # child. split auto REPLACES the focused frame with a split whose
    # children are <old-index>0 (the old content) and <old-index>1
    # (empty) — so the new empty leaf is the pre-split focused index
    # with a "1" appended.
    pre=$(herb attr tags.focus.tiling.focused_frame.index)
    herb split auto
    best="${pre}1"
fi

# Point the focused frame at the destination: set the selection attr on
# every split node from the ROOT down, one digit per level. The first
# digit selects a child of the root itself, so the root's own selection
# must be written too — focus is resolved top-down, and a deep write has
# no effect until all its ancestors point at it.
dotted=$(flat_to_dotted "$best")
path="tags.focus.tiling.root"
for d in $(printf '%s' "$dotted" | tr '.' ' '); do
    herb attr "$path.selection" "$d" 2>/dev/null || true
    path="$path.$d"
done

herb unlock
trap - EXIT
