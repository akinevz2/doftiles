#!/usr/bin/env bash
# polyframes-switcher <frame> <class>
# Open a rofi switcher containing only the windows of one group.
# Selecting an entry focuses that window (jumpto + raise only — no
# minimize/toggle semantics).
#
# The group is rebuilt fresh via polyframes-focus, the same source the
# scroll handler uses — click and scroll can never diverge.
set -euo pipefail

DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY

# rofi aborts instantly on Wayland (layer-shell not supported); the
# bar process may still carry WAYLAND_DISPLAY from its launch env.
# Force the X11 backend for this script only.
unset WAYLAND_DISPLAY || true

frame=${1:?usage: polyframes-switcher <frame> <class>}
cls=${2:?usage: polyframes-switcher <frame> <class>}
tab=$(printf '\t')
us=$(printf '\001')

# One "display \x01 wid" pair per group member, in WM order. Display
# is the title plus a [min]/[flt] tag when needed; duplicate titles
# get a " ·N" suffix so each display maps to exactly one wid
# (plain grep -F matching).
pairs=
count=0
while IFS= read -r wid; do
    min=$(herbstclient attr "clients.$wid.minimized" 2>/dev/null) || min=false
    flt=$(herbstclient attr "clients.$wid.floating_effectively" 2>/dev/null) || flt=false
    ttl=$(herbstclient attr "clients.$wid.title" 2>/dev/null) || ttl=""
    ttl=$(printf "%s" "$ttl" | tr "\t\n" "  ")
    if [ "$min" = "true" ]; then
        ind=" [min]"
    elif [ "$flt" = "true" ]; then
        ind=" [flt]"
    else
        ind=""
    fi
    disp=${ttl:-$cls}$ind
    # disambiguate duplicate titles: " ·2", " ·3", ...
    n=2
    while printf "%s" "$pairs" | grep -Fq "$disp$us"; do
        disp="${ttl:-$cls}$ind ·$n"
        n=$(( n + 1 ))
    done
    count=$(( count + 1 ))
    # NOTE: append the newline as part of the string, not via
    # $(printf) — command substitution would strip it every iteration
    # and glue successive pairs onto one line
    pairs="$pairs$disp$us$wid\n"
done <<EOF
$("$DIR/polyframes-focus" "$frame" "$cls")
EOF
# realize the literal \n escapes once, outside the loop
pairs=$(printf "$pairs")
[ -z "$pairs" ] && exit 0

# Pre-select the focused window's row: its line number (grep -n on the
# wid field) minus one.
active_wid=$(herbstclient attr clients.focus.winid 2>/dev/null) || active_wid=""
sel_row=$(printf "%s" "$pairs" | grep -nF "$us$active_wid" | cut -d: -f1)
sel_row=${sel_row:-0}
sel_row=$(( sel_row - 1 ))

# Focused window's row gets a '-> ' prefix indicator; matching strips
# the prefix so the choice maps back to the plain pairs.
if [ "$sel_row" -gt 0 ]; then
    markup_pairs=$(printf "%s" "$pairs" | sed "$(( sel_row + 1 ))s/^/-> /")
else
    markup_pairs=$pairs
fi

# Size the rofi window to its content: measure the longest display
# line (including the '-> ' prefix) with a plain shell loop (here-doc,
# not a pipeline — the counter must survive) and convert to em
# (Ubuntu Mono advance ~0.62em per char) plus prompt/padding/border.
maxlen=0
while IFS= read -r line; do
    [ "${#line}" -gt "$maxlen" ] && maxlen=${#line}
done <<EOF
$(printf "%s" "$markup_pairs" | cut -d"$us" -f1)
EOF
[ "$maxlen" -lt 20 ] && maxlen=20
width_em=$(( maxlen * 62 / 100 + 5 ))

choice=$(printf "%s" "$markup_pairs" | cut -d"$us" -f1 |
    rofi -dmenu -i -auto-select -l "$count" -selected-row "$sel_row" \
        -theme ~/.config/rofi/window-switcher.rasi \
        -theme-str "window { width: ${width_em}em; }" \
        -p "$cls")
[ -z "$choice" ] && exit 0

# strip the indicator prefix, then map the chosen line back to its
# wid: match the FULL choice line ending at the separator (anchored
# pairs lookup — a plain substring grep could match the wrong pair
# when one title is a prefix of another)
choice=${choice#"-> "}
wid=$(printf "%s" "$pairs" | grep -F "$choice$us" | head -1 | cut -d"$us" -f2)
[ -z "$wid" ] && exit 0

herbstclient jumpto "$wid"
herbstclient raise "$wid"
