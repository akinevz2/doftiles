#!/usr/bin/env bash
# hc_focus — Mod-f: quick float toggle / floating-layer focus, keeping
# exactly ONE window at a time in floating (focus) mode.
#
# Floating window focused:
#     fullscreen           -> un-fullscreen AND un-float in one step
#     empty frame below    -> un-float (back into that empty frame)
#     >1 clients below     -> hop focus to the tiling layer; the
#                             window stays floating (peek — the next
#                             press un-floats it instead)
#     exactly 1 below      -> un-float, plain re-tile
#
# From the tiling layer (decision order):
#     empty focused frame AND a float exists on the tag
#         -> pull that float back into the frame in one step (it
#            re-tiles there and gains focus)
#     >1 clients AND a float exists
#         -> focus the float AND un-float it in one step (it rejoins
#            this frame's tiling)
#     exactly 1 client AND a float exists
#         -> just focus the floating layer — NEVER float a second
#            window while one is already out
#     no float on the tag
#         -> float the focused window, centered INSIDE its focused
#            frame (hc_center frame — the centering is the visual
#            float indicator)
#
# Stray fullscreen/pseudotile flags are folded away on every
# transition, so Mod-x (hc_floatx, the catch-all "get out") and this
# script always start from a clean slate.

set -uo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY

hc() { herbstclient "$@"; }

# Hold the WM lock across the whole toggle: the float path must not
# give the window a moment at its stale geometry between "floating on"
# and "centered". hlwm's lock is reference-counted, so nested locks
# (hc_center's own chain) stay balanced; the trap releases it on every
# exit path.
hc lock
trap 'hc unlock' EXIT

wid=$(hc attr clients.focus.winid 2>/dev/null || echo "")

# Client count of the focused frame ("the frame below" — still valid
# while a floating window has focus).
ccount=$(hc attr tags.focus.tiling.focused_frame.client_count 2>/dev/null || echo 0)

if [ -n "$wid" ]; then
    floating=$(hc attr "clients.$wid.floating" 2>/dev/null || echo false)
    if [ "$floating" = "true" ]; then
        fullscreen=$(hc attr "clients.$wid.fullscreen" 2>/dev/null || echo false)
        if [ "$fullscreen" = "true" ]; then
            # Fullscreen float: un-fullscreen AND un-float in one step.
            hc attr "clients.$wid.fullscreen" off 2>/dev/null || true
            hc attr "clients.$wid.floating" off 2>/dev/null || true
            exit 0
        fi
        if [ "$ccount" -eq 0 ]; then
            # Empty focused frame (the float's origin): un-float the
            # window straight back into it.
            hc attr "clients.$wid.floating" off 2>/dev/null || true
            exit 0
        fi
        if [ "$ccount" -gt 1 ]; then
            # Frame below holds several tiled clients: hop focus to
            # the tiling layer WITHOUT un-floating (peek; the next
            # press un-floats the window instead).
            hc attr tags.focus.floating_focused off 2>/dev/null || true
            exit 0
        fi
        # Exactly one tiled client below: un-float, plain re-tile.
        hc attr "clients.$wid.fullscreen" off 2>/dev/null || true
        hc attr "clients.$wid.floating" off 2>/dev/null || true
        exit 0
    fi
fi

# Is there a float on the tag? Entering the floating layer fails when
# there is none; probe by exit status.
if hc attr tags.focus.floating_focused on 2>/dev/null; then
    if [ "$ccount" -eq 0 ]; then
        # Empty focused frame: pull the float back into it (one step).
        float_wid=$(hc attr clients.focus.winid 2>/dev/null || echo "")
        if [ -n "$float_wid" ]; then
            hc attr "clients.$float_wid.fullscreen" off 2>/dev/null || true
            hc attr "clients.$float_wid.floating" off 2>/dev/null || true
        fi
        exit 0
    fi
    if [ "$ccount" -gt 1 ]; then
        # Frame below holds >1 clients: focus the float and un-float
        # it in one step — it rejoins the tiling of this frame.
        float_wid=$(hc attr clients.focus.winid 2>/dev/null || echo "")
        if [ -n "$float_wid" ]; then
            hc attr "clients.$float_wid.fullscreen" off 2>/dev/null || true
            hc attr "clients.$float_wid.floating" off 2>/dev/null || true
        fi
        exit 0
    fi
    # Exactly one client below: this press just focused the existing
    # float — never float a second window while one is already out.
    exit 0
fi

# No floats anywhere: float the focused tiled window, centered inside
# its frame. hc_center preserves the current size, clamps it to the
# frame rect, writes floating_geometry, sets floating on and refocuses.
if [ -n "$wid" ]; then
    hc attr "clients.$wid.fullscreen" off 2>/dev/null || true
    hc attr "clients.$wid.pseudotile" off 2>/dev/null || true
    "$HOME/.local/bin/hc_center" frame || true
fi
