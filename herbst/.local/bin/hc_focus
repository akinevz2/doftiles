#!/usr/bin/env bash
# hc_focus — Mod-f "focus" behaviour
#
# "Focus" is relative to the window's context:
#   - a window grouped with others in a frame: float the whole frame group
#     (peek); pressing again returns them all to tiling.
#   - a lone window in a frame: fullscreen gives more real estate than
#     floating, so toggle fullscreen instead.
#   - a single frame on the tag holding multiple clients: toggle the tag's
#     workspace-wide floating layer.
#   - in all cases: if a floating window is already on screen (reachable via
#     tags.focus.floating_focused), first focus it, then un-float it.

set -euo pipefail

DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY

hc() { herbstclient "$@"; }
addlog() { echo "hc_focus: " "$@"; }
dotpath() {
    local idx=$1 out="" i
    for (( i=0; i<${#idx}; i++ )); do
        out+=".${idx:$i:1}"
    done
    echo "tags.focus.tiling.root$out"
}
# Are we currently sitting on a floating window?
floating_focused=$(hc attr tags.focus.floating_focused 2>/dev/null || echo false)
# With no tiling windows on the tag there is no focused client at
# all — clients.focus.* reads fail and set -e would kill the script
# before the float branches run. Tolerate that.
focus=$(hc attr clients.focus.winid 2>/dev/null || echo "")
frame_count=$(hc attr tags.focus.frame_count)
count=$(hc attr tags.focus.tiling.focused_frame.client_count 2>/dev/null || echo 0)

addlog enter

# Guarantee the WM is never left locked: with set -e, ANY failing
# command between lock and unlock would abort the script and leak the
# lock (WM appears frozen). The trap releases it on every exit path.
hc lock
hc_unlocked=0
unlock() {
    addlog unlocking
    [ "$hc_unlocked" -eq 0 ] && herbstclient unlock && hc_unlocked=1 || true
}
trap unlock EXIT
[ -n "$focus" ] && hc attr clients.focus.pseudotile off || true

addlog test-isfloating
if [ "$floating_focused" = "true" ]; then
    addlog focus is floating
    # Un-float the focused float, then re-enter the floating layer if
    # another float remains — repeated Mod-f unfloats them one by one.
    hc attr clients.focus.floating off || true
    hc unlock
    hc_unlocked=1
    exit 0
fi

addlog test-canfocusfloating?
# Does the tag have ANY floating windows at all? (takes priority over
# maximizing: a float on screen should be focused before anything else)
# There is no float-count attribute — we probe by trying to enter the
# floating layer and checking the exit status.
if [ "$floating_focused" = "false" ] && hc attr tags.focus.floating_focused toggle 2>/dev/null; then
    addlog jumping to next floating
    addlog exiting
    hc unlock
    hc_unlocked=1
    exit 0 
fi

addlog "frame_count $frame_count count $count"
algo=$(hc attr tags.focus.tiling.focused_frame.algorithm 2>/dev/null || echo "")
addlog "algo $algo"

addlog test-fullscreen?
# Lone, non-floating window in a max-layout frame with multiple frames
# on screen: fullscreen gives more real estate than floating.
if [ "$frame_count" -gt 1 ] && [ "$count" -eq 1 ] && [ "$algo" = "max" ]; then
    addlog fullscreen lone window
    hc attr clients.focus.fullscreen toggle || true
    hc unlock
    hc_unlocked=1
    exit 0
fi

addlog basecase-float the focused window
# Nothing reachable to focus and no group/fullscreen case: float the
# focused window (centered), then we can Mod-f again to un-float it.
# (focus is empty when there is no client at all — nothing to float.)
if [ -n "$focus" ]; then
    hc attr clients.focus.fullscreen off || true
    # Resizable window (no fixed size hints): give it half the
    # workspace's width and height before floating it.
    # content_geometry is a single WxH+X+Y string (width first)
    if [ "$(hc attr "clients.$focus.sizehints_floating" 2>/dev/null || echo false)" = "true" ]; then
        geom=$(hc attr tags.focus.tiling.root.content_geometry)
        addlog geom $geom
        if [[ "$geom" =~ ^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$ ]]; then
            ww=${BASH_REMATCH[1]}; wh=${BASH_REMATCH[2]}
            wx=${BASH_REMATCH[3]}; wy=${BASH_REMATCH[4]}
            w2=$((ww / 2)); h2=$((wh / 2))
            x2=$((wx + (ww - w2) / 2)); y2=$((wy + (wh - h2) / 2))
            hc attr "clients.$focus.floating_geometry" "${w2}x${h2}+${x2}+${y2}"
        fi
    fi
    # center within the workspace (not the frame)
    "$HOME/.local/bin/hc_center" root || true
    hc attr clients.focus.floating on || true
fi
hc unlock
hc_unlocked=1
addlog finalexit