#!/usr/bin/env bash
# polyframes-focus <frame> <class>
# Print the winids of the group identified by frame index + class, in
# WM order (hc list_clients order, unsorted). Used by BOTH the click
# handler (switcher) and the scroll handler (scroll_focus) so they
# always operate on the same freshly-queried data.
#
# The frame index comes straight from the bar entry as emitted by
# polyframes-groups ("0" = root frame, "-1" = unframed single window).
#
# Also prints the group's wids as the only output; call with --wids to
# get the wid stream used by scroll, or plain (default) which is
# identical. Kept argument-free otherwise so callers pipe rows through
# cut/grep themselves.
set -euo pipefail

DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
DISPLAY=${DISPLAY:-localhost:0.0}
export DISPLAY

frame=${1:?usage: polyframes-focus <frame> <class>}
cls=${2:?usage: polyframes-focus <frame> <class>}
tab=$(printf '\t')

"$DIR/hc_get-clients" | while IFS="$tab" read -r wid c min ttl flt f; do
    [ -z "$wid" ] || [ -z "$c" ] && continue
    [ "$c" = "$cls" ] || continue
    [ "$f" = "$frame" ] || continue
    printf "%s\n" "$wid"
done
