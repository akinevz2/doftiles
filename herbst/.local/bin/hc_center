#!/usr/bin/env bash

DISPLAY="127.0.0.1:0"
export DISPLAY

herb() {
    herbstclient "$@"
}

monitor_geom=$(herb attr monitors.focus.geometry)
[[ $monitor_geom =~ ^([0-9]+)x([0-9]+)([+-][0-9]+)([+-][0-9]+)$ ]] || {
    echo "hc_center: cannot parse geometry '$monitor_geom'" >&2
    exit 1
}
mw=${BASH_REMATCH[1]}
mh=${BASH_REMATCH[2]}
mx=${BASH_REMATCH[3]}
my=${BASH_REMATCH[4]}
win_w=$((mw * 8 / 10))
win_h=$((mh * 8 / 10))
win_x=$((mx + (mw - win_w) / 2))
win_y=$((my + (mh - win_h) / 2))
herb chain . lock . set_attr tags.focus.floating_focused true . set_attr clients.focus.floating_geometry "${win_w}x${win_h}+${win_x}+${win_y}" . unlock

