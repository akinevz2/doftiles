[Unit]
Description=x11vnc on :0
After=xvfb.service
Requires=xvfb.service

[Service]
Type=simple
Environment=XDG_SESSION_TYPE=x11
UnsetEnvironment=WAYLAND_DISPLAY
# DISPLAY is inherited from the user manager environment, set by
# check-x-server (detect-server --persist-to-systemd); the fallback
# keeps the standalone Xvfb(:0) stack working when that unit is not
# enabled (headless/VNC profile).
ExecStart=/bin/sh -c 'exec /usr/bin/x11vnc -display "${DISPLAY:-localhost:0.0}" -nopw -forever -shared -listen localhost -rfbport 5900 -noshm'
Restart=on-failure
# x11vnc exits 2 when its X server is torn down underneath it (stopping
# xvfb, or the WM session going away) — that is a normal shutdown.
SuccessExitStatus=2

[Install]
WantedBy=default.target
