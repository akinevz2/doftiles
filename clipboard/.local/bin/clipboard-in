#!/usr/bin/env bash
# clipboard-in: FILE(S) -> windows clipboard, or clipboard -> stdout when bare.
#   clipboard-in a.txt b.txt   # copy file contents INTO the clipboard (via to-clipboard)
#   clipboard-in               # print the current clipboard to stdout
# CRs are stripped on the read-back path only. Never writes to files.
set -euo pipefail

# Resolve a Windows interop binary: PATH first, then the interop mount.
# powershell.exe is virtualized away at System32 from WSL; use its real path.
winexe() {
  if command -v "$1" >/dev/null 2>&1; then
    command -v "$1"
  elif [ "$1" = powershell.exe ]; then
    printf '/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe'
  else
    printf '/mnt/c/Windows/System32/%s' "$1"
  fi
}

if [ $# -gt 0 ]; then
  # COPY: concatenate the files and hand them to to-clipboard (utf-8 safe).
  cat -- "$@" | to-clipboard
else
  # Bare invocation: print the clipboard to stdout.
  "$(winexe powershell.exe)" -NoProfile -Command \
    '[Console]::OutputEncoding=[Text.Encoding]::UTF8; Get-Clipboard' | tr -d '\r'
fi
