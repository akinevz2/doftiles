#!/bin/sh
# hc_center — SHIM. The implementation moved into the polyframes
# project (~/development/personal/polyframes, compiled Bun/bunli
# binary managed there); this shim keeps dots-side callers
# (hc_zoom, hc_focus, hc_full_focus, the compton context menu)
# working while the single implementation lives there.
#
# Usage: hc_center [frame|root]
exec "$HOME/.local/bin/polyframes" center "$@"
