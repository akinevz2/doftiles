shell/.cache/
*.swp
*.un~

# the MANIFESTS: *.depends are the ONE file per manifest (stows, wm,
# system, services). The developer force-adds them when expanding the
# software (`git add -f <name>.depends`); user machines personalize
# the same file and hide the dirtiness with
# `git update-index --skip-worktree` (the make update ritual automates
# the pull dance; the pull-collision volition point is documented in
# AGENTS.md).
*.depends

# built artifacts LINKED into the stow packages by the per-package
# depends Makefiles (dots/<pkg>/.local/state/depends/<pkg>.Makefile) —
# the stow packages own them, the repo does not track them
# the deploy staging: the build output lands dots/<pkg>/.local/bin/
# (per-package depends Makefiles) — never tracked; the stow step deploys
# the exact artifact to ~/.local/bin
herbctl/.local/bin/
polyframes/.local/bin/
bat/.local/bin/
depends/.local/bin/
herbstutil/.local/bin/
on-deploy/.local/bin/*
!on-deploy/.local/bin/on-deploy

# defensively: the build sleds (the submodules' own residues cannot leak
# up here, but bun install can land at a package root if the cwd slips)
polyframes/node_modules/
herbctl/node_modules/
bat/node_modules/
depends/node_modules/
herbstutil/node_modules/
**/.on-deploy-release/
vim/.vim/bundle/
vim/.vim/.netrwhist
vim/.vim/spell/en.utf-8.add
vim/.vim/spell/en.utf-8.add.spl
vim/.vim/.netrwhist
vim/.vim/viminfo

opencode/.config/opencode/opencode.jsonc

# personal identity ships only on personal branches (kine) — never main
shell/.my-credentials
**/.my-credentials-env
**/*.env
# the on-deploy artifact home (2026-11 resplit: the binary lives with its
# own stow package; the depends meta-package stays REMNANTS ONLY)

# the get package: the got artifact + the deployed get.sh staging
get/.local/bin/
get/.local/share/got/
opencode/.config/opencode/service.json
